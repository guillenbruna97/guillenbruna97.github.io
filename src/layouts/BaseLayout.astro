---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { BOOKING_URL } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: string;
}
const { title, description, image, ogType } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/isotipo.svg" />
    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <!--
      GitHub Pages no soporta cabeceras HTTP personalizadas (public/_headers
      no se aplica en este hosting), así que la CSP solo puede imponerse aquí
      como meta tag. Esto cubre script-src/style-src/img-src pero NO puede
      imponer frame-ancestors ni X-Frame-Options (son solo de cabecera) —
      ver public/_headers para el detalle de esa limitación.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://analytics.google.com; frame-src https://www.youtube.com; base-uri 'self'; object-src 'none';"
    />
    <SEO title={title} description={description} image={image} ogType={ogType} />
    <!-- Google Analytics: se carga solo tras consentimiento, ver CookieConsent.astro -->
  </head>
  <body>
    <script is:inline>
      // La preferencia guardada manda si existe (el visitante ya toco el
      // interruptor alguna vez). Si no hay nada guardado todavia (primera
      // visita), se usa la preferencia del sistema operativo. Va como
      // primer script dentro de <body>, antes de que se pinte cualquier
      // contenido visible, para evitar el flash de tema incorrecto sin
      // tener que mover la clase a <html> (todo el CSS del sitio apunta
      // a "body.dark").
      const storedTheme = localStorage.getItem('theme');
      const colorSchemeQuery = window.matchMedia('(prefers-color-scheme: dark)');
      if (storedTheme === 'dark' || (!storedTheme && colorSchemeQuery.matches)) {
        document.body.classList.add('dark');
      }
      // Mientras no haya preferencia manual guardada, seguimos el modo del
      // sistema en tiempo real. En cuanto el visitante pulsa el toggle
      // (Nav.astro escribe en localStorage), esta comprobacion hace que el
      // listener deje de tener efecto sin necesidad de desregistrarlo.
      colorSchemeQuery.addEventListener('change', (e) => {
        if (localStorage.getItem('theme')) return;
        document.body.classList.toggle('dark', e.matches);
      });
    </script>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <LoadingScreen />
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <script>
      const revealTargets = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window && revealTargets.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            // Una sola vez: antes era toggle(isIntersecting) y el bloque se
            // volvía a ocultar al salir de pantalla, dejando huecos en blanco
            // al volver a subir y en capturas de página completa.
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.15 }
        );
        revealTargets.forEach((el) => observer.observe(el));
      }
    </script>
    <script define:vars={{ BOOKING_URL }}>
      // GA4 solo registraba la vista de página base — no había ningún
      // evento en los clics de "Reservar llamada" ni "Escríbeme", así que
      // era imposible saber qué página o mensaje convierte más. Delegado
      // en document en vez de atado a cada botón: cubre automáticamente
      // cualquier CTA nuevo que apunte a las mismas URLs, sin tener que
      // acordarse de instrumentarlo a mano cada vez.
      document.addEventListener('click', (e) => {
        const link = e.target.closest('a[href]');
        if (!link || typeof gtag !== 'function') return;
        const href = link.getAttribute('href') ?? '';
        let eventName = null;
        if (href.startsWith(BOOKING_URL)) eventName = 'reservar_llamada_click';
        else if (href.startsWith('mailto:')) eventName = 'escribeme_click';
        if (!eventName) return;
        gtag('event', eventName, {
          link_text: link.textContent.trim(),
          page_path: location.pathname,
          transport_type: 'beacon',
        });
      });
    </script>
  </body>
</html>
