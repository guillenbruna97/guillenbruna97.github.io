---
import BaseLayout from './BaseLayout.astro';
import Tag from '../components/Tag.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { Picture } from 'astro:assets';
import { getArticleImage } from '../utils/article-images';

interface RelatedArticulo {
  id: string;
  data: { title: string; excerpt: string };
}

interface Props {
  title: string;
  description: string;
  tag: string;
  heading: string;
  date: Date;
  readingTime: string;
  image?: string;
  imageAlt?: string;
  related?: RelatedArticulo[];
}
const { title, description, tag, heading, date, readingTime, image, imageAlt, related = [] } = Astro.props;
const optimizedImage = getArticleImage(image);
const formattedDate = date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const imageUrl = image ? `https://guillenbruna97.github.io${image}` : 'https://guillenbruna97.github.io/isotipo.svg';
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: heading,
  description,
  image: imageUrl,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  mainEntityOfPage: Astro.url.href,
  author: {
    '@type': 'Person',
    name: 'Guillén Bruna Tricas',
    url: 'https://guillenbruna97.github.io/sobre-mi/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Guillén Bruna Tricas',
    logo: {
      '@type': 'ImageObject',
      url: 'https://guillenbruna97.github.io/isotipo.svg',
    },
  },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://guillenbruna97.github.io/' },
    { '@type': 'ListItem', position: 2, name: 'Artículos', item: 'https://guillenbruna97.github.io/articulos/' },
    { '@type': 'ListItem', position: 3, name: heading, item: Astro.url.href },
  ],
};
---
<BaseLayout title={title} description={description} image={image} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <a href="/articulos/" class="back-link">← Volver a artículos</a>

  <div class="article-main">
    <div class="article-header-tags">
      <Tag label={tag} />
    </div>
    <h1>{heading}</h1>
    <p class="article-meta">{formattedDate} · {readingTime}</p>

    {image && (
      <div class="article-hero">
        {optimizedImage ? (
          <Picture
            src={optimizedImage}
            alt={imageAlt ?? heading}
            width={1376}
            height={768}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            quality={65}
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <img src={image} alt={imageAlt ?? heading} width="1376" height="768" fetchpriority="high" />
        )}
      </div>
    )}

    <div class="article-prose">
      <slot />
    </div>

    {related.length > 0 && (
      <nav class="related-articles" aria-label="Artículos relacionados">
        <p class="related-label">Sigue leyendo</p>
        <ul>
          {related.map((article) => (
            <li>
              <a href={`/articulos/${article.id}/`}>
                <span class="related-title">{article.data.title}</span>
                <span class="related-excerpt">{article.data.excerpt}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>

  <ContactBlock title="¿Trabajamos<br>juntos?" />
</BaseLayout>

<style is:global>
  .back-link {
    display: block;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 2rem 0;
    font-size: 0.78rem;
    font-weight: 400;
    color: rgba(0,0,0,0.4);
    text-decoration: none;
    transition: color var(--transition);
  }
  body.dark .back-link { color: rgba(232,232,232,0.4); }
  .back-link:hover { color: var(--blue); }
  body.dark .back-link:hover { color: var(--blue-light); }

  .article-main { padding: 2rem 2rem 3rem; max-width: 720px; margin: 0 auto; }

  .article-header-tags { margin-bottom: 1.2rem; }

  .article-main h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 0.8rem;
  }

  .article-meta {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--blue);
    margin-bottom: 2.5rem;
    transition: color var(--transition);
  }
  body.dark .article-meta { color: var(--blue-light); }

  .article-hero {
    margin-bottom: 2.5rem;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: rgba(0,0,0,0.03);
  }
  body.dark .article-hero { background: rgba(255,255,255,0.05); }
  .article-hero img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .article-prose {
    font-size: 0.95rem;
    font-weight: 300;
    color: rgba(0,0,0,0.7);
    line-height: 1.9;
    transition: color var(--transition);
  }
  body.dark .article-prose { color: rgba(232,232,232,0.7); }

  .article-prose p { margin-bottom: 1.5rem; }

  .article-prose h2 {
    font-size: 1.3rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--black);
    margin: 2.8rem 0 1.2rem;
    transition: color var(--transition);
  }
  body.dark .article-prose h2 { color: #e8e8e8; }

  .article-prose h2:first-child { margin-top: 0; }

  .article-prose strong { font-weight: 600; color: var(--black); transition: color var(--transition); }
  body.dark .article-prose strong { color: #e8e8e8; }

  .article-prose ul, .article-prose ol {
    margin: 0 0 1.5rem 1.2rem;
    padding: 0;
  }
  .article-prose li { margin-bottom: 0.6rem; }

  .article-prose a { color: var(--blue); transition: color var(--transition); }
  body.dark .article-prose a { color: var(--blue-light); }

  /* ARTÍCULOS RELACIONADOS */
  .related-articles { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid rgba(0,0,0,0.1); }
  body.dark .related-articles { border-top-color: rgba(255,255,255,0.12); }
  .related-label {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.35);
    margin-bottom: 1.2rem;
    transition: color var(--transition);
  }
  body.dark .related-label { color: rgba(232,232,232,0.4); }
  .related-articles ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .related-articles a {
    display: block;
    padding: 1rem 1.25rem;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 8px;
    text-decoration: none;
    transition: border-color var(--transition), background var(--transition);
  }
  body.dark .related-articles a { border-color: rgba(255,255,255,0.08); }
  .related-articles a:hover { border-color: var(--blue); background: var(--off-white); }
  body.dark .related-articles a:hover { border-color: var(--blue-light); background: var(--dark-surface); }
  .related-title { display: block; font-size: 0.95rem; font-weight: 500; color: var(--black); margin-bottom: 0.3rem; transition: color var(--transition); }
  body.dark .related-title { color: #e8e8e8; }
  .related-excerpt { display: block; font-size: 0.85rem; font-weight: 300; color: rgba(0,0,0,0.55); line-height: 1.6; transition: color var(--transition); }
  body.dark .related-excerpt { color: rgba(232,232,232,0.55); }

  @media (max-width: 640px) {
    .article-main { padding: 1.5rem 1.5rem 2rem; }
  }
</style>
