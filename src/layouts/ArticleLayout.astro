---
import BaseLayout from './BaseLayout.astro';
import ArticuloCard from '../components/ArticuloCard.astro';
import type { CollectionEntry } from 'astro:content';
import ContactBlock from '../components/ContactBlock.astro';
import { Picture } from 'astro:assets';
import { getArticleImage } from '../utils/article-images';
import { getService, SITE_NAME } from '../consts';
import FaqList, { type Faq } from '../components/FaqList.astro';


interface Props {
  title: string;
  description: string;
  tag: string;
  heading: string;
  date: Date;
  updated?: Date;
  readingTime: string;
  image?: string;
  imageAlt?: string;
  service?: string;
  related?: CollectionEntry<'articulos'>[];
  faqs?: Faq[];
}
const { title, description, tag, heading, date, updated, readingTime, image, imageAlt, service, related = [], faqs = [] } = Astro.props;
const serviceInfo = getService(service);
const optimizedImage = getArticleImage(image);
const dateFormat: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'long', year: 'numeric' };
const formattedDate = date.toLocaleDateString('es-ES', dateFormat);
const formattedUpdated = updated && updated > date ? updated.toLocaleDateString('es-ES', dateFormat) : null;
const imageUrl = image ? `https://gbtconsultoria.com${image}` : 'https://gbtconsultoria.com/isotipo.svg';
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: heading,
  description,
  image: imageUrl,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  mainEntityOfPage: Astro.url.href,
  author: {
    '@type': 'Person',
    name: 'Guillén Bruna Tricas',
    url: 'https://gbtconsultoria.com/quienes-somos/#guillen',
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    logo: {
      '@type': 'ImageObject',
      url: 'https://gbtconsultoria.com/isotipo.svg',
    },
  },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://gbtconsultoria.com/' },
    { '@type': 'ListItem', position: 2, name: 'Artículos', item: 'https://gbtconsultoria.com/articulos/' },
    { '@type': 'ListItem', position: 3, name: heading, item: Astro.url.href },
  ],
};
---
<BaseLayout title={title} description={description} image={image} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <div class="article-main">
    <div class="article-migas" role="navigation" aria-label="Migas de pan">
      <a href="/recursos/">Recursos</a><span aria-hidden="true">/</span><a href="/articulos/">Artículos</a><span aria-hidden="true">/</span><span>{tag}</span>
    </div>
    <h1>{heading}</h1>
    <p class="article-meta">
      <time datetime={date.toISOString().slice(0, 10)}>{formattedDate}</time>
      {formattedUpdated && updated && <>, actualizado el <time datetime={updated.toISOString().slice(0, 10)}>{formattedUpdated}</time></>}
      {', '}{readingTime}
    </p>

    {image && (
      <div class="article-hero">
        {optimizedImage ? (
          <Picture
            src={optimizedImage}
            alt={imageAlt ?? heading}
            width={1376}
            height={768}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            quality={65}
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <img src={image} alt={imageAlt ?? heading} width="1376" height="768" fetchpriority="high" />
        )}
      </div>
    )}

    <div class="article-prose">
      <slot />
    </div>

    {faqs.length > 0 && (
      <section class="article-faq" aria-labelledby="preguntas-frecuentes">
        <h2 id="preguntas-frecuentes">Preguntas frecuentes</h2>
        <FaqList faqs={faqs} />
      </section>
    )}

    {serviceInfo && (
      <p class="service-note">
        Servicio relacionado <a href={`/servicios/${serviceInfo.slug}/`}>{serviceInfo.name}</a>
      </p>
    )}

    <aside class="article-autor">
      <span class="article-autor-foto" aria-hidden="true"></span>
      <p><strong>Guillén Bruna Tricas</strong>, consultor de estrategia de marketing y marca, orquesta la red de especialistas de GBT Consultoría desde Zaragoza. <a href="/quienes-somos/#guillen">Más sobre Guillén</a></p>
    </aside>
  </div>

  {related.length > 0 && (
    <section class="article-relacionados" aria-labelledby="relacionados">
      <h2 id="relacionados">Artículos relacionados</h2>
      <div class="article-relacionados-grid">
        {related.map((a) => <ArticuloCard entry={a} nivel="h3" />)}
      </div>
    </section>
  )}

  <ContactBlock title="¿Hablamos<br>de tu caso?" />
</BaseLayout>

<style is:global>
  .article-migas { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.82rem; color: rgba(0,0,0,0.5); margin-bottom: 1.6rem; }
  body.dark .article-migas { color: rgba(232,232,232,0.5); }
  .article-migas a { color: inherit; text-decoration: none; }
  .article-migas a:hover { color: var(--blue); }
  .article-autor { display: flex; align-items: center; gap: 1.1rem; margin: 3rem 0 1rem; padding: 1.4rem 1.6rem; background: var(--off-white); border-radius: 16px; }
  body.dark .article-autor { background: #121419; }
  /* Recorte a la cara de la foto de cuerpo entero (hasta tener retrato profesional). */
  .article-autor-foto { width: 64px; height: 64px; border-radius: 50%; flex: none; background: #e9e9e9 url('/guillen-chaqueta.jpg') no-repeat; background-size: 340%; background-position: 50% 4%; }
  .article-autor p { margin: 0; font-size: 0.9rem; font-weight: 300; line-height: 1.6; }
  .article-autor strong { font-weight: 500; }
  .article-autor a { color: var(--blue); font-weight: 500; }
  body.dark .article-autor a { color: var(--blue-light); }
  .article-relacionados { max-width: 1240px; margin: 0 auto; padding: 0 4vw 4.5rem; }
  .article-relacionados h2 { font-size: clamp(1.6rem, 2.8vw, 2.2rem); margin: 0 0 2rem; padding-top: 2.6rem; border-top: 1px solid rgba(0,0,0,0.1); }
  body.dark .article-relacionados h2 { border-top-color: rgba(255,255,255,0.1); }
  .article-relacionados-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem 2rem; }
  @media (max-width: 980px) { .article-relacionados-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .article-relacionados-grid { grid-template-columns: 1fr; } }


  .article-main { padding: 2rem 2rem 3rem; max-width: 720px; margin: 0 auto; }


  .article-main h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 0.8rem;
  }

  .article-meta {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--blue);
    margin-bottom: 2.5rem;
    transition: color var(--transition);
  }
  body.dark .article-meta { color: var(--blue-light); }

  .article-hero {
    margin-bottom: 2.5rem;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: rgba(0,0,0,0.03);
  }
  body.dark .article-hero { background: rgba(255,255,255,0.05); }
  .article-hero img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .article-prose {
    font-size: 0.95rem;
    font-weight: 300;
    color: rgba(0,0,0,0.7);
    line-height: 1.9;
    transition: color var(--transition);
  }
  body.dark .article-prose { color: rgba(232,232,232,0.7); }

  .article-prose p { margin-bottom: 1.5rem; }

  .article-prose h2 {
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--black);
    margin: 2.8rem 0 1.2rem;
    transition: color var(--transition);
  }
  body.dark .article-prose h2 { color: #e8e8e8; }

  .article-prose h2:first-child { margin-top: 0; }

  .article-faq { margin: 3rem 0 0; }
  .article-faq h2 {
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--black);
    margin: 0 0 1.2rem;
    transition: color var(--transition);
  }
  body.dark .article-faq h2 { color: #e8e8e8; }

  .article-prose strong { font-weight: 600; color: var(--black); transition: color var(--transition); }
  body.dark .article-prose strong { color: #e8e8e8; }

  .article-prose ul, .article-prose ol {
    margin: 0 0 1.5rem 1.2rem;
    padding: 0;
  }
  .article-prose li { margin-bottom: 0.6rem; }

  .article-prose a { color: var(--blue); transition: color var(--transition); }
  body.dark .article-prose a { color: var(--blue-light); }

  .service-note { margin: 2.5rem 0 0; font-size: 0.9rem; font-weight: 300; color: rgba(0,0,0,0.6); }
  body.dark .service-note { border-color: rgba(255,255,255,0.08); color: rgba(232,232,232,0.55); }
  .service-note a { color: var(--blue); font-weight: 500; text-decoration: none; }
  body.dark .service-note a { color: var(--blue-light); }
  .service-note a:hover { text-decoration: underline; }


  @media (max-width: 640px) {
    .article-main { padding: 1.5rem 1.5rem 2rem; }
  }
</style>
