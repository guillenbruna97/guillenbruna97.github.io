---
import BaseLayout from './BaseLayout.astro';
import '../styles/service.css';
import Divider from '../components/Divider.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { Picture } from 'astro:assets';
import { getServiceImage } from '../utils/service-images';
import { casosForService } from '../data/casos';
import { getPrecio } from '../data/precios';
import { SITE_NAME } from '../consts';
import FaqList, { type Faq } from '../components/FaqList.astro';

interface Step {
  title: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  heading: string;
  subtitle: string;
  image?: string;
  imageAlt?: string;
  paraQuien: string;
  queResuelve: string;
  recibe: string[];
  pasos: Step[];
  cierre: string;
  faqs?: Faq[];
}

const { title, description, heading, subtitle, image, imageAlt, paraQuien, queResuelve, recibe, pasos, cierre, faqs } = Astro.props;
const optimizedImage = getServiceImage(image);
// Casos que prueban este servicio (campo `services` en data/casos.ts). El slug
// sale de la URL /servicios/<slug>/. Sin casos, el bloque no se pinta.
const serviceSlug = Astro.url.pathname.split('/').filter(Boolean)[1] ?? '';
const relatedCasos = casosForService(serviceSlug);
// Solo el formato (duración, dedicación, garantía): desde 2026-10-22 los
// precios no se publican, van en la propuesta.
const formato = getPrecio(serviceSlug);

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: heading,
  description,
  serviceType: heading,
  provider: {
    '@type': 'ProfessionalService',
    name: SITE_NAME,
    url: 'https://gbtconsultoria.com/',
  },
  areaServed: [
    { '@type': 'City', name: 'Zaragoza' },
    { '@type': 'AdministrativeArea', name: 'Aragón' },
    { '@type': 'Country', name: 'España' },
  ],
  audience: {
    '@type': 'Audience',
    audienceType: 'CEO, COO, CFO, CEO de holding',
  },
  url: Astro.url.href,
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://gbtconsultoria.com/' },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: 'https://gbtconsultoria.com/servicios/' },
    { '@type': 'ListItem', position: 3, name: 'Estrategia y marca', item: 'https://gbtconsultoria.com/servicios/estrategia-y-marca/' },
    { '@type': 'ListItem', position: 4, name: heading, item: Astro.url.href },
  ],
};
---
<BaseLayout title={title} description={description} image={image} ogType="website">
  <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <a href="/servicios/estrategia-y-marca/" class="back-link">← Estrategia y marca</a>

  <div class="case-main">
    <div class="case-tags">
      <span class="tag">Estrategia y marca</span>
    </div>
    <h1>{heading}</h1>
    <p class="case-meta">{subtitle}</p>

    {image && (
      <div class="service-hero">
        {optimizedImage ? (
          <Picture
            src={optimizedImage}
            alt={imageAlt ?? heading}
            width={1376}
            height={768}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            quality={65}
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <img src={image} alt={imageAlt ?? heading} width="1376" height="768" fetchpriority="high" />
        )}
      </div>
    )}

    <div class="case-blocks">
      <div>
        <h2 class="block-label">Para quién es</h2>
        <p class="block-text">{paraQuien}</p>
      </div>
      <div>
        <h2 class="block-label">Qué resuelve</h2>
        <p class="block-text">{queResuelve}</p>
      </div>
    </div>

    <div class="case-block-full" data-reveal>
      <h2 class="block-label">Qué recibes</h2>
      <ul class="deliverable-list">
        {recibe.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="case-block-full" data-reveal>
      <h2 class="block-label">Cómo trabajamos</h2>
      <ol class="process-steps">
        {pasos.map((paso, i) => (
          <li>
            <span class="process-number">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="process-title">{paso.title}</h3>
              <p class="process-text">{paso.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    {formato && (
      <div class="case-block-full" data-reveal>
        <h2 class="block-label">Formato</h2>
        <dl class="precio-grid">
          <div><dt>Duración</dt><dd>{formato.duracion}</dd></div>
          <div><dt>Tu tiempo</dt><dd>{formato.dedicacion}</dd></div>
          {formato.garantia && <div><dt>Garantía</dt><dd>{formato.garantia}</dd></div>}
          <div><dt>Fuera de este servicio</dt><dd>{formato.noIncluye.join('. ')}</dd></div>
        </dl>
        <p class="precio-link">Precio cerrado en la propuesta, que recibes en 5 días laborables tras una llamada de 15 minutos. Sin permanencia y con acuerdo de confidencialidad. <a href="/quienes-somos/#como-trabajamos">Cómo trabajamos</a></p>
      </div>
    )}

    {relatedCasos.length > 0 && (
      <div class="case-block-full" data-reveal>
        <h2 class="block-label">Caso relacionado</h2>
        <ul class="service-casos">
          {relatedCasos.map((caso) => (
            <li>
              <a href={`/trabajo/${caso.slug}/`}>
                <span class="service-caso-title">{caso.cardHeadline}</span>
                <span class="service-caso-company">{caso.company} · {caso.role}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <p class="service-cierre">{cierre}</p>

    {faqs && faqs.length > 0 && (
      <div class="case-block-full faq-block" data-reveal>
        <h2 class="block-label">Preguntas frecuentes</h2>
        <FaqList faqs={faqs} />
      </div>
    )}
  </div>

  <Divider />

  <ContactBlock title="¿Hablamos<br>de tu caso?" />
</BaseLayout>
