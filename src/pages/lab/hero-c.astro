---
// Prueba de hero, variante C: contraste oscuro con las tres fugas. Página de laboratorio, sin indexar.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import { BOOKING_URL } from '../../consts';
import foto from '../../assets/lab/foto-perfil.png';

const fugas = [
  { n: '01', t: 'En el mensaje', d: 'El mercado no entiende qué te hace diferente.', href: '/servicios/posicionamiento/' },
  { n: '02', t: 'En el proceso comercial', d: 'Las oportunidades se pierden y nadie sabe en qué etapa.', href: '/servicios/pipeline/' },
  { n: '03', t: 'En cómo comunica quien dirige', d: 'La voz pública de la dirección no refuerza la marca.', href: '/servicios/mentoria-comunicacion/' },
];
---
<BaseLayout title="Prueba de hero C | Guillén Bruna Tricas" description="Página de prueba del hero." noindex>
  <section class="hc">
    <div class="hc-glow" aria-hidden="true"></div>
    <div class="hc-inner">
      <div class="hc-who">
        <Picture src={foto} alt="Guillén Bruna Tricas" width={96} height={96} formats={['avif', 'webp']} quality={70} loading="eager" />
        <p><b>Guillén Bruna Tricas</b><span>Consultor de estrategia de marketing y marca · Zaragoza</span></p>
      </div>
      <h1>Tu empresa ejecuta marketing, pero <span class="accent">el mercado no la recuerda.</span></h1>
      <p class="hc-desc">Encuentro dónde se pierde ese esfuerzo y lo corrijo contigo. ¿Por dónde empezamos?</p>
      <div class="hc-fugas">
        {fugas.map((f) => (
          <a href={f.href} class="hc-fuga">
            <span class="hc-n">{f.n}</span>
            <b>{f.t}</b>
            <span class="hc-d">{f.d}</span>
            <span class="hc-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <div class="hc-actions">
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="hc-btn">Reservar llamada de 15 minutos</a>
        <a href="/trabajo/" class="hc-link">Ver casos reales</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hc { position: relative; overflow: hidden; background: #0a0a0a; color: #fff; }
  .hc-glow { position: absolute; right: -15%; top: -40%; width: 70vw; height: 70vw; max-width: 900px; max-height: 900px; border-radius: 50%; background: radial-gradient(circle, rgba(0,74,173,0.55), rgba(0,74,173,0) 65%); pointer-events: none; }
  .hc-inner { position: relative; max-width: 1280px; margin: 0 auto; padding: 4.5rem 4vw 5rem; }
  .hc-who { display: flex; align-items: center; gap: 0.9rem; margin-bottom: 2rem; }
  .hc-who :global(img) { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; border: 2px solid var(--blue-light); }
  .hc-who p { display: flex; flex-direction: column; font-size: 0.82rem; color: rgba(255,255,255,0.6); line-height: 1.4; }
  .hc-who b { color: #fff; font-size: 0.95rem; font-weight: 600; }
  h1 { font-family: 'Newsreader', Georgia, serif; font-size: clamp(2.6rem, 6vw, 5.2rem); font-weight: 400; line-height: 1.02; letter-spacing: -0.03em; max-width: 1000px; }
  h1 .accent { color: var(--blue-light); font-style: italic; }
  .hc-desc { margin-top: 1.6rem; font-size: 1.15rem; font-weight: 300; color: rgba(255,255,255,0.72); }
  .hc-fugas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 2.4rem; }
  .hc-fuga { position: relative; display: flex; flex-direction: column; gap: 0.4rem; padding: 1.4rem 1.4rem 1.6rem; border-radius: 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); color: #fff; text-decoration: none; transition: background 0.25s, border-color 0.25s, transform 0.25s; }
  .hc-fuga:hover { background: rgba(0,74,173,0.35); border-color: var(--blue-light); transform: translateY(-3px); }
  .hc-n { font-family: 'Newsreader', Georgia, serif; font-style: italic; font-size: 1.6rem; color: var(--blue-light); }
  .hc-fuga b { font-size: 1.05rem; font-weight: 600; }
  .hc-d { font-size: 0.88rem; font-weight: 300; color: rgba(255,255,255,0.65); line-height: 1.5; }
  .hc-arrow { position: absolute; right: 1.2rem; top: 1.3rem; color: var(--blue-light); }
  .hc-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.6rem; margin-top: 2.4rem; }
  .hc-btn { padding: 0.95rem 1.5rem; border-radius: 6px; background: var(--blue-light); color: #0a0a0a; font-weight: 600; font-size: 0.92rem; text-decoration: none; }
  .hc-link { color: #fff; font-size: 0.92rem; text-decoration: underline; text-underline-offset: 4px; }
  @media (prefers-reduced-motion: no-preference) {
    .hc-inner > * { opacity: 0; animation: hc-in 0.8s cubic-bezier(.16,1,.3,1) forwards; }
    .hc-inner > *:nth-child(2) { animation-delay: 0.08s; } .hc-inner > *:nth-child(3) { animation-delay: 0.16s; }
    .hc-inner > *:nth-child(4) { animation-delay: 0.26s; } .hc-inner > *:nth-child(5) { animation-delay: 0.34s; }
  }
  @keyframes hc-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (max-width: 900px) {
    .hc-inner { padding: 3rem 6vw 3.5rem; }
    .hc-fugas { grid-template-columns: 1fr; }
  }
</style>
