---
// Prueba de hero, variante E: ilustración integrada en el fondo. Página de laboratorio, sin indexar.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import { BOOKING_URL } from '../../consts';
import img from '../../assets/articulos/consultor-de-marketing-en-zaragoza.jpg';

const logos = ['/logo-zebra.svg', '/logo-grupo-rey.svg', '/logo-integra.svg', '/logo-slm.svg', '/logo-tuco.svg'];
---
<BaseLayout title="Prueba de hero E | Guillén Bruna Tricas" description="Página de prueba del hero." noindex>
  <section class="hx hx--ilus">
    <div class="hx-bg" aria-hidden="true">
      <Picture src={img} alt="" width={1376} height={768} formats={['avif', 'webp']} quality={72} loading="eager" fetchpriority="high" />
    </div>
    <div class="hx-inner">
      <p class="hx-kicker"><i></i>Consultor de estrategia de marketing y marca · Zaragoza</p>
      <h1>Tu empresa ejecuta marketing, pero <span class="accent">el mercado no la recuerda.</span></h1>
      <p class="hx-desc">Ayudo a empresas y a quienes las lideran a encontrar dónde se pierde ese esfuerzo, en el mensaje, en el proceso comercial o en cómo comunica quien la dirige.</p>
      <div class="hx-actions">
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="hx-btn hx-btn--primary">Reservar llamada de 15 minutos</a>
        <a href="/trabajo/" class="hx-btn">Ver casos reales</a>
      </div>
      <p class="hx-proof">Precio cerrado <span>·</span> Sin permanencia <span>·</span> Trabajo directamente contigo</p>
      <div class="hx-trust">
        <p>Han confiado en mí</p>
        <div class="hx-logos">{logos.map((src) => <img src={src} alt="" height="40" loading="lazy" />)}</div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hx { position: relative; overflow: hidden; min-height: min(86vh, 780px); display: flex; align-items: center; background: #ffffff; }
  .hx-bg { position: absolute; top: 0; bottom: 0; right: 0; width: 60%; pointer-events: none; }
  .hx-bg :global(picture), .hx-bg :global(img) { width: 100%; height: 100%; display: block; object-fit: cover; object-position: 78% center; }
  /* La imagen se funde con el fondo hacia el texto (izquierda) y por abajo */
  .hx-bg { -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.35) 22%, #000 55%), linear-gradient(to top, transparent 0%, #000 18%); mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.35) 22%, #000 55%), linear-gradient(to top, transparent 0%, #000 18%); -webkit-mask-composite: source-in; mask-composite: intersect; }
  .hx--ilus { background: #f3f1ea; } .hx--ilus .hx-bg { -webkit-mask-image: linear-gradient(to right, transparent 0%, transparent 20%, rgba(0,0,0,0.45) 42%, #000 66%), linear-gradient(to top, transparent 0%, #000 18%); mask-image: linear-gradient(to right, transparent 0%, transparent 20%, rgba(0,0,0,0.45) 42%, #000 66%), linear-gradient(to top, transparent 0%, #000 18%); } .hx--ilus .hx-btn { background: rgba(243,241,234,0.85); } .hx--ilus .hx-btn--primary { background: var(--blue); }
  .hx-inner { position: relative; z-index: 1; width: 100%; max-width: 1280px; margin: 0 auto; padding: 4.5rem 4vw 4rem; }
  .hx-inner > * { max-width: 640px; }
  .hx-kicker { display: flex; align-items: center; gap: 0.6rem; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--blue); margin-bottom: 1.6rem; }
  .hx-kicker i { width: 9px; height: 9px; background: var(--blue-light); display: inline-block; }
  h1 { font-family: 'Newsreader', Georgia, serif; font-size: clamp(2.4rem, 4.8vw, 4.2rem); font-weight: 400; line-height: 1.04; letter-spacing: -0.03em; margin-bottom: 1.6rem; }
  h1 .accent { color: var(--blue); font-style: italic; }
  .hx-desc { font-size: 1.08rem; font-weight: 300; line-height: 1.75; color: rgba(0,0,0,0.68); max-width: 540px; }
  .hx-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2.2rem; }
  .hx-btn { display: inline-flex; align-items: center; padding: 0.95rem 1.5rem; border-radius: 6px; font-size: 0.92rem; font-weight: 500; border: 1px solid rgba(0,0,0,0.18); background: rgba(255,255,255,0.85); color: var(--black); text-decoration: none; transition: transform 0.2s; }
  .hx-btn:hover { transform: translateY(-2px); }
  .hx-btn--primary { background: var(--blue); border-color: var(--blue); color: #fff; }
  .hx-proof { margin-top: 1.2rem; font-size: 0.85rem; color: rgba(0,0,0,0.55); }
  .hx-proof span { color: var(--blue-light); margin: 0 0.35rem; }
  .hx-trust { margin-top: 2.6rem; padding-top: 1.4rem; border-top: 1px solid rgba(0,0,0,0.08); }
  .hx-trust p { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(0,0,0,0.45); margin-bottom: 0.9rem; }
  .hx-logos { display: flex; flex-wrap: wrap; align-items: center; gap: 1.4rem 2.4rem; }
  .hx-logos img { height: 40px; width: auto; filter: grayscale(1) contrast(1.4); opacity: 0.8; }
  @media (prefers-reduced-motion: no-preference) {
    .hx-inner > * { opacity: 0; animation: hx-in 0.8s cubic-bezier(.16,1,.3,1) forwards; }
    .hx-inner > *:nth-child(2) { animation-delay: 0.08s; } .hx-inner > *:nth-child(3) { animation-delay: 0.16s; }
    .hx-inner > *:nth-child(4) { animation-delay: 0.24s; } .hx-inner > *:nth-child(5) { animation-delay: 0.3s; } .hx-inner > *:nth-child(6) { animation-delay: 0.36s; }
    .hx-bg { animation: hx-bg 1.4s ease forwards; opacity: 0; }
  }
  @keyframes hx-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes hx-bg { to { opacity: 1; } }
  :global(body.dark) .hx { background: #0a0a0a; }
  :global(body.dark) h1 .accent { color: var(--blue-light); }
  :global(body.dark) .hx-desc, :global(body.dark) .hx-proof { color: rgba(232,232,232,0.7); }
  :global(body.dark) .hx-btn { color: #e8e8e8; border-color: rgba(255,255,255,0.25); background: rgba(10,10,10,0.6); }
  :global(body.dark) .hx-btn--primary { background: var(--blue); }
  :global(body.dark) .hx-logos img { filter: grayscale(1) invert(1); }
  /* Móvil: la imagen arriba, fundida hacia abajo; el texto empieza sobre la parte ya difuminada */
  @media (max-width: 900px) {
    .hx { display: block; min-height: 0; }
    .hx-bg, .hx--foto .hx-bg, .hx--ilus .hx-bg { position: relative; width: 100%; height: 300px; -webkit-mask-image: linear-gradient(to bottom, #000 45%, transparent 100%); mask-image: linear-gradient(to bottom, #000 40%, transparent 96%); }
    .hx-inner { margin-top: -16px; padding: 0 6vw 3.5rem; }
  }
</style>
