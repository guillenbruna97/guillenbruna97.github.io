---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import TrustMarquee from '../components/TrustMarquee.astro';

const trustLogos = [
  { src: '/logo-zebra.svg', alt: 'Zebra Ventures' },
  { src: '/logo-rey.svg', alt: 'Muebles Rey' },
  { src: '/logo-tuco.svg', alt: 'Muebles Tuco' },
  { src: '/logo-grupo-rey.svg', alt: 'Grupo Rey' },
  { src: '/logo-slm.svg', alt: 'SLM' },
  { src: '/logo-integra.svg', alt: 'Integra Consultoría Gerencial' },
];
---
<BaseLayout
  title="Estrategia de marketing y marca | Guillén Bruna Tricas"
  description="Estrategia de marketing y marca. Asesoro a empresas y a directivos que quieren comunicar con autoridad y posicionarse como referentes en su sector."
>
  <div class="hero-wrapper">
    <svg class="parallax-blob parallax-blob-1" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
      <circle cx="100" cy="100" r="90" />
    </svg>
    <svg class="parallax-blob parallax-blob-2" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
      <circle cx="100" cy="100" r="90" />
    </svg>

    <div class="hero">
      <div class="hero-content">
        <h1 class="hero-headline">Estrategia de marketing y marca <span class="accent">que construye reconocimiento.</span></h1>
        <div class="hero-sub">
          <div class="hero-sub-text">
            <p class="hero-name">Guillén Bruna Tricas</p>
            <p class="hero-desc">Ayudo a empresas y a quienes las lideran a definir un mensaje claro, construir una marca coherente y convertir esa visibilidad en resultados de negocio.</p>
          </div>
          <div class="hero-actions">
            <a href="/trabajo/" class="btn-primary">Ver casos reales</a>
            <a href="mailto:guillenbrunatricas@gmail.com" class="btn-secondary">Hablemos</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="capacidades-band">
    <div class="capacidades-inner">
      <p class="section-label">Áreas de trabajo</p>
      <h2 class="section-title">Tres formas de aportar valor desde el primer día</h2>
      <div class="capacidades-list">
        <a href="/trabajo/" class="capacidad-row" data-reveal>
          <span class="capacidad-ghost">01</span>
          <div class="capacidad-body">
            <h3>Estrategia de marca</h3>
            <p>Diagnóstico, posicionamiento y mensaje. Para empresas que necesitan que su marca diga lo que de verdad hacen, y para directivos que quieren construir su propia reputación.</p>
          </div>
          <span class="capacidad-link">Ver casos →</span>
        </a>
        <a href="/trabajo/" class="capacidad-row" data-reveal>
          <span class="capacidad-ghost">02</span>
          <div class="capacidad-body">
            <h3>Go-to-market y lanzamiento</h3>
            <p>Estrategia para llevar un producto o una línea de negocio al mercado, desde el ICP hasta el funnel de conversión que conecta marketing con ventas.</p>
          </div>
          <span class="capacidad-link">Ver casos →</span>
        </a>
        <a href="/trabajo/" class="capacidad-row" data-reveal>
          <span class="capacidad-ghost">03</span>
          <div class="capacidad-body">
            <h3>Generación de demanda y contenido</h3>
            <p>Campañas, contenido y canal digital diseñados para generar tracción real, no solo visibilidad. eCommerce, paid media y posicionamiento de contenido.</p>
          </div>
          <span class="capacidad-link">Ver casos →</span>
        </a>
        <a href="/trabajo/" class="capacidad-row" data-reveal>
          <span class="capacidad-ghost">04</span>
          <div class="capacidad-body">
            <h3>Consultoría estratégica</h3>
            <p>Acompañamiento directo a dirección en procesos de transformación, definición de modelo comercial y toma de decisiones de marketing con criterio de negocio.</p>
          </div>
          <span class="capacidad-link">Ver casos →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="stats-band">
    <div class="stats-band-inner">
      <div class="stat-item stat-item--hero" data-reveal data-count="6">
        <p class="stat-value"><span class="stat-number">0</span>+</p>
        <p class="stat-label">Marcas gestionadas en paralelo</p>
      </div>
      <div class="stats-side">
        <div class="stat-item" data-reveal data-count="4">
          <p class="stat-value"><span class="stat-number">0</span></p>
          <p class="stat-label">Casos reales trabajados de principio a fin</p>
        </div>
        <div class="stat-item" data-reveal data-count="5">
          <p class="stat-value"><span class="stat-number">0</span>+</p>
          <p class="stat-label">Años liderando marketing y marca</p>
        </div>
      </div>
    </div>
  </section>

  <TrustMarquee logos={trustLogos} />

  <ContactBlock
    title="¿Tu marca necesita una estrategia clara?"
    subtitle="Hablemos de cómo puedo ayudarte a conseguirlo."
  />
</BaseLayout>

<style is:global>
  /* HERO */
  .hero-wrapper { position: relative; overflow: hidden; contain: style; }
  .hero { padding: 3.5rem 3rem 3.5rem 0; max-width: 1400px; margin: 0 4vw; }
  .hero-content { position: relative; z-index: 1; }

  /* Soft parallax background shapes */
  .parallax-blob {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    filter: blur(40px);
  }
  .parallax-blob circle { fill: var(--blue-light); opacity: 0.18; transition: fill var(--transition); }
  body.dark .parallax-blob circle { fill: var(--blue); opacity: 0.24; }
  .parallax-blob-1 { width: 260px; height: 260px; top: -60px; right: 8%; }
  .parallax-blob-2 { width: 180px; height: 180px; bottom: -40px; left: 4%; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .parallax-blob-1 { animation: parallax-drift-1 linear; animation-timeline: view(); animation-range: entry 0% cover 100%; }
      .parallax-blob-2 { animation: parallax-drift-2 linear; animation-timeline: view(); animation-range: entry 0% cover 100%; }
    }
  }
  @keyframes parallax-drift-1 { from { transform: translateY(-20px); } to { transform: translateY(40px); } }
  @keyframes parallax-drift-2 { from { transform: translateY(10px); } to { transform: translateY(-30px); } }

  /* Hero entrance animation */
  @media (prefers-reduced-motion: no-preference) {
    .hero-content > * { opacity: 0; animation: hero-fade-up 0.7s ease forwards; }
    .hero-content > *:nth-child(1) { animation-delay: 0s; }
    .hero-content > *:nth-child(2) { animation-delay: 0.1s; }
  }
  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-headline {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 1.75rem;
    max-width: 780px;
  }
  .hero-headline .accent { color: var(--blue); transition: color var(--transition); }
  body.dark .hero-headline .accent { color: var(--blue-light); }

  .hero-sub {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .hero-sub-text { max-width: 480px; }

  .hero-name {
    font-size: 0.95rem;
    font-weight: 500;
    color: rgba(0,0,0,0.55);
    margin-bottom: 1.2rem;
    transition: color var(--transition);
  }
  body.dark .hero-name { color: rgba(232,232,232,0.55); }

  .hero-desc {
    font-size: 1.05rem;
    font-weight: 300;
    color: rgba(0,0,0,0.6);
    line-height: 1.8;
    transition: color var(--transition);
  }
  body.dark .hero-desc { color: rgba(232,232,232,0.6); }

  .hero-actions { display: flex; align-items: center; padding-top: 0.75rem; }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--blue);
    color: var(--white);
    font-family: 'Poppins', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.85rem 1.8rem;
    border-radius: 8px;
    cursor: pointer;
    border: none;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background var(--transition), transform 0.15s ease;
  }
  .btn-primary:hover { background: #003a8a; transform: translateY(-1px); }
  body.dark .btn-primary { background: var(--blue-light); color: var(--dark-bg); }
  body.dark .btn-primary:hover { background: #7ab0f0; }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    color: var(--black);
    font-family: 'Poppins', sans-serif;
    font-size: 0.82rem;
    font-weight: 400;
    padding: 0.85rem 1.8rem;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid rgba(0,0,0,0.2);
    letter-spacing: 0.04em;
    margin-left: 1rem;
    text-decoration: none;
    transition: border-color var(--transition), color var(--transition), transform 0.15s ease;
  }
  .btn-secondary:hover { border-color: var(--blue); color: var(--blue); transform: translateY(-1px); }
  body.dark .btn-secondary { color: #e8e8e8; border-color: rgba(232,232,232,0.25); }
  body.dark .btn-secondary:hover { border-color: var(--blue-light); color: var(--blue-light); }

  .section-label {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    margin-bottom: 1rem;
  }
  .section-title {
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 3.5rem;
    max-width: 640px;
    color: var(--white);
  }

  /* CAPACIDADES — full-bleed statement band, zigzag rows */
  .capacidades-band {
    background: var(--blue);
    padding: 6rem 2vw;
    transition: background var(--transition);
  }
  body.dark .capacidades-band { background: var(--dark-surface); }
  .capacidades-inner { max-width: 1160px; margin: 0 auto; }

  .capacidades-list { display: flex; flex-direction: column; }
  .capacidad-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2.5rem;
    padding: 2.5rem 0;
    border-top: 1px solid rgba(255,255,255,0.18);
    text-decoration: none;
    color: var(--white);
    transition: padding-left var(--transition), opacity 0.6s ease, transform 0.6s ease;
  }
  .capacidades-list a:last-child { border-bottom: 1px solid rgba(255,255,255,0.18); }
  .capacidad-row:hover { padding-left: 1.2rem; }

  .capacidad-ghost {
    order: 1;
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1;
    color: rgba(255,255,255,0.18);
    transition: color var(--transition);
  }
  .capacidad-row:hover .capacidad-ghost { color: rgba(255,255,255,0.35); }

  .capacidad-body { order: 2; }
  .capacidad-body h3 {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .capacidad-body p {
    font-size: 0.9rem;
    font-weight: 300;
    color: rgba(255,255,255,0.75);
    line-height: 1.75;
    max-width: 520px;
  }

  .capacidad-link {
    order: 3;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--white);
    white-space: nowrap;
  }

  .capacidad-row:nth-child(even) .capacidad-ghost { order: 3; text-align: right; }
  .capacidad-row:nth-child(even) .capacidad-link { order: 1; }

  .capacidad-row:nth-child(2) { transition-delay: 0.08s; }
  .capacidad-row:nth-child(3) { transition-delay: 0.16s; }
  .capacidad-row:nth-child(4) { transition-delay: 0.24s; }

  /* STATS — full-bleed dark band, one dominant number + two side stats */
  .stats-band { background: var(--black); padding: 6rem 2vw; transition: background var(--transition); }
  body.dark .stats-band { background: #050505; }
  .stats-band-inner {
    max-width: 1160px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .stat-item--hero .stat-value {
    font-size: clamp(5rem, 13vw, 10rem);
    line-height: 0.88;
  }
  .stat-item--hero .stat-label {
    font-size: 1.05rem;
    max-width: 340px;
    margin-top: 1.2rem;
  }

  .stats-side {
    display: flex;
    flex-direction: column;
    gap: 2.8rem;
    border-left: 1px solid rgba(255,255,255,0.15);
    padding-left: 3rem;
  }
  .stats-side .stat-item:nth-child(2) { transition-delay: 0.1s; }

  .stat-value {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--blue-light);
  }
  .stat-label {
    font-size: 0.85rem;
    font-weight: 300;
    color: rgba(255,255,255,0.6);
    margin-top: 0.4rem;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .hero { margin: 0 2vw; padding: 5rem 1.5rem 4rem; }
    .hero-sub { grid-template-columns: 1fr; gap: 2rem; }
    .hero-actions { padding-top: 0; }
    .capacidad-row { grid-template-columns: auto 1fr; }
    .capacidad-link { display: none; }
    .capacidad-row:nth-child(even) .capacidad-ghost { order: 1; text-align: left; }
    .capacidad-row:nth-child(even) .capacidad-link { order: 3; }
    .stats-band-inner { grid-template-columns: 1fr; gap: 3rem; }
    .stats-side { border-left: none; padding-left: 0; border-top: 1px solid rgba(255,255,255,0.15); padding-top: 2.5rem; }
  }
</style>

<script>
  const statEls = document.querySelectorAll<HTMLElement>('.stat-item');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const animateCount = (el: HTMLElement) => {
    const target = Number(el.dataset.count ?? '0');
    const numberEl = el.querySelector<HTMLElement>('.stat-number');
    if (!numberEl) return;
    if (prefersReducedMotion) {
      numberEl.textContent = String(target);
      return;
    }
    const duration = 900;
    const start = performance.now();
    const step = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      numberEl.textContent = String(Math.round(progress * target));
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  if ('IntersectionObserver' in window && statEls.length) {
    const statObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            statObserver.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 }
    );
    statEls.forEach((el) => statObserver.observe(el));
  }
</script>
