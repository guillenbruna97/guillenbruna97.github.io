---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import DiagnosticoBanner from '../components/DiagnosticoBanner.astro';
import FotoPendiente from '../components/FotoPendiente.astro';
import AreasLista from '../components/AreasLista.astro';
import { BOOKING_URL } from '../consts';

const trustLogos = [
  { src: '/logos/zebra.png', width: 290, alt: 'Logo de Zebra AI Transformation Company' },
  { src: '/logos/rey.png', width: 212, alt: 'Logo de Muebles Rey' },
  { src: '/logos/tuco.png', width: 276, alt: 'Logo de Muebles Tuco' },
  { src: '/logos/grupo-rey.png', width: 152, alt: 'Logo de Grupo Rey Corporación' },
  { src: '/logos/slm.png', width: 249, alt: 'Logo de SLM' },
  { src: '/logos/integra.png', width: 227, alt: 'Logo de Integra Consultoría Gerencial' },
];
---
<BaseLayout
  title="GBT Consultoría, marketing y marca en Zaragoza | Guillén Bruna"
  description="Red de especialistas senior en marketing en Zaragoza, dirigida por Guillén Bruna: estrategia, marca, web, SEO y GEO, publicidad, redes y eventos. Un solo interlocutor."
>
  <section class="hx">
    <div class="hx-inner">
      <h1 class="hx-title">Todo tu marketing, de principio a fin, con un solo <span class="accent">responsable</span>.</h1>
      <div class="hx-sub">
        <p class="hx-desc">Somos una red de especialistas senior en estrategia, marca, web, posicionamiento, publicidad, redes y eventos, orquestada por Guillén Bruna. Tú hablas con una persona. Nosotros montamos el equipo que necesita tu proyecto.</p>
        <div class="hx-actions">
          <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">Reservar llamada de 15 minutos</a>
          <a href="/trabajo/" class="btn-secondary">Ver casos reales</a>
        </div>
      </div>
      <FotoPendiente class="hx-foto" ratio="16 / 7" texto="Sesión de trabajo con un cliente: Guillén y parte del equipo alrededor de una mesa, con luz natural y sin posar. Horizontal, de al menos 2400 px de ancho." />
    </div>
    <div class="hh-trust">
      <p class="hh-trust-label">Marcas en la trayectoria de Guillén Bruna</p>
      <div class="hh-logos">
        <div class="hh-logos-track">
          {[0, 1, 2, 3].map((i) => (
            <div class="hh-logos-set" aria-hidden={i === 0 ? undefined : 'true'}>
              {trustLogos.map((logo) => <img src={logo.src} alt={i === 0 ? logo.alt : ''} width={logo.width} height="160" loading="lazy" decoding="async" />)}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="hx-manifiesto">
    <h2>Mientras una agencia vende lo que tiene en plantilla, nosotros montamos el equipo que necesita tu negocio</h2>
    <div class="hx-cols">
      <p>No sumamos servicios sueltos. Llevamos tu marketing completo con una misma lógica: la estrategia decide y lo ejecutan los especialistas de nuestra red que mejor encajan con tu proyecto.</p>
      <p>Una sola persona coordina a todo el equipo y revisa cada entrega antes de que te llegue. Un interlocutor, una factura y ningún junior aprendiendo con tu presupuesto. <a href="/quienes-somos/#la-red">Cómo elegimos a la red</a></p>
    </div>
  </section>

  <AreasLista titulo="Lo que hacemos por tu marketing" />

  <DiagnosticoBanner />

  <section class="stats-band">
    <div class="stats-band-inner">
      <div class="stat-item stat-item--hero" data-reveal data-count="6">
        <p class="stat-value"><span class="stat-number">6</span>+</p>
        <p class="stat-label"><span class="stat-label-lead">Marcas gestionadas</span> en paralelo</p>
      </div>
      <div class="stats-side">
        <div class="stat-item" data-reveal data-count="4">
          <p class="stat-value"><span class="stat-number">4</span>+</p>
          <p class="stat-label"><span class="stat-label-lead">Casos reales</span> trabajados de principio a fin</p>
        </div>
        <div class="stat-item" data-reveal data-count="5">
          <p class="stat-value"><span class="stat-number">5</span>+</p>
          <p class="stat-label"><span class="stat-label-lead">Años liderando</span> marketing y marca</p>
        </div>
      </div>
    </div>
  </section>


  <ContactBlock
    title="¿Hablamos de tu marketing?"
    subtitle="Cuéntanos tu caso y en 5 días laborables tienes una propuesta cerrada."
  />
</BaseLayout>

<style is:global>
  /* HERO (estructura inspirada en elogia.net: titular grande, subtítulo con botones y foto a todo el ancho) */
  .hx { padding: 4.5rem 0 1rem; }
  .hx-inner { max-width: 1240px; margin: 0 auto; padding: 0 4vw; }
  .hx-title { font-family: 'Poppins', sans-serif; font-size: clamp(2.6rem, 6.6vw, 6rem); font-weight: 500; line-height: 1.0; letter-spacing: -0.045em; margin: 0 0 2.2rem; max-width: 1100px; }
  .hx-title .accent { font-family: 'Newsreader', Georgia, serif; font-style: italic; font-weight: 400; letter-spacing: -0.02em; color: var(--blue); }
  body.dark .hx-title { color: #e8e8e8; }
  body.dark .hx-title .accent { color: var(--blue-light); }
  .hx-sub { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.6rem 3rem; margin-bottom: 2.6rem; }
  .hx-desc { font-size: 1.05rem; font-weight: 300; line-height: 1.75; color: rgba(0,0,0,0.65); max-width: 560px; margin: 0; }
  body.dark .hx-desc { color: rgba(232,232,232,0.68); }
  .hx-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .hx-actions .btn-secondary { margin-left: 0; }
  .hx-foto { width: 100%; }
  body.dark .hh-trust-label { color: rgba(232,232,232,0.45); border-top-color: rgba(255,255,255,0.1); }
  body.dark .hh-logos img { filter: invert(1); opacity: 0.7; }
  /* Banda de logos a todo el ancho, al pie del hero: cuatro copias en fila que se desplazan hacia la derecha
     un cuarto y vuelven a empezar sin salto. Cada copia abre con su hueco, así el primer logo nunca sale cortado. */
  .hh-trust { position: relative; z-index: 1; padding-bottom: 3rem; }
  .hh-trust-label { margin: 0 4vw 1.2rem; padding-top: 1.4rem; border-top: 1px solid rgba(0,0,0,0.08); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(0,0,0,0.45); }
  .hh-logos { overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 5%, #000 95%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 5%, #000 95%, transparent 100%); }
  .hh-logos-track { display: flex; width: max-content; animation: hh-logos-ltr 30s linear infinite; }
  .hh-logos:hover .hh-logos-track { animation-play-state: paused; }
  .hh-logos-set { display: flex; align-items: center; gap: 5rem; padding-left: 5rem; flex-shrink: 0; }
  .hh-logos img { height: 44px; width: auto; opacity: 0.82; }
  @keyframes hh-logos-ltr { from { transform: translateX(-25%); } to { transform: translateX(0); } }
  @media (prefers-reduced-motion: reduce) {
    .hh-logos { margin: 0 4vw; -webkit-mask-image: none; mask-image: none; }
    .hh-logos-track { animation: none; width: auto; }
    .hh-logos-set { flex-wrap: wrap; gap: 1.2rem 1.6rem; padding-left: 0; flex-shrink: 1; }
    .hh-logos-set[aria-hidden] { display: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hx-inner > * { opacity: 0; animation: hx-in 0.8s cubic-bezier(.16,1,.3,1) forwards; }
    .hx-inner > *:nth-child(2) { animation-delay: 0.08s; } .hx-inner > *:nth-child(3) { animation-delay: 0.16s; }
  }
  @keyframes hx-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (max-width: 640px) {
    .hx { padding-top: 3rem; }
    .hx-title { letter-spacing: -0.035em; }
    .hh-trust-label { margin: 0 6vw 1rem; }
    .hh-logos-set { gap: 3.5rem; padding-left: 3.5rem; }
  }

  /* MANIFIESTO: frase + dos columnas */
  .hx-manifiesto { max-width: 1240px; margin: 0 auto; padding: 5rem 4vw 1rem; }
  .hx-manifiesto h2 { font-family: 'Poppins', sans-serif; font-size: clamp(1.8rem, 3.6vw, 2.9rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1.12; max-width: 980px; margin: 0 0 2.6rem; }
  .hx-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 4rem; }
  .hx-cols p { font-size: 0.98rem; font-weight: 300; line-height: 1.75; color: rgba(0,0,0,0.65); margin: 0; }
  body.dark .hx-cols p { color: rgba(232,232,232,0.65); }
  .hx-cols a { color: var(--blue); font-weight: 500; }
  body.dark .hx-cols a { color: var(--blue-light); }
  @media (max-width: 760px) { .hx-cols { grid-template-columns: 1fr; } }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--blue);
    color: var(--white);
    font-family: 'Poppins', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.85rem 1.8rem;
    border-radius: 8px;
    cursor: pointer;
    border: none;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background var(--transition), transform 0.15s ease;
  }
  .btn-primary:hover { background: #003a8a; transform: translateY(-1px); }
  body.dark .btn-primary { background: var(--blue-light); color: var(--dark-bg); }
  body.dark .btn-primary:hover { background: #7ab0f0; }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    color: var(--black);
    font-family: 'Poppins', sans-serif;
    font-size: 0.82rem;
    font-weight: 400;
    padding: 0.85rem 1.8rem;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid rgba(0,0,0,0.2);
    letter-spacing: 0.04em;
    margin-left: 1rem;
    text-decoration: none;
    transition: border-color var(--transition), color var(--transition), transform 0.15s ease;
  }
  .btn-secondary:hover { border-color: var(--blue); color: var(--blue); transform: translateY(-1px); }
  body.dark .btn-secondary { color: #e8e8e8; border-color: rgba(232,232,232,0.25); }
  body.dark .btn-secondary:hover { border-color: var(--blue-light); color: var(--blue-light); }


  /* STATS — full-bleed dark band, one dominant number + two side stats */
  .stats-band { background: var(--black); padding: 7rem 4vw; transition: background var(--transition); }
  body.dark .stats-band { background: #050505; }
  .stats-band-inner {
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .stat-item--hero {
    gap: 1rem;
  }
  .stat-item--hero .stat-value {
    font-size: clamp(5rem, 13vw, 10rem);
    line-height: 0.88;
  }
  .stat-item--hero .stat-label {
    font-size: clamp(2.2rem, 3.4vw, 3.4rem);
    line-height: 1.45;
    max-width: 820px;
    margin-top: 0;
  }

  .stats-side {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    border-left: 1px solid rgba(255,255,255,0.15);
    padding-left: 4rem;
  }
  .stats-side .stat-item:nth-child(2) { transition-delay: 0.1s; }

  .stat-value {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--blue-light);
  }
  .stat-label {
    font-size: clamp(1.2rem, 1.8vw, 1.7rem);
    font-weight: 500;
    color: rgba(255,255,255,0.75);
    margin-top: 0;
    line-height: 1.25;
    max-width: 380px;
  }
  .stat-label-lead {
    display: block;
    font-size: 1.2em;
    font-weight: 700;
    color: rgba(255,255,255,0.95);
  }

  @media (max-width: 900px) {
    .stats-band-inner { grid-template-columns: 1fr; gap: 3rem; }
    .stats-side { border-left: none; padding-left: 0; border-top: 1px solid rgba(255,255,255,0.15); padding-top: 2.5rem; }
    .stat-item { flex-direction: column; align-items: flex-start; gap: 0; }
    .stat-item--hero .stat-label { margin-top: 1.2rem; }
    .stat-label { margin-top: 0.4rem; }
  }
</style>

<script>
  const statEls = document.querySelectorAll<HTMLElement>('.stat-item');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // El HTML ya trae el número real (contenido por defecto, visible sin JS
  // y tal cual lo indexan los buscadores). La animación es solo una mejora
  // progresiva: si corre, parte de 0 hacia ese mismo número real.
  const animateCount = (el: HTMLElement) => {
    const target = Number(el.dataset.count ?? '0');
    const numberEl = el.querySelector<HTMLElement>('.stat-number');
    if (!numberEl || prefersReducedMotion) return;
    numberEl.textContent = '0';
    const duration = 900;
    const start = performance.now();
    const step = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      numberEl.textContent = String(Math.round(progress * target));
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  if ('IntersectionObserver' in window && statEls.length) {
    const statObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            statObserver.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 }
    );
    statEls.forEach((el) => statObserver.observe(el));
  }
</script>
