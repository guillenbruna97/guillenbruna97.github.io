---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import TrustMarquee from '../components/TrustMarquee.astro';
import { BOOKING_URL, SERVICES } from '../consts';

const trustLogos = [
  { src: '/logo-zebra.svg', alt: 'Zebra Ventures, empresa donde Guillén Bruna Tricas trabaja como Head of Brand & Marketing' },
  { src: '/logo-rey.png', alt: 'Muebles Rey, cliente de campañas de marketing omnicanal con Guillén Bruna Tricas' },
  { src: '/logo-tuco.svg', alt: 'Muebles Tuco, marca de retail cliente de Guillén Bruna Tricas' },
  { src: '/logo-grupo-rey.svg', alt: 'Grupo Rey Corporación, cliente de estrategia de marca de Guillén Bruna Tricas' },
  { src: '/logo-slm.svg', alt: 'SLM, cliente de un proyecto de comunicación con Guillén Bruna Tricas' },
  { src: '/logo-integra.svg', alt: 'Integra Consultoría Gerencial, cliente de consultoría estratégica con Guillén Bruna Tricas' },
];
---
<BaseLayout
  title="Estrategia de marketing y marca | Guillén Bruna Tricas"
  description="Estrategia de marketing y marca. Asesoro a empresas y a directivos que quieren comunicar con autoridad y posicionarse como referentes en su sector."
>
  <div class="hero-wrapper">
    <span class="ghost-mark hero-ghost-mark" aria-hidden="true">*</span>

    <div class="hero">
      <div class="hero-content">
        <h1 class="hero-headline">Estrategia de marketing y marca <span class="accent">que construye reconocimiento.</span></h1>
        <div class="hero-sub">
          <div class="hero-sub-text">
            <p class="hero-name">Guillén Bruna Tricas</p>
            <p class="hero-desc">Ayudo a empresas y a quienes las lideran a definir un mensaje claro, construir una marca coherente y convertir esa visibilidad en resultados de negocio.</p>
          </div>
          <div class="hero-actions">
            <a href="/trabajo/" class="btn-primary">Ver casos reales</a>
            <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-secondary">Reservar llamada</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="capacidades-band">
    <div class="capacidades-inner">
      <p class="section-label">Servicios</p>
      <h2 class="section-title">Formas de aportar valor desde el primer día</h2>
      <div class="capacidades-list">
        {SERVICES.map((service, i) => (
          <a href={`/servicios/${service.slug}/`} class="capacidad-row" data-reveal>
            <span class="capacidad-ghost">{String(i + 1).padStart(2, '0')}</span>
            <div class="capacidad-body">
              <h3>{service.name}</h3>
              <p>{service.tagline}</p>
            </div>
            <span class="capacidad-link">Ver servicio →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="stats-band">
    <div class="stats-band-inner">
      <div class="stat-item stat-item--hero" data-reveal data-count="6">
        <p class="stat-value"><span class="stat-number">6</span>+</p>
        <p class="stat-label"><span class="stat-label-lead">Marcas gestionadas</span> en paralelo</p>
      </div>
      <div class="stats-side">
        <div class="stat-item" data-reveal data-count="4">
          <p class="stat-value"><span class="stat-number">4</span>+</p>
          <p class="stat-label"><span class="stat-label-lead">Casos reales</span> trabajados de principio a fin</p>
        </div>
        <div class="stat-item" data-reveal data-count="5">
          <p class="stat-value"><span class="stat-number">5</span>+</p>
          <p class="stat-label"><span class="stat-label-lead">Años liderando</span> marketing y marca</p>
        </div>
      </div>
    </div>
  </section>

  <TrustMarquee logos={trustLogos} />

  <ContactBlock
    title="¿Tu marca necesita una estrategia clara?"
    subtitle="Hablemos de cómo puedo ayudarte a conseguirlo."
  />
</BaseLayout>

<style is:global>
  /* HERO */
  .hero-wrapper { position: relative; overflow: hidden; contain: style; }
  .hero { padding: 3.5rem 3rem 3.5rem 0; max-width: 1400px; margin: 0 4vw; }
  .hero-content { position: relative; z-index: 1; }

  /* Signature ghost mark: a typographic asterisk, not a number — no implied sequence */
  .hero-ghost-mark {
    font-size: clamp(9rem, 22vw, 17rem);
    top: -1.5rem;
    right: 4%;
  }

  /* Hero entrance animation */
  @media (prefers-reduced-motion: no-preference) {
    .hero-content > * { opacity: 0; animation: hero-fade-up 0.7s ease forwards; }
    .hero-content > *:nth-child(1) { animation-delay: 0s; }
    .hero-content > *:nth-child(2) { animation-delay: 0.1s; }
  }
  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-headline {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 1.75rem;
    max-width: 780px;
  }
  .hero-headline .accent { color: var(--blue); font-style: italic; transition: color var(--transition); }
  body.dark .hero-headline .accent { color: var(--blue-light); }

  .hero-sub {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .hero-sub-text { max-width: 480px; }

  .hero-name {
    font-size: 0.95rem;
    font-weight: 500;
    color: rgba(0,0,0,0.55);
    margin-bottom: 1.2rem;
    transition: color var(--transition);
  }
  body.dark .hero-name { color: rgba(232,232,232,0.55); }

  .hero-desc {
    font-size: 1.05rem;
    font-weight: 300;
    color: rgba(0,0,0,0.6);
    line-height: 1.8;
    transition: color var(--transition);
  }
  body.dark .hero-desc { color: rgba(232,232,232,0.6); }

  .hero-actions { display: flex; align-items: center; padding-top: 0.75rem; }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--blue);
    color: var(--white);
    font-family: 'Poppins', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.85rem 1.8rem;
    border-radius: 8px;
    cursor: pointer;
    border: none;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background var(--transition), transform 0.15s ease;
  }
  .btn-primary:hover { background: #003a8a; transform: translateY(-1px); }
  body.dark .btn-primary { background: var(--blue-light); color: var(--dark-bg); }
  body.dark .btn-primary:hover { background: #7ab0f0; }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    color: var(--black);
    font-family: 'Poppins', sans-serif;
    font-size: 0.82rem;
    font-weight: 400;
    padding: 0.85rem 1.8rem;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid rgba(0,0,0,0.2);
    letter-spacing: 0.04em;
    margin-left: 1rem;
    text-decoration: none;
    transition: border-color var(--transition), color var(--transition), transform 0.15s ease;
  }
  .btn-secondary:hover { border-color: var(--blue); color: var(--blue); transform: translateY(-1px); }
  body.dark .btn-secondary { color: #e8e8e8; border-color: rgba(232,232,232,0.25); }
  body.dark .btn-secondary:hover { border-color: var(--blue-light); color: var(--blue-light); }

  .section-label {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    margin-bottom: 1rem;
  }
  .section-title {
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    margin-bottom: 3.5rem;
    max-width: 640px;
    color: var(--white);
  }

  /* CAPACIDADES — full-bleed statement band, zigzag rows */
  .capacidades-band {
    background: var(--blue);
    padding: 6rem 2vw;
    transition: background var(--transition);
  }
  body.dark .capacidades-band { background: var(--dark-surface); }
  .capacidades-inner { max-width: 1160px; margin: 0 auto; }

  .capacidades-list { display: flex; flex-direction: column; }
  .capacidad-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2.5rem;
    padding: 2.5rem 0;
    border-top: 1px solid rgba(255,255,255,0.18);
    text-decoration: none;
    color: var(--white);
    transition: padding-left var(--transition), opacity 0.6s ease, transform 0.6s ease;
  }
  .capacidades-list a:last-child { border-bottom: 1px solid rgba(255,255,255,0.18); }
  .capacidad-row:hover { padding-left: 1.2rem; }

  .capacidad-ghost {
    order: 1;
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1;
    color: rgba(255,255,255,0.18);
    transition: color var(--transition);
  }
  .capacidad-row:hover .capacidad-ghost { color: rgba(255,255,255,0.35); }

  .capacidad-body { order: 2; }
  .capacidad-body h3 {
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .capacidad-body p {
    font-size: 0.9rem;
    font-weight: 300;
    color: rgba(255,255,255,0.75);
    line-height: 1.75;
    max-width: 520px;
  }

  .capacidad-link {
    order: 3;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--white);
    white-space: nowrap;
  }

  .capacidad-row:nth-child(even) .capacidad-ghost { order: 3; text-align: right; }
  .capacidad-row:nth-child(even) .capacidad-link { order: 1; }

  .capacidad-row:nth-child(2) { transition-delay: 0.08s; }
  .capacidad-row:nth-child(3) { transition-delay: 0.16s; }
  .capacidad-row:nth-child(4) { transition-delay: 0.24s; }

  /* STATS — full-bleed dark band, one dominant number + two side stats */
  .stats-band { background: var(--black); padding: 7rem 4vw; transition: background var(--transition); }
  body.dark .stats-band { background: #050505; }
  .stats-band-inner {
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .stat-item--hero {
    gap: 1rem;
  }
  .stat-item--hero .stat-value {
    font-size: clamp(5rem, 13vw, 10rem);
    line-height: 0.88;
  }
  .stat-item--hero .stat-label {
    font-size: clamp(2.2rem, 3.4vw, 3.4rem);
    line-height: 1.45;
    max-width: 820px;
    margin-top: 0;
  }

  .stats-side {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    border-left: 1px solid rgba(255,255,255,0.15);
    padding-left: 4rem;
  }
  .stats-side .stat-item:nth-child(2) { transition-delay: 0.1s; }

  .stat-value {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--blue-light);
  }
  .stat-label {
    font-size: clamp(1.2rem, 1.8vw, 1.7rem);
    font-weight: 500;
    color: rgba(255,255,255,0.75);
    margin-top: 0;
    line-height: 1.25;
    max-width: 380px;
  }
  .stat-label-lead {
    display: block;
    font-size: 1.2em;
    font-weight: 700;
    color: rgba(255,255,255,0.95);
  }

  @media (max-width: 900px) {
    .hero { margin: 0 2vw; padding: 5rem 1.5rem 4rem; }
    .hero-sub { grid-template-columns: 1fr; gap: 2rem; }
    .hero-actions { padding-top: 0; }
    .hero-ghost-mark { font-size: clamp(6rem, 26vw, 9rem); top: -0.5rem; right: -2%; }
    .capacidad-row { grid-template-columns: auto 1fr; }
    .capacidad-link { display: none; }
    .capacidad-row:nth-child(even) .capacidad-ghost { order: 1; text-align: left; }
    .capacidad-row:nth-child(even) .capacidad-link { order: 3; }
    .stats-band-inner { grid-template-columns: 1fr; gap: 3rem; }
    .stats-side { border-left: none; padding-left: 0; border-top: 1px solid rgba(255,255,255,0.15); padding-top: 2.5rem; }
    .stat-item { flex-direction: column; align-items: flex-start; gap: 0; }
    .stat-item--hero .stat-label { margin-top: 1.2rem; }
    .stat-label { margin-top: 0.4rem; }
  }
</style>

<script>
  const statEls = document.querySelectorAll<HTMLElement>('.stat-item');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // El HTML ya trae el número real (contenido por defecto, visible sin JS
  // y tal cual lo indexan los buscadores). La animación es solo una mejora
  // progresiva: si corre, parte de 0 hacia ese mismo número real.
  const animateCount = (el: HTMLElement) => {
    const target = Number(el.dataset.count ?? '0');
    const numberEl = el.querySelector<HTMLElement>('.stat-number');
    if (!numberEl || prefersReducedMotion) return;
    numberEl.textContent = '0';
    const duration = 900;
    const start = performance.now();
    const step = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      numberEl.textContent = String(Math.round(progress * target));
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  if ('IntersectionObserver' in window && statEls.length) {
    const statObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            statObserver.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 }
    );
    statEls.forEach((el) => statObserver.observe(el));
  }
</script>
