---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { Picture } from 'astro:assets';
import heroIlustracion from '../assets/articulos/consultor-de-marketing-en-zaragoza.jpg';
import heroIlustracionOscura from '../assets/hero/ilustracion-oscura.jpg';
import { BOOKING_URL, SERVICES } from '../consts';

const trustLogos = [
  { src: '/logos/zebra.png', width: 290, alt: 'Logo de Zebra AI Transformation Company' },
  { src: '/logos/rey.png', width: 212, alt: 'Logo de Muebles Rey' },
  { src: '/logos/tuco.png', width: 276, alt: 'Logo de Muebles Tuco' },
  { src: '/logos/grupo-rey.png', width: 152, alt: 'Logo de Grupo Rey Corporación' },
  { src: '/logos/slm.png', width: 249, alt: 'Logo de SLM' },
  { src: '/logos/integra.png', width: 227, alt: 'Logo de Integra Consultoría Gerencial' },
];
---
<BaseLayout
  title="Consultor de estrategia de marketing y marca | Guillén Bruna Tricas"
  description="Consultor de estrategia de marketing y marca. Tu empresa ejecuta marketing, pero el mercado no la recuerda: encuentro dónde se pierde ese esfuerzo y lo corrijo."
>
  <section class="hh">
    <div class="hh-art" aria-hidden="true">
      <Picture src={heroIlustracion} alt="" width={1376} height={768} formats={['avif', 'webp']} quality={72} loading="eager" fetchpriority="high" class="hh-claro" />
      <Picture src={heroIlustracionOscura} alt="" width={1376} height={768} formats={['avif', 'webp']} quality={72} loading="lazy" class="hh-oscuro" />
    </div>
    <div class="hh-inner">
      <h1 class="hh-headline">Tu empresa ejecuta marketing, pero <span class="accent">el mercado no la recuerda.</span></h1>
      <p class="hh-desc">Ayudo a empresas y a quienes las lideran a encontrar dónde se pierde ese esfuerzo, en el mensaje, en el proceso comercial o en cómo comunica quien la dirige.</p>
      <div class="hh-actions">
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">Reservar llamada de 15 minutos</a>
        <a href="/trabajo/" class="btn-secondary">Ver casos reales</a>
      </div>
    </div>
    <div class="hh-trust">
      <p class="hh-trust-label">Han confiado en mí</p>
      <div class="hh-logos">
        <div class="hh-logos-track">
          {[0, 1, 2, 3].map((i) => (
            <div class="hh-logos-set" aria-hidden={i === 0 ? undefined : 'true'}>
              {trustLogos.map((logo) => <img src={logo.src} alt={i === 0 ? logo.alt : ''} width={logo.width} height="160" loading="eager" decoding="async" />)}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="capacidades-band">
    <div class="capacidades-inner">
      <p class="section-label">Servicios</p>
      <h2 class="section-title">Formas de aportar valor desde el primer día</h2>
      <div class="capacidades-list">
        {SERVICES.map((service, i) => (
          <a href={`/servicios/${service.slug}/`} class="capacidad-row" data-reveal>
            <span class="capacidad-ghost">{String(i + 1).padStart(2, '0')}</span>
            <div class="capacidad-body">
              <h3>{service.name}</h3>
              <p>{service.tagline}</p>
            </div>
            <span class="capacidad-link">Ver servicio →</span>
          </a>
        ))}
      </div>
      <p class="capacidades-zona">Trabajo desde Zaragoza, en persona en los momentos clave y en remoto el resto. <a href="/articulos/consultor-de-marketing-en-zaragoza/">Cómo elegir consultor de marketing en Zaragoza</a></p>
    </div>
  </section>

  <section class="stats-band">
    <div class="stats-band-inner">
      <div class="stat-item stat-item--hero" data-reveal data-count="6">
        <p class="stat-value"><span class="stat-number">6</span>+</p>
        <p class="stat-label"><span class="stat-label-lead">Marcas gestionadas</span> en paralelo</p>
      </div>
      <div class="stats-side">
        <div class="stat-item" data-reveal data-count="4">
          <p class="stat-value"><span class="stat-number">4</span>+</p>
          <p class="stat-label"><span class="stat-label-lead">Casos reales</span> trabajados de principio a fin</p>
        </div>
        <div class="stat-item" data-reveal data-count="5">
          <p class="stat-value"><span class="stat-number">5</span>+</p>
          <p class="stat-label"><span class="stat-label-lead">Años liderando</span> marketing y marca</p>
        </div>
      </div>
    </div>
  </section>


  <ContactBlock
    title="¿Tu marca necesita una estrategia clara?"
    subtitle="Hablemos de cómo puedo ayudarte a conseguirlo."
  />
</BaseLayout>

<style is:global>
  /* HERO */
  /* Hero: la ilustración entera a la derecha sobre el color del papel; solo se suavizan sus bordes.
     En modo oscuro se usa la versión oscura de la ilustración sobre el negro de la web. */
  .hh { position: relative; overflow: hidden; background: #efebe3; min-height: min(84vh, 760px); display: flex; flex-direction: column; justify-content: center; }
  .hh-art { position: absolute; top: 50%; right: 3vw; width: 50%; aspect-ratio: 1376 / 768; transform: translateY(-50%); pointer-events: none;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 18%, #000 84%, transparent 100%), linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 18%, #000 84%, transparent 100%), linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
    -webkit-mask-composite: source-in; mask-composite: intersect; }
  .hh-art picture { position: absolute; inset: 0; display: block; }
  .hh-art img { width: 100%; height: 100%; display: block; object-fit: contain; }
  .hh-art .hh-oscuro { display: none; }
  body.dark .hh { background: #151510; } /* el color del papel negro de la ilustración oscura */
  body.dark .hh-art .hh-claro { display: none; }
  body.dark .hh-art .hh-oscuro { display: block; }
  body.dark .hh-headline { color: #e8e8e8; }
  body.dark .hh-desc { color: rgba(232,232,232,0.7); }
  body.dark .hh-trust-label { color: rgba(232,232,232,0.45); border-top-color: rgba(255,255,255,0.1); }
  body.dark .hh-logos img { filter: invert(1); opacity: 0.7; }
  .hh-inner { position: relative; z-index: 1; max-width: 1400px; margin: 0 4vw; padding: 4.5rem 0 2.6rem; }
  .hh-inner > * { max-width: 560px; }
  .hh-headline { font-size: clamp(2.4rem, 4.8vw, 4.2rem); font-weight: 400; line-height: 1.04; letter-spacing: -0.03em; margin-bottom: 1.6rem; color: #0a0a0a; }
  .hh-headline .accent { color: var(--blue); font-style: italic; }
  .hh-desc { font-size: 1.08rem; font-weight: 300; line-height: 1.75; color: rgba(0,0,0,0.68); }
  .hh-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2.2rem; }
  .hh .btn-secondary { background: rgba(239,235,227,0.9); color: #0a0a0a; border-color: rgba(0,0,0,0.18); }
  .hh .btn-secondary:hover { border-color: var(--blue); color: var(--blue); }
  body.dark .hh .btn-secondary { background: transparent; color: #e8e8e8; border-color: rgba(232,232,232,0.25); }
  body.dark .hh .btn-secondary:hover { border-color: var(--blue-light); color: var(--blue-light); }
  body.dark .hh-headline .accent { color: var(--blue-light); }
  /* Banda de logos a todo el ancho, al pie del hero: cuatro copias en fila que se desplazan hacia la derecha
     un cuarto y vuelven a empezar sin salto. Cada copia abre con su hueco, así el primer logo nunca sale cortado. */
  .hh-trust { position: relative; z-index: 1; padding-bottom: 3rem; }
  .hh-trust-label { margin: 0 4vw 1.2rem; padding-top: 1.4rem; border-top: 1px solid rgba(0,0,0,0.08); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(0,0,0,0.45); }
  .hh-logos { overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 5%, #000 95%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 5%, #000 95%, transparent 100%); }
  .hh-logos-track { display: flex; width: max-content; animation: hh-logos-ltr 30s linear infinite; }
  .hh-logos:hover .hh-logos-track { animation-play-state: paused; }
  .hh-logos-set { display: flex; align-items: center; gap: 5rem; padding-left: 5rem; flex-shrink: 0; }
  .hh-logos img { height: 44px; width: auto; opacity: 0.82; }
  @keyframes hh-logos-ltr { from { transform: translateX(-25%); } to { transform: translateX(0); } }
  @media (prefers-reduced-motion: reduce) {
    .hh-logos { margin: 0 4vw; -webkit-mask-image: none; mask-image: none; }
    .hh-logos-track { animation: none; width: auto; }
    .hh .hh-logos-set { flex-wrap: wrap; gap: 1.2rem 1.6rem; padding-left: 0; flex-shrink: 1; }
    .hh-logos-set[aria-hidden] { display: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hh-inner > * { opacity: 0; animation: hh-in 0.8s cubic-bezier(.16,1,.3,1) forwards; }
    .hh-inner > *:nth-child(2) { animation-delay: 0.08s; } .hh-inner > *:nth-child(3) { animation-delay: 0.16s; }
    .hh-trust { opacity: 0; animation: hh-fade 1s ease 0.3s forwards; }
    .hh-art { opacity: 0; animation: hh-fade 1.2s ease 0.1s forwards; }
  }
  @keyframes hh-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes hh-fade { to { opacity: 1; } }
  /* Hasta 1180 px la ilustración va arriba: a anchos intermedios se montaría sobre los botones */
  @media (max-width: 1180px) {
    .hh { display: block; min-height: 0; }
    /* Misma proporción que el dibujo y bordes fundidos por los cuatro lados, para que no se vea el rectángulo del papel */
    .hh-art { position: relative; top: auto; right: auto; transform: none; width: min(100%, 620px); margin: 1rem auto 0; aspect-ratio: 1376 / 768; height: auto;
      -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 16%, #000 84%, transparent 100%), linear-gradient(to bottom, transparent 0%, #000 14%, #000 72%, transparent 100%);
      mask-image: linear-gradient(to right, transparent 0%, #000 16%, #000 84%, transparent 100%), linear-gradient(to bottom, transparent 0%, #000 14%, #000 72%, transparent 100%);
      -webkit-mask-composite: source-in; mask-composite: intersect; }
    .hh-inner { margin: -16px 0 0; padding: 0 6vw 2.4rem; }
    .hh-trust-label { margin: 0 6vw 1rem; }
    .hh-logos-set { gap: 3.5rem; padding-left: 3.5rem; }
    .hh-inner > * { max-width: none; }
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--blue);
    color: var(--white);
    font-family: 'Poppins', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.85rem 1.8rem;
    border-radius: 8px;
    cursor: pointer;
    border: none;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background var(--transition), transform 0.15s ease;
  }
  .btn-primary:hover { background: #003a8a; transform: translateY(-1px); }
  body.dark .btn-primary { background: var(--blue-light); color: var(--dark-bg); }
  body.dark .btn-primary:hover { background: #7ab0f0; }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    color: var(--black);
    font-family: 'Poppins', sans-serif;
    font-size: 0.82rem;
    font-weight: 400;
    padding: 0.85rem 1.8rem;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid rgba(0,0,0,0.2);
    letter-spacing: 0.04em;
    margin-left: 1rem;
    text-decoration: none;
    transition: border-color var(--transition), color var(--transition), transform 0.15s ease;
  }
  .btn-secondary:hover { border-color: var(--blue); color: var(--blue); transform: translateY(-1px); }
  body.dark .btn-secondary { color: #e8e8e8; border-color: rgba(232,232,232,0.25); }
  body.dark .btn-secondary:hover { border-color: var(--blue-light); color: var(--blue-light); }

  .section-label {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    margin-bottom: 1rem;
  }
  .section-title {
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    margin-bottom: 3.5rem;
    max-width: 640px;
    color: var(--white);
  }

  /* CAPACIDADES — full-bleed statement band, zigzag rows */
  .capacidades-band {
    background: var(--blue);
    padding: 6rem 2vw;
    transition: background var(--transition);
  }
  body.dark .capacidades-band { background: var(--dark-surface); }
  .capacidades-inner { max-width: 1160px; margin: 0 auto; }
  .capacidades-zona { margin-top: 1.6rem; font-size: 0.9rem; font-weight: 300; line-height: 1.7; color: rgba(255,255,255,0.7); }
  .capacidades-zona a { color: #ffffff; text-decoration: underline; text-underline-offset: 3px; }

  .capacidades-list { display: flex; flex-direction: column; }
  .capacidad-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2.5rem;
    padding: 2.5rem 0;
    border-top: 1px solid rgba(255,255,255,0.18);
    text-decoration: none;
    color: var(--white);
    transition: padding-left var(--transition), opacity 0.6s ease, transform 0.6s ease;
  }
  .capacidades-list a:last-child { border-bottom: 1px solid rgba(255,255,255,0.18); }
  .capacidad-row:hover { padding-left: 1.2rem; }

  .capacidad-ghost {
    order: 1;
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1;
    color: rgba(255,255,255,0.18);
    transition: color var(--transition);
  }
  .capacidad-row:hover .capacidad-ghost { color: rgba(255,255,255,0.35); }

  .capacidad-body { order: 2; }
  .capacidad-body h3 {
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .capacidad-body p {
    font-size: 0.9rem;
    font-weight: 300;
    color: rgba(255,255,255,0.75);
    line-height: 1.75;
    max-width: 520px;
  }

  .capacidad-link {
    order: 3;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--white);
    white-space: nowrap;
  }

  .capacidad-row:nth-child(even) .capacidad-ghost { order: 3; text-align: right; }
  .capacidad-row:nth-child(even) .capacidad-link { order: 1; }

  .capacidad-row:nth-child(2) { transition-delay: 0.08s; }
  .capacidad-row:nth-child(3) { transition-delay: 0.16s; }
  .capacidad-row:nth-child(4) { transition-delay: 0.24s; }

  /* STATS — full-bleed dark band, one dominant number + two side stats */
  .stats-band { background: var(--black); padding: 7rem 4vw; transition: background var(--transition); }
  body.dark .stats-band { background: #050505; }
  .stats-band-inner {
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .stat-item--hero {
    gap: 1rem;
  }
  .stat-item--hero .stat-value {
    font-size: clamp(5rem, 13vw, 10rem);
    line-height: 0.88;
  }
  .stat-item--hero .stat-label {
    font-size: clamp(2.2rem, 3.4vw, 3.4rem);
    line-height: 1.45;
    max-width: 820px;
    margin-top: 0;
  }

  .stats-side {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    border-left: 1px solid rgba(255,255,255,0.15);
    padding-left: 4rem;
  }
  .stats-side .stat-item:nth-child(2) { transition-delay: 0.1s; }

  .stat-value {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--blue-light);
  }
  .stat-label {
    font-size: clamp(1.2rem, 1.8vw, 1.7rem);
    font-weight: 500;
    color: rgba(255,255,255,0.75);
    margin-top: 0;
    line-height: 1.25;
    max-width: 380px;
  }
  .stat-label-lead {
    display: block;
    font-size: 1.2em;
    font-weight: 700;
    color: rgba(255,255,255,0.95);
  }

  @media (max-width: 900px) {
    .capacidad-row { grid-template-columns: auto 1fr; }
    .capacidad-link { display: none; }
    .capacidad-row:nth-child(even) .capacidad-ghost { order: 1; text-align: left; }
    .capacidad-row:nth-child(even) .capacidad-link { order: 3; }
    .stats-band-inner { grid-template-columns: 1fr; gap: 3rem; }
    .stats-side { border-left: none; padding-left: 0; border-top: 1px solid rgba(255,255,255,0.15); padding-top: 2.5rem; }
    .stat-item { flex-direction: column; align-items: flex-start; gap: 0; }
    .stat-item--hero .stat-label { margin-top: 1.2rem; }
    .stat-label { margin-top: 0.4rem; }
  }
</style>

<script>
  const statEls = document.querySelectorAll<HTMLElement>('.stat-item');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // El HTML ya trae el número real (contenido por defecto, visible sin JS
  // y tal cual lo indexan los buscadores). La animación es solo una mejora
  // progresiva: si corre, parte de 0 hacia ese mismo número real.
  const animateCount = (el: HTMLElement) => {
    const target = Number(el.dataset.count ?? '0');
    const numberEl = el.querySelector<HTMLElement>('.stat-number');
    if (!numberEl || prefersReducedMotion) return;
    numberEl.textContent = '0';
    const duration = 900;
    const start = performance.now();
    const step = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      numberEl.textContent = String(Math.round(progress * target));
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  if ('IntersectionObserver' in window && statEls.length) {
    const statObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            statObserver.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 }
    );
    statEls.forEach((el) => statObserver.observe(el));
  }
</script>
