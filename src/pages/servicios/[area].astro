---
// Página de cada una de las 6 áreas del catálogo (contenido en data/areas.ts).
// Los 4 servicios de consultoría tienen su propia página estática en
// /servicios/<slug>/ y cuelgan de «Estrategia y marca».
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/service.css';
import Divider from '../../components/Divider.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import FaqList from '../../components/FaqList.astro';
import { AREAS, type Area } from '../../data/areas';
import { casosForArea } from '../../data/casos';
import { SITE_NAME } from '../../consts';

export function getStaticPaths() {
  return AREAS.map((area) => ({ params: { area: area.slug }, props: { area } }));
}

const { area } = Astro.props as { area: Area };
const relatedCasos = casosForArea(area.slug);

const pasos = [
  { title: 'Llamada de 15 minutos', text: 'Nos cuentas qué necesitas y vemos si podemos ayudarte.' },
  { title: 'Propuesta en 5 días laborables', text: 'Con el alcance, el equipo, los plazos y el precio cerrado.' },
  { title: 'Equipo a medida y un solo responsable', text: 'Los especialistas de la red que necesita tu proyecto, coordinados por Guillén Bruna, que revisa cada entrega antes de que te llegue.' },
];

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: area.name,
  serviceType: area.name,
  description: area.description,
  provider: { '@type': 'ProfessionalService', name: SITE_NAME, url: 'https://gbtconsultoria.com/' },
  areaServed: [
    { '@type': 'City', name: 'Zaragoza' },
    { '@type': 'AdministrativeArea', name: 'Aragón' },
    { '@type': 'Country', name: 'España' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: area.name,
    itemListElement: area.servicios.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.name, description: s.text, ...(s.href && { url: `https://gbtconsultoria.com${s.href}` }) },
    })),
  },
  url: Astro.url.href,
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://gbtconsultoria.com/' },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: 'https://gbtconsultoria.com/servicios/' },
    { '@type': 'ListItem', position: 3, name: area.name, item: Astro.url.href },
  ],
};
---
<BaseLayout title={`${area.seoTitle} | ${SITE_NAME}`} description={area.description}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <a href="/servicios/" class="back-link">← Volver a servicios</a>

  <div class="case-main">
    <div class="case-tags">
      <span class="tag">{area.name}</span>
    </div>
    <h1>{area.seoTitle}</h1>
    <p class="case-meta">{area.intro}</p>

    <div class="case-block-full area-servicios-block">
      <h2 class="block-label">Qué hacemos</h2>
      <ul class="area-servicios">
        {area.servicios.map((s) => (
          <li>
            <h3 class="process-title">{s.href ? <a href={s.href}>{s.name}</a> : s.name}</h3>
            <p class="process-text">{s.text}</p>
            {s.href && <a href={s.href} class="area-servicio-link">Ver servicio</a>}
          </li>
        ))}
      </ul>
    </div>

    <div class="case-block-full">
      <h2 class="block-label">Para quién es</h2>
      <p class="block-text">{area.paraQuien}</p>
    </div>

    <div class="case-block-full">
      <h2 class="block-label">Cómo trabajamos</h2>
      <ol class="process-steps">
        {pasos.map((paso, i) => (
          <li>
            <span class="process-number">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="process-title">{paso.title}</h3>
              <p class="process-text">{paso.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="precio-link">Sin permanencia, con acuerdo de confidencialidad y una sola factura. <a href="/quienes-somos/#la-red">Cómo elegimos a la red</a></p>
    </div>

    {relatedCasos.length > 0 && (
      <div class="case-block-full">
        <h2 class="block-label">{relatedCasos.length > 1 ? 'Casos relacionados' : 'Caso relacionado'}</h2>
        <ul class="service-casos">
          {relatedCasos.map((caso) => (
            <li>
              <a href={`/trabajo/${caso.slug}/`}>
                <span class="service-caso-title">{caso.cardHeadline}</span>
                <span class="service-caso-company">{caso.company}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="case-block-full faq-block">
      <h2 class="block-label">Preguntas frecuentes</h2>
      <FaqList faqs={area.faqs} />
    </div>
  </div>

  <Divider />

  <ContactBlock title="¿Hablamos<br>de tu caso?" />
</BaseLayout>
