---
import Area from '../../components/paginas/Area.astro';
import { AREAS, type Area as TArea } from '../../data/areas';

export function getStaticPaths() {
  return AREAS.map((area) => ({ params: { area: area.slug }, props: { area } }));
}
const { area } = Astro.props as { area: TArea };
---
<Area area={area} lang="es" />
