---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import { SERVICES } from '../../consts';

// Los 4 servicios responden a dos públicos distintos: los 3 primeros son para
// fundadores/equipos de SaaS B2B (pipeline, GTM/ICP, posicionamiento), el
// último es para comités de dirección en general (mentoría de comunicación).
// Se agrupan visualmente para que no compitan por el mismo hueco mental.
const saasB2B = SERVICES.slice(0, 3);
const altaDireccion = SERVICES.slice(3);
---
<BaseLayout
  title="Servicios de estrategia y comunicación | Guillén Bruna Tricas"
  description="Diagnóstico de pipeline comercial, estrategia GTM, posicionamiento de producto y mentoría de comunicación ejecutiva para CEO, COO, CFO y CEO de holding."
>
  <div class="page-header">
    <span class="page-tag">Servicios</span>
    <h1>Estrategia, marketing<br />y comunicación ejecutiva</h1>
    <p class="page-desc">¿Cómo asegurar que cada inversión en marketing o cada mensaje de tu equipo directivo impulse el crecimiento real? Las empresas más ambiciosas saben que la coherencia estratégica es clave. Acompaño a líderes en la construcción de una narrativa sólida, un posicionamiento claro y procesos comerciales eficientes, transformando la visión en acción y decisiones estratégicas.</p>
  </div>

  <div class="services-group">
    <p class="services-kicker">Para fundadores y equipos de SaaS B2B</p>
    <div class="services-grid services-grid--3">
      {saasB2B.map((service, i) => (
        <a href={`/servicios/${service.slug}/`} class="service-card" data-reveal>
          <div class="service-card-top">
            <ServiceIcon slug={service.slug} />
            <span class="service-number">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h2>{service.name}</h2>
          <p>{service.tagline}</p>
          <span class="service-link">Ver servicio →</span>
        </a>
      ))}
    </div>
  </div>

  <div class="services-group">
    <p class="services-kicker">Para comités de dirección</p>
    <div class="services-grid services-grid--1">
      {altaDireccion.map((service, i) => (
        <a href={`/servicios/${service.slug}/`} class="service-card" data-reveal>
          <div class="service-card-top">
            <ServiceIcon slug={service.slug} />
            <span class="service-number">{String(saasB2B.length + i + 1).padStart(2, '0')}</span>
          </div>
          <h2>{service.name}</h2>
          <p>{service.tagline}</p>
          <span class="service-link">Ver servicio →</span>
        </a>
      ))}
    </div>
  </div>

  <ContactBlock title="¿Hablamos<br>de tu caso?" />
</BaseLayout>

<style is:global>
  /* PAGE HEADER */
  .page-header { padding: 5rem 2rem 2rem; max-width: 900px; margin: 0 auto; }
  .page-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
    border: 1px solid var(--blue);
    padding: 0.3rem 0.8rem;
    border-radius: 2px;
    margin-bottom: 2rem;
    transition: color var(--transition), border-color var(--transition);
  }
  body.dark .page-tag { color: var(--blue-light); border-color: var(--blue-light); }

  .page-header h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .page-desc {
    font-size: 1rem;
    font-weight: 300;
    color: rgba(0,0,0,0.55);
    max-width: 560px;
    line-height: 1.8;
    transition: color var(--transition);
  }
  body.dark .page-desc { color: rgba(232,232,232,0.55); }

  .services-group { max-width: 900px; margin: 0 auto; padding: 1rem 2rem 0; }
  .services-group:last-of-type { padding-bottom: 2rem; }

  .services-kicker {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.6);
    margin: 0 0 1rem;
    transition: color var(--transition);
  }
  body.dark .services-kicker { color: rgba(232,232,232,0.6); }

  .services-grid {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }
  .services-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .services-grid--1 { grid-template-columns: minmax(0, 1fr); }

  .service-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 8px;
    background: var(--white);
    text-decoration: none;
    transition: border-color var(--transition), background var(--transition), transform 0.15s ease;
  }
  body.dark .service-card { border-color: rgba(255,255,255,0.12); background: var(--dark-bg); }
  .service-card:hover { border-color: var(--blue); transform: translateY(-2px); }
  body.dark .service-card:hover { border-color: var(--blue-light); }

  .service-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.9rem;
  }

  .service-number {
    font-family: 'Poppins', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--blue);
    transition: color var(--transition);
  }
  body.dark .service-number { color: var(--blue-light); }

  .service-card h2 {
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--black);
    margin-bottom: 0.6rem;
    transition: color var(--transition);
  }
  body.dark .service-card h2 { color: #e8e8e8; }

  .service-card p {
    font-size: 0.88rem;
    font-weight: 300;
    color: rgba(0,0,0,0.6);
    line-height: 1.7;
    margin-bottom: 1.2rem;
    flex-grow: 1;
    transition: color var(--transition);
  }
  body.dark .service-card p { color: rgba(232,232,232,0.6); }

  .service-link {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--blue);
    transition: color var(--transition);
  }
  body.dark .service-link { color: var(--blue-light); }
  .service-card:hover .service-link { text-decoration: underline; }

  @media (max-width: 900px) {
    .services-grid--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .services-group { padding: 1rem 1.5rem 0; }
    .services-grid--3 { grid-template-columns: 1fr; }
  }
</style>
