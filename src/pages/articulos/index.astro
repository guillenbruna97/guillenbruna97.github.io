---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Divider from '../../components/Divider.astro';
import ContactBlock from '../../components/ContactBlock.astro';

const articulos = (await getCollection('articulos')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categoryOf = (tag: string) => tag.split('·')[0].trim();
const slugify = (value: string) =>
  value
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');

const categorias = [...new Set(articulos.map((entry) => categoryOf(entry.data.tag)))].map((nombre) => ({
  nombre,
  slug: slugify(nombre),
}));
---
<BaseLayout
  title="Artículos de marketing | Guillén Bruna Tricas"
  description="Artículos sobre estrategia de marketing, marca y go-to-market para empresas y directivos que quieren comunicar con autoridad."
>
  <div class="page-header">
    <span class="page-tag">Artículos</span>
    <h1>Ideas sobre<br />marketing y negocio</h1>
    <p class="page-desc">Escribo sobre lo que aprendo trabajando. Sin teoría vacía, sin contenido de relleno.</p>
  </div>

  <Divider />

  <h2 class="case-section-h2" style="padding: 0 2rem; max-width: 900px; margin: 0 auto 0;">Artículos publicados</h2>

  <div class="filters" id="filters">
    <button class="filter-btn active" data-filter="all">Todos</button>
    {categorias.map(({ nombre, slug }) => (
      <button class="filter-btn" data-filter={slug}>{nombre}</button>
    ))}
  </div>

  <div class="articles">
    {articulos.map((entry) => (
      <a href={`/articulos/${entry.id}/`} class="article-item" data-types={slugify(categoryOf(entry.data.tag))}>
        <div class="article-content">
          <p class="article-tag">{entry.data.tag}</p>
          <p class="article-title">{entry.data.title}</p>
          <p class="article-excerpt">{entry.data.excerpt}</p>
        </div>
        <div class="article-right">
          <span class="article-arrow">→</span>
        </div>
      </a>
    ))}
  </div>

  <script>
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const articleItems = document.querySelectorAll<HTMLElement>('.article-item');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.dataset.filter!;
        articleItems.forEach(item => {
          const types = item.dataset.types ?? '';
          if (filter === 'all' || types.includes(filter)) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        });
      });
    });
  </script>

  <ContactBlock title="¿Trabajamos<br>juntos?" />
</BaseLayout>

<style is:global>
  .page-header { padding: 5rem 2rem 3rem; max-width: 900px; margin: 0 auto; }

  .page-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
    border: 1px solid var(--blue);
    padding: 0.3rem 0.8rem;
    border-radius: 2px;
    margin-bottom: 2rem;
    transition: color var(--transition), border-color var(--transition);
  }
  body.dark .page-tag { color: var(--blue-light); border-color: var(--blue-light); }

  .page-header h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .page-desc {
    font-size: 1rem;
    font-weight: 300;
    color: rgba(0,0,0,0.55);
    max-width: 520px;
    line-height: 1.8;
    transition: color var(--transition);
  }
  body.dark .page-desc { color: rgba(232,232,232,0.55); }

  /* FILTERS */
  .filters {
    padding: 0.5rem 2rem 0;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .filter-btn {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.45rem 1rem;
    border-radius: 8px;
    background: transparent;
    color: rgba(0,0,0,0.45);
    border: 1px solid rgba(0,0,0,0.12);
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    transition: all var(--transition);
  }
  body.dark .filter-btn { color: rgba(232,232,232,0.4); border-color: rgba(255,255,255,0.12); }
  .filter-btn.active { background: var(--black); color: var(--white); border-color: var(--black); }
  body.dark .filter-btn.active { background: var(--blue-light); color: var(--dark-bg); border-color: var(--blue-light); }
  .filter-btn:hover:not(.active) { border-color: var(--blue); color: var(--blue); }
  body.dark .filter-btn:hover:not(.active) { border-color: var(--blue-light); color: var(--blue-light); }
  .filter-btn:active { transform: scale(0.97); }

  /* ARTICLES */
  .articles { padding: 3rem 2rem; max-width: 900px; margin: 0 auto; }

  .article-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 2rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    gap: 2rem;
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition);
  }
  body.dark .article-item { border-bottom-color: rgba(255,255,255,0.08); }
  .article-item:first-child { border-top: 1px solid rgba(0,0,0,0.06); }
  body.dark .article-item:first-child { border-top-color: rgba(255,255,255,0.08); }
  .article-item.hidden { display: none; }

  .article-content { flex: 1; }
  .article-tag {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 0.6rem;
    transition: color var(--transition);
  }
  body.dark .article-tag { color: var(--blue-light); }

  .article-title {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
    transition: color var(--transition);
  }
  body.dark .article-title { color: #e8e8e8; }
  .article-item:hover .article-title { color: var(--blue); }
  body.dark .article-item:hover .article-title { color: var(--blue-light); }

  .article-excerpt {
    font-size: 0.82rem;
    font-weight: 300;
    color: rgba(0,0,0,0.5);
    line-height: 1.7;
    transition: color var(--transition);
  }
  body.dark .article-excerpt { color: rgba(232,232,232,0.45); }

  .article-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.8rem; flex-shrink: 0; }
  .article-meta {
    font-size: 0.72rem;
    font-weight: 300;
    color: rgba(0,0,0,0.35);
    white-space: nowrap;
    transition: color var(--transition);
  }
  body.dark .article-meta { color: rgba(232,232,232,0.38); }

  .article-arrow { font-size: 1rem; color: var(--blue); opacity: 0; transition: opacity 0.2s, color var(--transition); }
  body.dark .article-arrow { color: var(--blue-light); }
  .article-item:hover .article-arrow { opacity: 1; }

  @media (max-width: 640px) {
    .article-item { flex-direction: column; gap: 1rem; }
    .article-right { align-items: flex-start; }
  }
</style>
