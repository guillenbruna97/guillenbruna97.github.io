---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Divider from '../../../../components/Divider.astro';
import ContactBlock from '../../../../components/ContactBlock.astro';
import ArticlesListing from '../../../../components/ArticlesListing.astro';
import PageHeaderMarquee from '../../../../components/PageHeaderMarquee.astro';
import { activeCategories, categoryFor } from '../../../../utils/articles';

export const getStaticPaths = (async ({ paginate }) => {
  const articulos = (await getCollection('articulos')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );

  // Una ruta paginada por categoria: filtra sobre TODOS los articulos (no solo
  // los de la pagina actual), y solo genera paginas 2+ si esa categoria tiene
  // mas de 6 articulos.
  return activeCategories(articulos.map((entry) => entry.data.tag)).flatMap((category) => {
    const articulosDeCategoria = articulos.filter((entry) => categoryFor(entry.data.tag).slug === category.slug);
    return paginate(articulosDeCategoria, {
      pageSize: 6,
      params: { category: category.slug },
      props: { category },
    });
  });
}) satisfies GetStaticPaths;

const { page, category } = Astro.props;

const todosLosArticulos = await getCollection('articulos');
const categorias = activeCategories(todosLosArticulos.map((entry) => entry.data.tag));

const tituloPagina = page.currentPage === 1
  ? `${category.metaTitle} | Guillén Bruna Tricas`
  : `${category.metaTitle} | Pág. ${page.currentPage} | Guillén Bruna Tricas`;

const descripcionPagina = page.currentPage === 1
  ? category.description
  : `${category.description} Página ${page.currentPage}.`;
---
<BaseLayout
  title={tituloPagina}
  description={descripcionPagina}
  noindex={page.currentPage > 1}
>
  <PageHeaderMarquee
    message={`${category.heading} | Escribo sobre lo que aprendo trabajando. Sin teoría vacía, sin contenido de relleno.`}
  />

  <Divider />

  <ArticlesListing page={page} categorias={categorias} activeSlug={category.slug} basePath={`/articulos/categoria/${category.slug}`} />

  <ContactBlock title="¿Trabajamos<br>juntos?" />
</BaseLayout>
