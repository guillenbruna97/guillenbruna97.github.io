---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import ArticlesListing from '../../components/ArticlesListing.astro';
import CabeceraPagina from '../../components/CabeceraPagina.astro';
import { activeCategories } from '../../utils/articles';

export const getStaticPaths = (async ({ paginate }) => {
  const articulos = (await getCollection('articulos')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  // Maximo de articulos por pagina, sin que penalice al posicionamiento:
  // cada pagina es una URL real e indexable con su propio canonical.
  // 7 = uno destacado + 2 filas de 3.
  return paginate(articulos, { pageSize: 7 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const todosLosArticulos = await getCollection('articulos');

const categorias = activeCategories(todosLosArticulos.map((entry) => entry.data.tag));

const tituloPagina = page.currentPage === 1
  ? 'Artículos de marketing | GBT Consultoría'
  : `Artículos de marketing | Página ${page.currentPage} | GBT Consultoría`;

const descripcionBase = 'Artículos sobre estrategia de marketing, marca, comunicación directiva y go-to-market B2B para empresas y directivos que quieren comunicar con autoridad.';
const descripcionPagina = page.currentPage === 1
  ? descripcionBase
  : `${descripcionBase} Página ${page.currentPage}.`;
---
<BaseLayout
  title={tituloPagina}
  description={descripcionPagina}
>
  <CabeceraPagina
    titulo="Artículos de marketing, marca y estrategia"
    intro="Lo que aprendemos trabajando con empresas: estrategia de marketing, marca, go to market, comunicación directiva e IA en marketing. Sin teoría vacía ni contenido de relleno."
    migas={[{ href: '/recursos/', texto: 'Recursos' }, { href: '/articulos/', texto: 'Artículos' }]}
  />

  <ArticlesListing page={page} categorias={categorias} activeSlug="all" basePath="/articulos" />

  <ContactBlock title="¿Hablamos<br>de tu caso?" />
</BaseLayout>

