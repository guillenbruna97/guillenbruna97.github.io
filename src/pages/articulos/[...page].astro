---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Divider from '../../components/Divider.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import ArticlesListing from '../../components/ArticlesListing.astro';
import { categoryOf, slugify } from '../../utils/articles';

export const getStaticPaths = (async ({ paginate }) => {
  const articulos = (await getCollection('articulos')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  // Maximo de articulos por pagina, sin que penalice al posicionamiento:
  // cada pagina es una URL real e indexable con su propio canonical.
  // 6 = 3 filas x 2 columnas en el grid de cards.
  return paginate(articulos, { pageSize: 6 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const todosLosArticulos = await getCollection('articulos');

const categorias = [...new Set(todosLosArticulos.map((entry) => categoryOf(entry.data.tag)))].map((nombre) => ({
  nombre,
  slug: slugify(nombre),
}));

const tituloPagina = page.currentPage === 1
  ? 'Artículos de marketing | Guillén Bruna Tricas'
  : `Artículos de marketing | Página ${page.currentPage} | Guillén Bruna Tricas`;
---
<BaseLayout
  title={tituloPagina}
  description="Artículos sobre estrategia de marketing, marca y go-to-market para empresas y directivos que quieren comunicar con autoridad."
>
  <div class="page-header">
    <span class="page-tag">Artículos</span>
    <h1>Ideas sobre<br />marketing y negocio</h1>
    <p class="page-desc">Escribo sobre lo que aprendo trabajando. Sin teoría vacía, sin contenido de relleno.</p>
  </div>

  <Divider />

  <h2 class="case-section-h2" style="padding: 0 2rem; max-width: 900px; margin: 0 auto 0;">Artículos publicados</h2>

  <ArticlesListing page={page} categorias={categorias} activeSlug="all" basePath="/articulos" />

  <ContactBlock title="¿Trabajamos<br>juntos?" />
</BaseLayout>

<style is:global>
  .page-header { padding: 5rem 2rem 3rem; max-width: 900px; margin: 0 auto; }

  .page-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
    border: 1px solid var(--blue);
    padding: 0.3rem 0.8rem;
    border-radius: 2px;
    margin-bottom: 2rem;
    transition: color var(--transition), border-color var(--transition);
  }
  body.dark .page-tag { color: var(--blue-light); border-color: var(--blue-light); }

  .page-header h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .page-desc {
    font-size: 1rem;
    font-weight: 300;
    color: rgba(0,0,0,0.55);
    max-width: 520px;
    line-height: 1.8;
    transition: color var(--transition);
  }
  body.dark .page-desc { color: rgba(232,232,232,0.55); }
</style>
