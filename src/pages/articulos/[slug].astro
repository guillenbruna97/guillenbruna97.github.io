---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getRelatedArticles } from '../../utils/articles';

export async function getStaticPaths() {
  const articulos = await getCollection('articulos');
  return articulos.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allArticulos = await getCollection('articulos');
const related = getRelatedArticles(allArticulos, entry);
---
<ArticleLayout
  title={`${entry.data.seoTitle ?? entry.data.title} | Guillén Bruna Tricas`}
  description={entry.data.description}
  tag={entry.data.tag}
  heading={entry.data.title}
  date={entry.data.date}
  readingTime={entry.data.readingTime}
  image={entry.data.image}
  imageAlt={entry.data.imageAlt}
  service={entry.data.service}
  related={related}
>
  <Content />
</ArticleLayout>
