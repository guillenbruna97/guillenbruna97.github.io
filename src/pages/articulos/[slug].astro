---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { displayTag, getRelatedArticles } from '../../utils/articles';

export async function getStaticPaths() {
  const articulos = await getCollection('articulos');
  return articulos.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allArticulos = await getCollection('articulos');
const related = getRelatedArticles(allArticulos, entry);
---
<ArticleLayout
  title={`${entry.data.seoTitle ?? entry.data.title} | Guillén Bruna Tricas`}
  description={entry.data.description}
  tag={displayTag(entry.data.tag)}
  heading={entry.data.title}
  date={entry.data.date}
  updated={entry.data.updated}
  readingTime={entry.data.readingTime}
  image={entry.data.image}
  imageAlt={entry.data.imageAlt}
  service={entry.data.service}
  related={related}
  faqs={entry.data.faqs}
>
  <Content />
</ArticleLayout>
