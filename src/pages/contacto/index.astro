---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BOOKING_URL, MAILTO_URL, CONTACT_EMAIL, LINKEDIN_URL, LINKEDIN_HANDLE } from '../../consts';
---
<BaseLayout
  title="Contacto | GBT Consultoría"
  description="Habla con un consultor de estrategia de marketing y marca. Posicionamiento, go-to-market y comunicación ejecutiva para directivos en Zaragoza."
>
  <div class="contact-main">
    <div>
      <h1>Hablemos<br />sin rodeos</h1>
      <p class="contact-desc">Si tienes un proyecto, una pregunta o simplemente quieres hablar de marketing y negocio, escríbeme. Leo todos los mensajes y respondo a los que tienen sentido.</p>
      <h2 class="case-section-h2">Canales de contacto</h2>
      <div class="contact-channels">
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="channel-item">
          <div>
            <p class="channel-label">Agenda una llamada</p>
            <p class="channel-value">15 minutos, sin compromiso</p>
          </div>
          <span class="channel-arrow" aria-hidden="true">↗</span>
        </a>
        <a href={MAILTO_URL} class="channel-item">
          <div>
            <p class="channel-label">Email</p>
            <p class="channel-value">{CONTACT_EMAIL}</p>
          </div>
          <span class="channel-arrow" aria-hidden="true">↗</span>
        </a>
        <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="channel-item">
          <div>
            <p class="channel-label">LinkedIn</p>
            <p class="channel-value">{LINKEDIN_HANDLE}</p>
          </div>
          <span class="channel-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="contact-info">
      <p class="info-label">Tu interlocutor</p>
      <div class="info-item">
        <p class="info-item-label">Ubicación</p>
        <p class="info-item-value">Zaragoza, España</p>
      </div>
      <div class="info-item">
        <p class="info-item-label">Rol actual</p>
        <p class="info-item-value">Head of Brand & Marketing en Zebra AI Transformation Company</p>
      </div>
      <div class="info-item">
        <p class="info-item-label">Disponibilidad</p>
        <p class="info-item-value">Abierto a proyectos, colaboraciones y conversaciones interesantes</p>
      </div>
      <div class="info-item">
        <p class="info-item-label">Áreas</p>
        <p class="info-item-value">Marketing estratégico, GTM, marca, consultoría, SaaS B2B</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .contact-main {
    padding: 5rem 2rem;
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: start;
  }

  .contact-main h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .contact-desc {
    font-size: 1rem;
    font-weight: 300;
    color: rgba(0,0,0,0.6);
    line-height: 1.85;
    margin-bottom: 2.5rem;
    transition: color var(--transition);
  }
  body.dark .contact-desc { color: rgba(232,232,232,0.6); }

  .contact-channels { display: flex; flex-direction: column; gap: 1rem; }

  .channel-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 1.5rem;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition), background var(--transition);
  }
  body.dark .channel-item { border-color: rgba(255,255,255,0.08); }
  .channel-item:hover { border-color: var(--blue); background: var(--off-white); }
  body.dark .channel-item:hover { border-color: var(--blue-light); background: var(--dark-surface); }

  .channel-label {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0;
    color: rgba(0,0,0,0.35);
    margin-bottom: 0.2rem;
    transition: color var(--transition);
  }
  body.dark .channel-label { color: rgba(232,232,232,0.35); }

  .channel-value { font-size: 0.9rem; font-weight: 500; overflow-wrap: anywhere; transition: color var(--transition); }
  body.dark .channel-value { color: #e8e8e8; }

  .channel-arrow { color: var(--blue); font-size: 1rem; opacity: 0.4; transition: opacity 0.2s, color var(--transition); }
  body.dark .channel-arrow { color: var(--blue-light); }
  .channel-item:hover .channel-arrow { opacity: 1; }

  /* CONTACT INFO */
  .contact-info { padding-top: 1rem; transition-delay: 0.1s; }
  .info-label {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0;
    color: rgba(0,0,0,0.35);
    margin-bottom: 2rem;
    transition: color var(--transition);
  }
  body.dark .info-label { color: rgba(232,232,232,0.4); }

  .info-item { margin-bottom: 2rem; }
  .info-item-label {
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--blue);
    margin-bottom: 0.3rem;
    transition: color var(--transition);
  }
  body.dark .info-item-label { color: var(--blue-light); }
  .info-item-value {
    font-size: 0.92rem;
    font-weight: 300;
    color: rgba(0,0,0,0.65);
    transition: color var(--transition);
  }
  body.dark .info-item-value { color: rgba(232,232,232,0.65); }

  @media (max-width: 640px) {
    /* minmax(0, 1fr): con 1fr la columna no baja del email más largo y a 320px desbordaba */
    .contact-main { grid-template-columns: minmax(0, 1fr); gap: 3rem; padding: 4rem 1.5rem; }
  }
</style>
