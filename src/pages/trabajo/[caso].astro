---
// Una página por caso real (/trabajo/<slug>/), toda pintada por CaseLayout
// con los datos de data/casos.ts y data/casos-detalle.ts.
import CaseLayout from '../../layouts/CaseLayout.astro';
import { casos } from '../../data/casos';

export function getStaticPaths() {
  return casos.map((c) => ({ params: { caso: c.slug } }));
}
const { caso } = Astro.params;
---
<CaseLayout slug={caso!} />
