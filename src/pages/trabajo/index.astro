---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Divider from '../../components/Divider.astro';
import ContactBlock from '../../components/ContactBlock.astro';
---
<BaseLayout
  title="Casos reales de estrategia de marca y GTM | Guillén Bruna Tricas"
  description="Proyectos de estrategia de marca, lanzamiento de producto y generación de demanda. Casos reales para empresas y directivos."
>
  <div class="page-header">
    <span class="page-tag">Portfolio</span>
    <h1>Casos<br />reales</h1>
    <p class="page-desc">Proyectos donde estrategia, ejecución y resultados fueron de la mano.</p>
  </div>

  <div class="filters" id="filters">
    <button class="filter-btn active" data-filter="all">Todos</button>
    <button class="filter-btn" data-filter="marca">Estrategia de marca</button>
    <button class="filter-btn" data-filter="lanzamiento">Lanzamiento</button>
    <button class="filter-btn" data-filter="demanda">Generación de demanda</button>
    <button class="filter-btn" data-filter="contenido">Contenido</button>
    <button class="filter-btn" data-filter="eventos">Eventos</button>
    <button class="filter-btn" data-filter="ecommerce">eCommerce</button>
    <button class="filter-btn" data-filter="consultoria">Consultoría</button>
  </div>

  <Divider />

  <div class="cases">
    <div class="case-item" data-types="marca lanzamiento">
      <p class="case-number">01</p>
      <div class="case-content">
        <div class="case-tags">
          <span class="tag">Estrategia de marca</span>
          <span class="tag">Lanzamiento</span>
        </div>
        <h2>Construcción de marca y estrategia GTM</h2>
        <p class="case-role">Zebra Ventures · Head of Brand & Marketing</p>
        <p class="case-desc">Diagnóstico de ICP, reescritura del mensaje de marca, rediseño de la web, estrategia de contenidos, funnel de conversión y lanzamiento de una segunda línea de negocio desde cero. Incluye el Spain Innovation Summit, evento propio con estudio sectorial.</p>
        <a href="/trabajo/zebra-ventures/" class="case-link">Ver caso completo →</a>
      </div>
      <p class="case-year">2024–hoy</p>
    </div>

    <div class="case-item" data-types="ecommerce demanda">
      <p class="case-number">02</p>
      <div class="case-content">
        <div class="case-tags">
          <span class="tag">eCommerce</span>
          <span class="tag">Generación de demanda</span>
        </div>
        <h2>Lanzamiento y crecimiento de una marca de moda</h2>
        <p class="case-role">Broco · Fundador</p>
        <p class="case-desc">Creación de una marca de moda desde la idea hasta las primeras ventas. Identidad, canal digital, paid media y operaciones. Aprendizaje de negocio real sin red ni equipo grande.</p>
        <a href="/trabajo/broco/" class="case-link">Ver caso completo →</a>
      </div>
      <p class="case-year">Anterior</p>
    </div>

    <div class="case-item" data-types="eventos marca">
      <p class="case-number">03</p>
      <div class="case-content">
        <div class="case-tags">
          <span class="tag">Eventos</span>
          <span class="tag">Estrategia de marca</span>
        </div>
        <h2>Campañas omnicanal de temporada</h2>
        <p class="case-role">Muebles Rey & Muebles Tuco · Marketing</p>
        <p class="case-desc">Gestión de campañas de gran volumen en retail de muebles. Coordinación de canal online y offline, creatividad y activaciones, con resultados medibles en ambas marcas.</p>
      </div>
      <p class="case-year">Anterior</p>
    </div>

    <div class="case-item" data-types="consultoria">
      <p class="case-number">04</p>
      <div class="case-content">
        <div class="case-tags">
          <span class="tag">Consultoría</span>
        </div>
        <h2>Acompañamiento estratégico a dirección</h2>
        <p class="case-role">Integra Consultoría Gerencial · Consultor</p>
        <p class="case-desc">Diagnóstico y acompañamiento a dirección en procesos de transformación organizativa y redefinición de modelo comercial.</p>
      </div>
      <p class="case-year">Anterior</p>
    </div>
  </div>

  <Divider />

  <div class="trust-section">
    <p class="trust-label">Confiaron en mí</p>
    <div class="trust-logos">
      <span>Zebra Ventures</span>
      <span>Muebles Rey</span>
      <span>Muebles Tuco</span>
      <span>Integra</span>
      <span>Broco</span>
    </div>
  </div>

  <ContactBlock title="¿Trabajamos<br>juntos?" />
</BaseLayout>

<style is:global>
  /* PAGE HEADER */
  .page-header { padding: 5rem 2rem 2rem; max-width: 900px; margin: 0 auto; }
  .page-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
    border: 1px solid var(--blue);
    padding: 0.3rem 0.8rem;
    border-radius: 2px;
    margin-bottom: 2rem;
    transition: color var(--transition), border-color var(--transition);
  }
  body.dark .page-tag { color: var(--blue-light); border-color: var(--blue-light); }

  .page-header h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .page-desc {
    font-size: 1rem;
    font-weight: 300;
    color: rgba(0,0,0,0.55);
    max-width: 520px;
    line-height: 1.8;
    transition: color var(--transition);
  }
  body.dark .page-desc { color: rgba(232,232,232,0.55); }

  /* FILTERS */
  .filters {
    padding: 1.5rem 2rem 3rem;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .filter-btn {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.45rem 1rem;
    border-radius: 2px;
    background: transparent;
    color: rgba(0,0,0,0.45);
    border: 1px solid rgba(0,0,0,0.12);
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    transition: all var(--transition);
  }
  body.dark .filter-btn { color: rgba(232,232,232,0.4); border-color: rgba(255,255,255,0.12); }
  .filter-btn.active { background: var(--black); color: var(--white); border-color: var(--black); }
  body.dark .filter-btn.active { background: var(--blue-light); color: var(--dark-bg); border-color: var(--blue-light); }
  .filter-btn:hover:not(.active) { border-color: var(--blue); color: var(--blue); }
  body.dark .filter-btn:hover:not(.active) { border-color: var(--blue-light); color: var(--blue-light); }

  /* CASES */
  .cases { padding: 3rem 2rem; max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; }
  .case-item {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    gap: 2rem;
    align-items: start;
    padding: 2.5rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    transition: border-color var(--transition);
  }
  body.dark .case-item { border-bottom-color: rgba(255,255,255,0.08); }
  .case-item:first-child { border-top: 1px solid rgba(0,0,0,0.06); }
  body.dark .case-item:first-child { border-top-color: rgba(255,255,255,0.08); }
  .case-item.hidden { display: none; }

  .case-number {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--blue);
    padding-top: 0.3rem;
    transition: color var(--transition);
  }
  body.dark .case-number { color: var(--blue-light); }

  .case-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.7rem; }

  .case-content h2 {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.3rem;
    transition: color var(--transition);
  }
  body.dark .case-content h2 { color: #e8e8e8; }

  .case-role {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--blue);
    margin-bottom: 1rem;
    transition: color var(--transition);
  }
  body.dark .case-role { color: var(--blue-light); }

  .case-desc {
    font-size: 0.9rem;
    font-weight: 300;
    color: rgba(0,0,0,0.6);
    line-height: 1.8;
    margin-bottom: 1rem;
    transition: color var(--transition);
  }
  body.dark .case-desc { color: rgba(232,232,232,0.6); }

  .case-link {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--blue);
    text-decoration: none;
    transition: color var(--transition);
  }
  body.dark .case-link { color: var(--blue-light); }
  .case-link:hover { text-decoration: underline; }

  .case-year {
    font-size: 0.75rem;
    font-weight: 300;
    color: rgba(0,0,0,0.3);
    white-space: nowrap;
    padding-top: 0.3rem;
    transition: color var(--transition);
  }
  body.dark .case-year { color: rgba(232,232,232,0.3); }

  /* TRUST (texto) */
  .trust-logos span {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: rgba(0,0,0,0.35);
    transition: color var(--transition);
  }
  body.dark .trust-logos span { color: rgba(232,232,232,0.35); }

  @media (max-width: 640px) {
    .case-item { grid-template-columns: 1fr; gap: 0.5rem; }
    .case-year { display: none; }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const caseItems = document.querySelectorAll<HTMLElement>('.case-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter!;
      caseItems.forEach(item => {
        const types = item.dataset.types ?? '';
        if (filter === 'all' || types.includes(filter)) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    });
  });
</script>
