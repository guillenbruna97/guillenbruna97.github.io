---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Divider from '../../components/Divider.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import TrustMarquee from '../../components/TrustMarquee.astro';
import PageHeaderMarquee from '../../components/PageHeaderMarquee.astro';
import { Image } from 'astro:assets';
import { casos } from '../../data/casos';

const trustLogos = [
  { src: '/logo-zebra.svg', alt: 'Logo de Zebra Ventures' },
  { src: '/logo-rey.png', alt: 'Logo de Muebles Rey' },
  { src: '/logo-tuco.svg', alt: 'Logo de Muebles Tuco' },
  { src: '/logo-grupo-rey.svg', alt: 'Logo de Grupo Rey Corporación' },
  { src: '/logo-slm.svg', alt: 'Logo de SLM' },
  { src: '/logo-integra.svg', alt: 'Logo de Integra Consultoría Gerencial' },
];
---
<BaseLayout
  title="Casos reales de marketing | Guillén Bruna Tricas"
  description="Proyectos de estrategia de marca, lanzamiento de producto y generación de demanda. Casos reales para empresas y directivos."
>
  <PageHeaderMarquee
    message="Casos reales | Proyectos donde estrategia, ejecución y resultados fueron de la mano."
  />

  <Divider />

  <div class="cases">
    {casos.map((caso, i) => (
      <div class="case-item" data-reveal>
        <div class="case-media">
          <a href={`/trabajo/${caso.slug}/`} aria-label={caso.ariaLabel}>
            <Image src={caso.image} alt={caso.imageAlt} width={960} widths={[480, 720, 960]} sizes="(max-width: 640px) 100vw, 50vw" format="webp" quality={55} />
          </a>
        </div>
        <div class="case-meta">
          <p class="case-number">{String(i + 1).padStart(2, '0')}</p>
        </div>
        <div class="case-content">
          <div class="case-tags">
            {caso.cardTags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
          <h2><a href={`/trabajo/${caso.slug}/`}>{caso.cardHeadline}</a></h2>
          <p class="case-role">{caso.company} · {caso.role}</p>
          <p class="case-desc">{caso.cardDesc}</p>
          <p class="case-highlight">{caso.cardHighlight}</p>
          <a href={`/trabajo/${caso.slug}/`} class="case-link">Ver caso completo →</a>
        </div>
      </div>
    ))}
  </div>

  <Divider />

  <TrustMarquee logos={trustLogos} />

  <ContactBlock title="¿Trabajamos<br>juntos?" />
</BaseLayout>

<style is:global>
  /* CASES */
  .cases { padding: 3rem 2rem; max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .case-item {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0 0 2rem;
    border: 1px solid rgba(0,0,0,0.1);
    background: var(--white);
    transition: border-color var(--transition), opacity 0.6s ease, transform 0.6s ease;
  }
  body.dark .case-item { border-color: rgba(255,255,255,0.12); background: var(--dark-bg); }
  .case-media { aspect-ratio: 16 / 10; overflow: hidden; background: var(--blue); }
  .case-media a { display: block; height: 100%; }
  .case-media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .case-item:hover .case-media img { transform: scale(1.03); }
  .case-meta { display: flex; justify-content: space-between; align-items: baseline; padding: 1.25rem 1.5rem 0; }
  .case-content { padding: 0 1.5rem; }
  .case-item.hidden { display: none; }
  .case-item:nth-child(2) { transition-delay: 0.08s; }
  .case-item:nth-child(3) { transition-delay: 0.16s; }
  .case-item:nth-child(4) { transition-delay: 0.24s; }

  .case-number {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--blue);
    transition: color var(--transition);
  }
  body.dark .case-number { color: var(--blue-light); }

  .case-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.7rem; }

  .case-content h2 {
    font-size: 1.3rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 0.3rem;
    transition: color var(--transition);
  }
  .case-content h2 a { color: inherit; text-decoration: none; }
  body.dark .case-content h2 { color: #e8e8e8; }

  .case-role {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--blue);
    margin-bottom: 1rem;
    transition: color var(--transition);
  }
  body.dark .case-role { color: var(--blue-light); }

  .case-desc {
    font-size: 0.9rem;
    font-weight: 300;
    color: rgba(0,0,0,0.6);
    line-height: 1.8;
    margin-bottom: 1rem;
    transition: color var(--transition);
  }
  body.dark .case-desc { color: rgba(232,232,232,0.6); }

  .case-highlight {
    font-size: 0.8rem;
    font-weight: 500;
    color: rgba(0,0,0,0.75);
    margin: -0.4rem 0 1.1rem;
    transition: color var(--transition);
  }
  body.dark .case-highlight { color: rgba(232,232,232,0.75); }

  .case-link {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--blue);
    text-decoration: none;
    transition: color var(--transition);
  }
  body.dark .case-link { color: var(--blue-light); }
  .case-link:hover { text-decoration: underline; }

  @media (max-width: 640px) {
    .cases { grid-template-columns: 1fr; padding-left: 1.25rem; padding-right: 1.25rem; }
  }
</style>

