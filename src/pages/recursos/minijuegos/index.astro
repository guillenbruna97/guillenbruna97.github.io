---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactBlock from '../../../components/ContactBlock.astro';
import CabeceraPagina from '../../../components/CabeceraPagina.astro';
import JuegoCard from '../../../components/JuegoCard.astro';
import { GAMES } from '../../../consts';

const TONOS = ['azul', 'oscuro', 'claro'] as const;
---
<BaseLayout
  title="Minijuegos de marketing para directivos | GBT Consultoría"
  description="Minijuegos y autodiagnósticos de marketing para CEO, COO y CFO. Retos breves para poner a prueba tu estrategia comercial, tu mensaje y tu posicionamiento."
>
  <CabeceraPagina
    titulo="Minijuegos de marketing para directivos"
    intro="Retos de tres o cuatro minutos para poner a prueba tu visión estratégica. Al terminar te llevas un resultado con lo que conviene revisar primero."
    migas={[{ href: '/recursos/', texto: 'Recursos' }, { href: '/recursos/minijuegos/', texto: 'Minijuegos' }]}
  />

  <div class="mj-grid">
    {GAMES.map((game, i) => <JuegoCard game={game} tono={TONOS[i % TONOS.length]} />)}
  </div>

  <ContactBlock title="¿Hablamos<br>de tu caso?" />
</BaseLayout>

<style is:global>
  .mj-grid { max-width: 1240px; margin: 0 auto; padding: 0 4vw 5rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; align-items: stretch; }
  @media (max-width: 760px) { .mj-grid { grid-template-columns: 1fr; } }
</style>
