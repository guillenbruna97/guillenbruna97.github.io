---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactBlock from '../../../components/ContactBlock.astro';
import Tag from '../../../components/Tag.astro';
import { GAMES } from '../../../consts';
---
<BaseLayout
  title="Minijuegos de marketing para directivos | Guillén Bruna"
  description="Minijuegos y autodiagnósticos de marketing para CEO, COO y CFO. Retos breves para poner a prueba tu estrategia comercial, tu mensaje y tu posicionamiento."
>
  <div class="page-header">
    <h1>Minijuegos de marketing</h1>
    <p class="page-desc">Minijuegos de marketing para directivos. Pon a prueba tu visión estratégica con retos que te harán pensar.</p>
  </div>

  <!-- Mismas tarjetas en 2 columnas que /articulos/ (ArticlesListing.astro),
       con una cabecera tipográfica en lugar de imagen. -->
  <div class="games-grid">
    {GAMES.map((game) => (
      <div class="game-card" data-reveal>
        <a href={`/recursos/minijuegos/${game.slug}/`} class="game-card-media" aria-label={`${game.cta}: ${game.name}`}>
          <span class="game-card-hook">{game.hook}</span>
          <span class="game-card-meta">{game.meta}</span>
        </a>
        <div class="game-card-content">
          <div class="game-card-tags"><Tag label={game.tag} /></div>
          <h2><a href={`/recursos/minijuegos/${game.slug}/`}>{game.name}</a></h2>
          <p>{game.excerpt}</p>
          <a href={`/recursos/minijuegos/${game.slug}/`} class="game-card-link">{game.cta} →</a>
        </div>
      </div>
    ))}
  </div>

  <ContactBlock title="¿Hablamos<br>de tu caso?" />
</BaseLayout>

<style is:global>
  .page-header { padding: 5rem 2rem 2rem; max-width: 900px; margin: 0 auto; }

  .page-header h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .page-desc {
    font-size: 1rem;
    font-weight: 300;
    color: rgba(0,0,0,0.55);
    max-width: 560px;
    line-height: 1.8;
    transition: color var(--transition);
  }
  body.dark .page-desc { color: rgba(232,232,232,0.55); }

  .games-grid {
    padding: 2rem 2rem 3rem;
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .game-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0 0 2rem;
    border: 1px solid rgba(0,0,0,0.1);
    background: var(--white);
    transition: border-color var(--transition), opacity 0.6s ease, transform 0.6s ease;
  }
  body.dark .game-card { border-color: rgba(255,255,255,0.12); background: var(--dark-bg); }

  .game-card-media {
    aspect-ratio: 16 / 10;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2rem;
    background: var(--blue);
    color: #fff;
    text-decoration: none;
    overflow: hidden;
  }
  .game-card-hook {
    font-family: 'Newsreader', serif;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    transition: transform 0.6s ease;
    transform-origin: left top;
  }
  .game-card:hover .game-card-hook { transform: scale(1.03); }
  .game-card-meta {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .game-card-content { padding: 1.5rem 1.5rem 0; }
  .game-card-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.7rem; }

  .game-card-content h2 {
    font-size: 1.3rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 0.6rem;
    transition: color var(--transition);
  }
  .game-card-content h2 a { color: inherit; text-decoration: none; }
  body.dark .game-card-content h2 { color: #e8e8e8; }
  .game-card:hover .game-card-content h2 { color: var(--blue); }
  body.dark .game-card:hover .game-card-content h2 { color: var(--blue-light); }

  .game-card-content p {
    font-size: 0.9rem;
    font-weight: 300;
    color: rgba(0,0,0,0.6);
    line-height: 1.8;
    margin-bottom: 1rem;
    transition: color var(--transition);
  }
  body.dark .game-card-content p { color: rgba(232,232,232,0.6); }

  .game-card-link {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--blue);
    text-decoration: none;
    transition: color var(--transition);
  }
  body.dark .game-card-link { color: var(--blue-light); }
  .game-card-link:hover { text-decoration: underline; }

  @media (max-width: 640px) {
    .games-grid { grid-template-columns: 1fr; padding-left: 1.25rem; padding-right: 1.25rem; }
  }
</style>
