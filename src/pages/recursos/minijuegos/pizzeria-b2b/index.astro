---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { BOOKING_URL } from '../../../../consts';
import {
  MOMENTOS,
  PERFILES,
  NIVELES,
  DESENLACES,
  IMPACIENCIA,
  HAMBRE_VUELVE,
  HAMBRE_RECOMIENDA,
  HAMBRE_POSTRE,
  PRECIO_PIZZA,
  CLIENTES_JORNADA,
  JORNADA,
} from '../../../../data/pizzeria';

const config = {
  momentos: MOMENTOS,
  perfiles: PERFILES,
  niveles: NIVELES,
  desenlaces: DESENLACES,
  impaciencia: IMPACIENCIA,
  umbrales: { vuelve: HAMBRE_VUELVE, recomienda: HAMBRE_RECOMIENDA, postre: HAMBRE_POSTRE },
  precioPizza: PRECIO_PIZZA,
  clientesJornada: CLIENTES_JORNADA,
  jornada: JORNADA,
  url: 'https://guillenbruna97.github.io/recursos/minijuegos/pizzeria-b2b/',
};

const pageUrl = 'https://guillenbruna97.github.io/recursos/minijuegos/pizzeria-b2b/';
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://guillenbruna97.github.io/' },
    { '@type': 'ListItem', position: 2, name: 'Recursos', item: 'https://guillenbruna97.github.io/recursos/' },
    { '@type': 'ListItem', position: 3, name: 'Minijuegos', item: 'https://guillenbruna97.github.io/recursos/minijuegos/' },
    { '@type': 'ListItem', position: 4, name: 'La pizzería B2B', item: pageUrl },
  ],
};
---
<BaseLayout
  title="La pizzería B2B, un juego para entender el proceso comercial"
  description="Abre una pizzería y acompaña a un cliente desde el anuncio hasta el postre. Cada decisión es una fase del proceso comercial B2B, de la atracción a la posventa."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/json" id="pz-data" set:html={JSON.stringify(config)} />

  <section class="pz">
    <a href="/recursos/minijuegos/" class="pz-back">← Minijuegos</a>
    <div class="pz-head">
      <p class="pz-kicker">Juego · 4 minutos</p>
      <h1>La pizzería B2B</h1>
    </div>

    <div class="pz-stage" id="pz-stage" role="region" aria-label="Escena de la pizzería en 3D">
      <div class="pz-bocadillo" id="pz-bocadillo" hidden aria-live="polite"></div>

      <div class="pz-hud pz-glass" id="pz-hud" hidden>
        <div class="pz-meter-head">
          <span>Hambre del cliente <span class="pz-muted">· su interés como lead</span></span>
          <span id="pz-meter-value"></span>
        </div>
        <div class="pz-meter-bar"><span id="pz-meter-fill"></span></div>
        <p class="pz-interest" id="pz-interest" hidden></p>
        <p class="pz-impaciencia" id="pz-impaciencia" hidden>Se está impacientando</p>
      </div>

      <div class="pz-card pz-glass" id="pz-card" data-fase="intro">
        <div id="pz-intro">
          <p class="pz-intro">Abre tu pizzería y acompaña a un cliente desde que ve tu anuncio en la calle hasta que pide el postre. Cada momento de la pizzería es una fase del proceso comercial B2B.</p>
          <p class="pz-intro">Cada partida entra un cliente distinto y la situación cambia. Vigila su hambre, porque si llega a cero se levanta y se va.</p>
          <p class="pz-label">Elige el modo</p>
          <div class="pz-niveles pz-modos" id="pz-modos" role="radiogroup" aria-label="Modo de juego"></div>
          <p class="pz-label">Elige el nivel</p>
          <div class="pz-niveles" id="pz-niveles" role="radiogroup" aria-label="Nivel de dificultad"></div>
          <button type="button" class="pz-btn" id="pz-start">Abrir la pizzería</button>
        </div>

        <div id="pz-perfil" hidden>
          <p class="pz-kicker">Hoy entra</p>
          <h2 class="pz-question" id="pz-perfil-nombre"></h2>
          <p class="pz-intro" id="pz-perfil-pizza"></p>
          <p class="pz-lesson"><span class="pz-lesson-label">En B2B</span> <span id="pz-perfil-b2b"></span></p>
          <p class="pz-pista" id="pz-perfil-pista"></p>
          <button type="button" class="pz-btn" id="pz-perfil-ok">Que pase</button>
        </div>

        <div id="pz-play" hidden>
          <div class="pz-progress">
            <span id="pz-step"></span>
            <span class="pz-chips">
              <span class="pz-chip pz-chip--evento" id="pz-evento" hidden></span>
              <span class="pz-chip" id="pz-chip"></span>
            </span>
          </div>
          <h2 class="pz-question" id="pz-question"></h2>
          <div class="pz-options" id="pz-options"></div>
          <div class="pz-feedback" id="pz-feedback" hidden>
            <p class="pz-verdict" id="pz-verdict"></p>
            <p class="pz-lesson"><span class="pz-lesson-label">En B2B</span> <span id="pz-lesson"></span></p>
            <button type="button" class="pz-btn" id="pz-next">Siguiente momento</button>
          </div>
        </div>

        <div id="pz-siguiente" hidden>
          <p class="pz-kicker" id="pz-sig-kicker"></p>
          <h2 class="pz-question" id="pz-sig-titulo"></h2>
          <p class="pz-sig-estrellas" id="pz-sig-estrellas"></p>
          <p class="pz-intro" id="pz-sig-caja"></p>
          <button type="button" class="pz-btn" id="pz-sig-ok">Que pase el siguiente cliente</button>
        </div>

        <div id="pz-closing" hidden>
          <p class="pz-intro">El cliente se dirige a la salida…</p>
        </div>
      </div>
    </div>

    <div class="pz-end" id="pz-end" hidden>
      <p class="pz-kicker">Cierre de caja</p>
      <h2 id="pz-end-title"></h2>
      <p class="pz-estrellas" id="pz-estrellas" aria-live="polite"></p>
      <p class="pz-intro" id="pz-end-b2b"></p>

      <div class="pz-debil" id="pz-debil" hidden>
        <p class="pz-kicker">Tu punto débil</p>
        <p class="pz-debil-titulo" id="pz-debil-titulo"></p>
        <p id="pz-debil-texto"></p>
      </div>

      <div class="pz-end-grid">
        <div class="pz-ticket-col">
          <div class="pz-ticket" aria-label="Ticket de la mesa">
            <p class="pz-ticket-head">La Pizzería<small id="pz-ticket-mesa"></small></p>
            <div class="pz-ticket-lines" id="pz-ticket-lines"></div>
            <div class="pz-ticket-total"><span>Total</span><span id="pz-total"></span></div>
            <p class="pz-ticket-note" id="pz-ticket-note"></p>
            <p class="pz-ticket-thanks">Gracias por tu visita</p>
          </div>
          <div class="pz-share">
            <button type="button" class="pz-btn" id="pz-descargar">Descargar mi ticket</button>
            <button type="button" class="pz-btn pz-btn--ghost" id="pz-compartir" hidden>Compartir</button>
            <a class="pz-link" id="pz-linkedin" target="_blank" rel="noopener noreferrer">Compartir en LinkedIn →</a>
          </div>
        </div>

        <div>
          <h3 id="pz-route-titulo">Tu proceso comercial, momento a momento</h3>
          <ol class="pz-route" id="pz-route"></ol>
        </div>
      </div>

      <div class="pz-cta">
        <p class="pz-cta-title">¿En qué momento se enfrían los clientes de tu empresa?</p>
        <p class="pz-intro">En la pizzería se ve a simple vista. En tu proceso comercial cuesta más. El autodiagnóstico te ayuda a encontrarlo en 3 minutos, y si prefieres, lo vemos juntos en una llamada de 15.</p>
        <div class="pz-actions">
          <a href="/recursos/minijuegos/diagnostico-marketing/" class="pz-btn">Hacer el autodiagnóstico</a>
          <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="pz-btn pz-btn--ghost">Agenda 15 minutos</a>
        </div>
        <a href="/servicios/pipeline/" class="pz-link">Ver el diagnóstico de pipeline y proceso comercial →</a>
      </div>

      <div class="pz-actions">
        <button type="button" class="pz-btn pz-btn--ghost" id="pz-retry" hidden></button>
        <button type="button" class="pz-btn pz-btn--ghost" id="pz-restart">Jugar con otro cliente</button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import type { Momento, Opcion, Calidad, Perfil, Nivel, NivelId, Variante } from '../../../../data/pizzeria';
  import { crearEscena, POS, ALTURAS } from '../../../../scripts/pizzeria3d';

  type Clave = 'recomienda' | 'vuelve' | 'noVuelve' | 'seVa';
  type Desenlace = { titulo: string; b2b: string; estrellas: number };
  const config = JSON.parse(document.getElementById('pz-data')!.textContent!) as {
    momentos: Momento[];
    perfiles: Perfil[];
    niveles: Nivel[];
    desenlaces: Record<Clave, Desenlace>;
    impaciencia: { texto: string; b2b: string };
    umbrales: { vuelve: number; recomienda: number; postre: number };
    precioPizza: number;
    clientesJornada: number;
    jornada: { minimo: number; titulo: string; b2b: string }[];
    url: string;
  };
  const { momentos, perfiles, niveles, desenlaces, impaciencia, umbrales, precioPizza, clientesJornada, jornada, url } = config;

  const $ = (id: string) => document.getElementById(id)!;
  const track = (name: string, params: Record<string, unknown> = {}) => {
    const gtag = (window as any).gtag;
    if (typeof gtag === 'function') gtag('event', name, params);
  };
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const azar = <T,>(lista: T[]) => lista[Math.floor(Math.random() * lista.length)];
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const movil = matchMedia('(max-width: 700px)');

  // Preferencias del jugador en este navegador (si el almacenamiento falla,
  // el juego funciona igual sin recordar nada).
  const leer = <T,>(clave: string, defecto: T): T => {
    try { const v = localStorage.getItem(clave); return v ? (JSON.parse(v) as T) : defecto; } catch { return defecto; }
  };
  const guardar = (clave: string, valor: unknown) => {
    try { localStorage.setItem(clave, JSON.stringify(valor)); } catch { /* sin almacenamiento */ }
  };

  // ── Escena 3D ───────────────────────────────────────────────────────
  const stage = $('pz-stage');
  const card = $('pz-card');
  const escena = crearEscena(stage, $('pz-bocadillo'), {
    reducirMovimiento: reduceMotion,
    // Hueco que ocupa la tarjeta, para encuadrar la acción en la zona libre.
    tarjeta: () => movil.matches
      ? { ancho: 0, alto: stage.clientHeight * 0.5, abajo: true }
      : { ancho: card.offsetWidth + 24, alto: 0, abajo: false },
  });
  escena.foco('intro');

  // ── Estado ──────────────────────────────────────────────────────────
  interface Paso {
    momento: string; texto: string; calidad: Calidad; b2b: string; delta: number;
    escena?: Opcion['escena']; venta?: Opcion['venta'];
  }
  interface Foto { hambre: number; marcas: string[]; historial: Paso[]; interes: string; rotulo: string }
  let nivel: Nivel = niveles.find((n) => n.id === leer<NivelId>('pz-nivel', 'facil')) ?? niveles[0];
  type Modo = 'rapida' | 'jornada';
  let modo: Modo = leer<Modo>('pz-modo', 'rapida') === 'jornada' ? 'jornada' : 'rapida';
  // Resultado de cada cliente atendido en la partida o jornada actual.
  interface Resultado { perfil: Perfil; clave: Clave; estrellas: number; lineas: [string, number][]; total: number; historial: Paso[]; nota: string }
  let resultados: Resultado[] = [];
  let colaPerfiles: Perfil[] = [];
  let perfil: Perfil = perfiles[0];
  // Índice del planteamiento elegido en cada momento para esta partida.
  let plan: number[] = [];
  let hambre = 0;
  let marcas = new Set<string>();
  let historial: Paso[] = [];
  let actual = 0;
  let interes = '';
  let rotulo = '';
  // Estado al empezar cada momento, para poder repetir desde ahí.
  let fotos: Foto[] = [];
  // Cada partida invalida las animaciones pendientes de la anterior.
  let partida = 0;

  const variante = (i = actual): Variante => momentos[i].variantes[plan[i]];

  // Elige un planteamiento por momento compatible con el perfil, con
  // como mucho un imprevisto por partida.
  const elegirPlan = () => {
    const posibles = momentos.map((m) =>
      m.variantes.map((v, i) => ({ v, i })).filter(({ v }) => !v.soloPerfiles || v.soloPerfiles.includes(perfil.id))
    );
    const elegido = posibles.map((lista) => azar(lista).i);
    const conEvento = elegido.map((vi, mi) => (momentos[mi].variantes[vi].evento ? mi : -1)).filter((mi) => mi >= 0);
    // Se queda uno al azar y el resto se cambia por un planteamiento normal.
    const quedarse = azar(conEvento);
    conEvento.filter((mi) => mi !== quedarse).forEach((mi) => {
      elegido[mi] = azar(posibles[mi].filter(({ v }) => !v.evento)).i;
    });
    return elegido;
  };

  // Combina la opción con lo que cambia según decisiones previas y perfil.
  const efectiva = (base: Opcion): Opcion => {
    let o: Opcion = { ...base };
    if (base.siMarca && marcas.has(base.siMarca.marca)) {
      const { marca: _m, ...ajuste } = base.siMarca;
      o = { ...o, ...ajuste };
    }
    const ajustePerfil = base.porPerfil?.[perfil.id];
    if (ajustePerfil) o = { ...o, ...ajustePerfil };
    return o;
  };

  // ── Escena: qué pasa al llegar a cada momento y al elegir ───────────
  const entrar = async (id: string) => {
    const p = partida;
    escena.foco(id);
    if (id === 'puerta') await escena.mover('cliente', POS.puerta[0], POS.puerta[1], { ms: 1300 });
    if (id === 'espera') {
      escena.mostrar('formulario', false);
      await escena.mover('cliente', POS.rodeo[0], POS.rodeo[1], { ms: 1100 });
      if (p !== partida) return;
      await escena.mover('cliente', POS.mesa[0], POS.mesa[1], { ms: 700 });
      if (p === partida) escena.sentar(true);
    }
    if (id === 'pedido') {
      await escena.mover('camarero', POS.mesaCamarero[0], POS.mesaCamarero[1], { ms: 1300 });
      if (p !== partida) return;
      escena.mostrar('libreta', true);
      escena.pose('camarero', 'escribir', 8000);
    }
    if (id === 'servicio') {
      escena.mostrar('libreta', false);
      escena.mostrar('cartaCorta', false);
      escena.mostrar('cartaLarga', false);
      escena.mover('camarero', POS.barra[0], POS.barra[1], { ms: 1300 });
      // En el imprevisto del horno apagado, el fuego no se enciende.
      escena.horno(variante().id !== 'servicio-horno');
    }
    if (id === 'sobremesa') {
      escena.mostrar('pizza', false);
      escena.mostrar('aperitivo', false);
    }
  };

  const servir = async (tarde: boolean, mal: boolean) => {
    const p = partida;
    escena.pizzaMal(mal);
    await escena.mover('pizza', POS.hornoPizza[0], POS.hornoPizza[1], { ms: 0, y: ALTURAS.horno });
    escena.mostrar('pizza', true);
    if (tarde) await wait(1800);
    if (p !== partida) return;
    escena.horno(false);
    await escena.mover('pizza', POS.barraPizza[0], POS.barraPizza[1], { ms: 900, y: ALTURAS.barra });
    if (p !== partida) return;
    await escena.mover('pizza', POS.mesaPizza[0], POS.mesaPizza[1], { ms: 1100, y: ALTURAS.mesa });
    if (p === partida) escena.comer();
  };

  const reaccionar = async (id: string, o: Opcion) => {
    const p = partida;
    const e = new Set(o.escena ?? []);
    if (id === 'calle') {
      escena.rotulo(o.rotulo ?? '');
      escena.gente(o.gente ?? 0);
      await wait(2600);
      if (p === partida) escena.gente(0);
      return;
    }
    if (e.has('formulario')) escena.mostrar('formulario', true);
    if (e.has('aperitivo')) escena.mostrar('aperitivo', true);
    if (e.has('camarero')) escena.mover('camarero', POS.mesaCamarero[0], POS.mesaCamarero[1], { ms: 1300 });
    if (e.has('cartaCorta')) escena.mostrar('cartaCorta', true);
    if (e.has('cartaLarga')) escena.mostrar('cartaLarga', true);
    if (e.has('pizza') || e.has('pizzaTarde') || e.has('pizzaMal')) servir(e.has('pizzaTarde'), e.has('pizzaMal'));
    (['postre', 'cuenta', 'extras', 'caja'] as const).forEach((k) => e.has(k) && escena.mostrar(k, true));
  };

  // ── Interfaz ────────────────────────────────────────────────────────
  const fases = { intro: $('pz-intro'), perfil: $('pz-perfil'), play: $('pz-play'), siguiente: $('pz-siguiente'), closing: $('pz-closing') };
  const fase = (name: keyof typeof fases) => {
    Object.entries(fases).forEach(([k, el]) => (el.hidden = k !== name));
    card.dataset.fase = name;
    $('pz-hud').hidden = name === 'intro' || name === 'perfil' || name === 'siguiente';
    card.scrollTop = 0;
  };

  const MODOS: { id: Modo; nombre: string; descripcion: string }[] = [
    { id: 'rapida', nombre: 'Partida rápida', descripcion: 'Un cliente, unos 4 minutos.' },
    { id: 'jornada', nombre: 'Jornada completa', descripcion: `${clientesJornada} clientes distintos seguidos y la caja del día. Unos 12 minutos.` },
  ];
  const pintarModos = () => {
    $('pz-modos').replaceChildren(...MODOS.map((m) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'pz-nivel' + (m.id === modo ? ' is-on' : '');
      btn.setAttribute('role', 'radio');
      btn.setAttribute('aria-checked', String(m.id === modo));
      btn.innerHTML = '<strong></strong><span></span><small></small>';
      btn.querySelector('strong')!.textContent = m.nombre;
      btn.querySelector('span')!.textContent = m.descripcion;
      btn.addEventListener('click', () => {
        modo = m.id;
        guardar('pz-modo', m.id);
        pintarModos();
        pintarNiveles();
      });
      return btn;
    }));
  };

  // El récord se guarda por modo y nivel (estrellas sobre 3 o sobre 9).
  const claveRecord = () => (modo === 'jornada' ? 'pz-record-jornada' : 'pz-record');
  const maxEstrellas = () => (modo === 'jornada' ? clientesJornada * 3 : 3);
  const records = () => leer<Partial<Record<NivelId, number>>>(claveRecord(), {});
  const pintarNiveles = () => {
    const rec = records();
    $('pz-niveles').replaceChildren(...niveles.map((n) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'pz-nivel' + (n.id === nivel.id ? ' is-on' : '');
      btn.setAttribute('role', 'radio');
      btn.setAttribute('aria-checked', String(n.id === nivel.id));
      const r = rec[n.id];
      btn.innerHTML = '<strong></strong><span></span><small></small>';
      btn.querySelector('strong')!.textContent = n.nombre;
      btn.querySelector('span')!.textContent = n.descripcion;
      btn.querySelector('small')!.textContent = r != null ? `Récord ${r} de ${maxEstrellas()} ★` : '';
      btn.addEventListener('click', () => {
        nivel = n;
        guardar('pz-nivel', n.id);
        pintarNiveles();
      });
      return btn;
    }));
  };
  pintarNiveles();
  pintarModos();

  const renderMeter = () => {
    $('pz-meter-value').textContent = nivel.numero ? String(hambre) : '';
    const fill = $('pz-meter-fill');
    fill.style.width = `${hambre}%`;
    fill.dataset.level = hambre >= 60 ? 'alto' : hambre >= 30 ? 'medio' : 'bajo';
    const el = $('pz-interest');
    el.hidden = !interes;
    const cliente = modo === 'jornada' ? `Cliente ${resultados.length + 1} de ${clientesJornada} · ` : '';
    el.textContent = interes ? `${cliente}${perfil.nombre}. Viene buscando ${interes}.` : '';
  };

  const VEREDICTO: Record<Calidad, string> = {
    bien: 'Le ha gustado',
    regular: 'Se queda a medias',
    mal: 'Se enfría',
  };

  const verdict = (calidad: Calidad, delta: number, primero: boolean) => {
    const el = $('pz-verdict');
    if (!nivel.explicacion) {
      el.dataset.calidad = 'neutral';
      el.textContent = primero ? 'Entra en la pizzería' : 'Decisión tomada';
      return;
    }
    el.dataset.calidad = calidad;
    const cifra = nivel.numero ? ` · hambre ${delta >= 0 ? '+' : ''}${delta}` : '';
    el.textContent = primero
      ? nivel.numero ? `Entra con hambre ${hambre} de 100` : 'Entra en la pizzería'
      : delta === 0 && hambre === 100 && nivel.numero
        ? `${VEREDICTO[calidad]} · hambre al máximo`
        : `${VEREDICTO[calidad]}${cifra}`;
  };

  const leccion = (b2b: string) => {
    ($('pz-feedback').querySelector('.pz-lesson-label') as HTMLElement).hidden = !nivel.explicacion;
    $('pz-lesson').textContent = nivel.explicacion ? b2b : 'La explicación de cada decisión la verás al final de la partida.';
  };

  const barajar = (n: number) => {
    const orden = Array.from({ length: n }, (_, i) => i);
    for (let i = n - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [orden[i], orden[j]] = [orden[j], orden[i]];
    }
    return orden;
  };

  // ── Paciencia del cliente ───────────────────────────────────────────
  let reloj = 0;
  const pararReloj = () => {
    clearInterval(reloj);
    reloj = 0;
    $('pz-impaciencia').hidden = true;
  };
  const arrancarReloj = () => {
    pararReloj();
    const pac = nivel.paciencia;
    if (!pac || actual === 0) return;
    const m = momentos[actual];
    let inicio = performance.now();
    let perdido = 0;
    reloj = window.setInterval(() => {
      // Con la pestaña en segundo plano el cliente no se impacienta.
      if (document.hidden) { inicio += 250; return; }
      const s = (performance.now() - inicio) / 1000;
      if (s < pac.margen) return;
      $('pz-impaciencia').hidden = false;
      const debe = Math.floor((s - pac.margen) / pac.cada) + 1;
      if (debe <= perdido) return;
      if (perdido === 0) {
        escena.decir('¿Falta mucho?');
        escena.emocion('⏰');
      }
      if (perdido % 4 === 0) escena.pose('cliente', 'reloj', 2000);
      hambre = Math.max(0, hambre - (debe - perdido));
      perdido = debe;
      renderMeter();
      escena.humor(hambre);
      if (hambre <= 0) {
        pararReloj();
        historial.push({ momento: m.id, texto: impaciencia.texto, calidad: 'mal', b2b: impaciencia.b2b, delta: 0 });
        terminar(true);
      }
    }, 250);
  };

  // ── Flujo de la partida ─────────────────────────────────────────────
  const renderMomento = () => {
    const m = momentos[actual];
    const v = variante();
    fotos[actual] = { hambre, marcas: [...marcas], historial: [...historial], interes, rotulo };
    $('pz-step').textContent = `Momento ${actual + 1} de ${momentos.length} · ${m.nombre}`;
    $('pz-chip').textContent = `En B2B, ${m.b2b.toLowerCase()}`;
    const evento = $('pz-evento');
    evento.hidden = !v.evento;
    evento.textContent = v.evento ?? '';
    $('pz-question').textContent = v.pregunta;
    $('pz-feedback').hidden = true;
    escena.decir(null);
    card.scrollTop = 0;

    const options = $('pz-options');
    options.replaceChildren();
    options.hidden = false;
    options.classList.remove('is-answered');
    entrar(m.id);

    if (m.automatico && hambre >= nivel.umbralAuto) {
      // El cliente está tan interesado que pide él solo: no hay decisión.
      evento.hidden = true;
      $('pz-question').textContent = m.automatico.texto;
      options.hidden = true;
      historial.push({ momento: m.id, texto: 'Pidió él solo', calidad: 'bien', b2b: m.automatico.b2b, delta: 0 });
      escena.decir(m.automatico.reaccion);
      escena.pose('cliente', 'mano', 2600);
      escena.emocion('🙋');
      escena.mover('camarero', POS.mesaCamarero[0], POS.mesaCamarero[1], { ms: 1300 });
      $('pz-verdict').dataset.calidad = 'bien';
      $('pz-verdict').textContent = 'Pide él solo, ni has tenido que ir';
      leccion(m.automatico.b2b);
      $('pz-next').textContent = 'Siguiente momento';
      $('pz-feedback').hidden = false;
      return;
    }

    barajar(v.opciones.length).forEach((idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'pz-option';
      btn.textContent = v.opciones[idx].texto;
      btn.addEventListener('click', () => elegir(idx, btn));
      options.appendChild(btn);
    });
    arrancarReloj();
  };

  const elegir = (idx: number, btn: HTMLButtonElement) => {
    pararReloj();
    const m = momentos[actual];
    const o = efectiva(variante().opciones[idx]);

    $('pz-options').querySelectorAll('button').forEach((b) => ((b as HTMLButtonElement).disabled = true));
    btn.classList.add('is-selected');
    // Las opciones descartadas se pliegan para que la explicación quepa.
    $('pz-options').classList.add('is-answered');

    const primero = actual === 0;
    const antes = hambre;
    const d = o.delta >= 0 ? Math.round(o.delta * nivel.multSuma) : Math.round(o.delta * nivel.multResta);
    hambre = Math.max(0, Math.min(100, primero ? d : hambre + d));
    if (o.marca) marcas.add(o.marca);
    if (o.interes) interes = o.interes;
    if (o.rotulo) rotulo = o.rotulo;
    historial.push({ momento: m.id, texto: o.texto, calidad: o.calidad, b2b: o.b2b, delta: hambre - antes, escena: o.escena, venta: o.venta });

    renderMeter();
    escena.humor(hambre);
    reaccionar(m.id, o);
    escena.decir(o.reaccion);
    // Lenguaje corporal según cómo le ha sentado la decisión.
    if (o.calidad === 'bien') { escena.gesto('si'); escena.emocion(primero ? '🍕' : '😋'); }
    else if (o.calidad === 'regular') escena.emocion('😐');
    else { escena.gesto('no'); escena.emocion('💢'); }
    verdict(o.calidad, hambre - antes, primero);
    leccion(o.b2b);
    $('pz-next').textContent = hambre <= 0
      ? 'Ver qué pasa'
      : actual === momentos.length - 1 ? 'Cerrar la caja' : 'Siguiente momento';
    const fb = $('pz-feedback');
    fb.hidden = false;
    // Si la explicación no cabe en la tarjeta, baja solo lo justo para verla.
    requestAnimationFrame(() => {
      const sobra = fb.offsetTop + fb.offsetHeight + 16 - (card.scrollTop + card.clientHeight);
      if (sobra > 0) card.scrollBy({ top: sobra, behavior: reduceMotion ? 'auto' : 'smooth' });
    });
    track('pizzeria_momento', { momento: m.id, variante: variante().id, calidad: o.calidad, hambre, perfil: perfil.id, nivel: nivel.id });
  };

  const siguiente = () => {
    if (hambre <= 0) return terminar(true);
    actual++;
    if (actual < momentos.length) renderMomento();
    else terminar(false);
  };

  const euros = (n: number) => `${n.toFixed(2).replace('.', ',')} €`;

  const estrellasTexto = (n: number, max: number) => '★'.repeat(n) + '☆'.repeat(max - n);

  const calcular = (seVa: boolean, clave: Clave): Resultado => {
    // Las ventas adicionales solo se cobran si el cliente sale contento.
    const lineas: [string, number][] = [];
    if (!seVa) {
      lineas.push(['Pizza de la casa', precioPizza]);
      if (hambre >= umbrales.postre) historial.forEach((h) => h.venta && lineas.push([h.venta.concepto, h.venta.precio]));
    }
    const ultimo = historial[historial.length - 1];
    const momentoPerdido = momentos.find((m) => m.id === ultimo?.momento);
    const nota = seVa
      ? `Se fue en ${momentoPerdido?.nombre.toLowerCase()}`
      : clave === 'recomienda' ? 'Reserva para cuatro la semana que viene' : clave === 'vuelve' ? 'Cliente que repite' : 'Primera y última visita';
    return {
      perfil, clave, estrellas: desenlaces[clave].estrellas, lineas,
      total: lineas.reduce((a, [, v]) => a + v, 0), historial: [...historial], nota,
    };
  };

  const terminar = async (seVa: boolean) => {
    const p = partida;
    pararReloj();
    fase('closing');
    const clave: Clave = seVa ? 'seVa' : hambre >= umbrales.recomienda ? 'recomienda' : hambre >= umbrales.vuelve ? 'vuelve' : 'noVuelve';

    escena.decir(seVa ? 'Me voy a otro sitio' : null);
    if (seVa) escena.emocion('💨');
    escena.sentar(false);
    escena.foco('salida');
    await escena.mover('cliente', POS.salida[0], POS.salida[1], { ms: seVa ? 2000 : 2800 });
    if (p !== partida) return;
    escena.decir(null);
    if (clave === 'recomienda') { escena.mostrar('amigos', true); escena.emocion('❤️'); }

    const r = calcular(seVa, clave);
    resultados.push(r);
    track('pizzeria_final', { resultado: clave, estrellas: r.estrellas, hambre, perfil: perfil.id, nivel: nivel.id, modo });
    if (modo === 'jornada' && resultados.length < clientesJornada) return entreClientes(r);
    pintarFinal(seVa);
  };

  // Pausa entre clientes de la jornada con el resultado de la mesa.
  const entreClientes = (r: Resultado) => {
    $('pz-sig-kicker').textContent = `Cliente ${resultados.length} de ${clientesJornada} atendido`;
    $('pz-sig-titulo').textContent = desenlaces[r.clave].titulo;
    $('pz-sig-estrellas').textContent = estrellasTexto(r.estrellas, 3);
    $('pz-sig-caja').textContent = `${r.perfil.nombre}. Caja de esta mesa, ${euros(r.total)}. ${r.nota}.`;
    fase('siguiente');
    card.scrollTop = 0;
  };

  // Momento donde más interés se ha perdido sumando todos los clientes.
  const puntoDebil = () => {
    const perdida = new Map<string, { suma: number; peor?: Paso }>();
    resultados.forEach((r) => r.historial.forEach((h) => {
      if (h.delta >= 0 && h.calidad === 'bien') return;
      const e = perdida.get(h.momento) ?? { suma: 0 };
      e.suma += Math.min(0, h.delta) - (h.calidad === 'mal' ? 10 : h.calidad === 'regular' ? 3 : 0);
      if (!e.peor || h.delta < e.peor.delta) e.peor = h;
      perdida.set(h.momento, e);
    }));
    const lista = [...perdida.entries()].sort((x, y) => x[1].suma - y[1].suma);
    if (!lista.length) return null;
    const [id, v] = lista[0];
    return { id, suma: v.suma, paso: v.peor };
  };

  // Datos del final, también para la imagen del ticket.
  let finalActual: {
    titulo: string; estrellas: number; max: number; lineas: [string, number][];
    total: number; nota: string; cabecera: string; debil: string | null;
  } | null = null;

  const pintarFinal = (seVa: boolean) => {
    const enJornada = modo === 'jornada';
    const ultimo = resultados[resultados.length - 1];
    const suma = resultados.reduce((a, r) => a + r.estrellas, 0);
    const max = maxEstrellas();
    const balance = enJornada ? jornada.find((j) => suma >= j.minimo)! : desenlaces[ultimo.clave];
    $('pz-end-title').textContent = balance.titulo;
    $('pz-end-b2b').textContent = balance.b2b;

    // Estrellas y récord por modo y nivel.
    const rec = records();
    const antes = rec[nivel.id];
    const nuevo = antes == null || suma > antes;
    if (nuevo) guardar(claveRecord(), { ...rec, [nivel.id]: suma });
    const estrellas = $('pz-estrellas');
    estrellas.replaceChildren();
    const icono = document.createElement('span');
    icono.className = 'pz-estrellas-iconos';
    icono.textContent = estrellasTexto(suma, max);
    icono.setAttribute('aria-label', `${suma} de ${max} estrellas`);
    const texto = document.createElement('span');
    const quien = enJornada ? `Jornada de ${clientesJornada} clientes` : ultimo.perfil.nombre;
    texto.textContent = `Nivel ${nivel.nombre.toLowerCase()} · ${quien}${nuevo && antes != null ? ' · ¡Nuevo récord!' : ''}`;
    estrellas.append(icono, texto);

    // Ticket: en la jornada, una línea por mesa.
    const lineas: [string, number][] = enJornada
      ? resultados.map((r, i) => [`Mesa ${i + 1} · ${r.perfil.nombre}`, r.total])
      : ultimo.lineas.length ? ultimo.lineas : [['Sin consumición', 0]];
    const total = lineas.reduce((a, [, v]) => a + v, 0);
    const vuelven = resultados.filter((r) => r.clave === 'recomienda' || r.clave === 'vuelve').length;
    const nota = enJornada ? `${vuelven} de ${clientesJornada} clientes volverán` : ultimo.nota;
    const cabecera = enJornada ? `Jornada · nivel ${nivel.nombre.toLowerCase()}` : `Mesa 1 · ${ultimo.perfil.nombre}`;
    $('pz-ticket-lines').replaceChildren(...lineas.map(([k, v]) => {
      const row = document.createElement('div');
      row.className = 'pz-ticket-line';
      const a = document.createElement('span'); a.textContent = k;
      const b = document.createElement('span'); b.textContent = euros(v);
      row.append(a, b);
      return row;
    }));
    $('pz-total').textContent = euros(total);
    $('pz-ticket-mesa').textContent = cabecera;
    $('pz-ticket-note').textContent = nota;

    // Punto débil.
    const debil = puntoDebil();
    const mDebil = debil && momentos.find((m) => m.id === debil.id);
    $('pz-debil').hidden = !mDebil;
    if (mDebil) {
      $('pz-debil-titulo').textContent = `${mDebil.nombre} · ${mDebil.b2b}`;
      $('pz-debil-texto').textContent = debil.paso?.b2b ?? '';
    }

    // Recorrido. En la jornada se agrupa por momento con un punto por cliente.
    $('pz-route-titulo').textContent = enJornada ? 'Tu proceso comercial con cada cliente' : 'Tu proceso comercial, momento a momento';
    if (enJornada) {
      $('pz-route').replaceChildren(...momentos.map((m) => {
        const pasos = resultados.map((r) => r.historial.find((h) => h.momento === m.id));
        const li = document.createElement('li');
        const head = document.createElement('p');
        head.className = 'pz-route-head';
        pasos.forEach((paso) => {
          const dot = document.createElement('span');
          dot.className = 'pz-dot';
          dot.dataset.calidad = paso?.calidad ?? 'vacio';
          dot.title = paso ? paso.texto : 'Este cliente ya se había ido';
          head.append(dot);
        });
        const nombre = document.createElement('strong'); nombre.textContent = m.nombre;
        const b2b = document.createElement('span'); b2b.className = 'pz-muted'; b2b.textContent = `· ${m.b2b}`;
        head.append(nombre, b2b);
        li.append(head);
        const lecciones = [...new Set(pasos.filter((x) => x && (x.calidad !== 'bien' || !nivel.explicacion)).map((x) => x!.b2b))];
        const txt = document.createElement('p');
        txt.className = lecciones.length ? 'pz-route-b2b' : 'pz-route-text';
        txt.textContent = lecciones.length ? lecciones.join(' ') : 'Bien con todos los clientes.';
        li.append(txt);
        return li;
      }));
    } else {
      $('pz-route').replaceChildren(...ultimo.historial.map((paso) => {
        const m = momentos.find((x) => x.id === paso.momento)!;
        const li = document.createElement('li');
        const head = document.createElement('p');
        head.className = 'pz-route-head';
        head.innerHTML = '<span class="pz-dot"></span><strong></strong> <span class="pz-muted"></span>';
        (head.querySelector('.pz-dot') as HTMLElement).dataset.calidad = paso.calidad;
        head.querySelector('strong')!.textContent = m.nombre;
        head.querySelector('.pz-muted')!.textContent = `· ${m.b2b}`;
        const txt = document.createElement('p');
        txt.className = 'pz-route-text';
        txt.textContent = paso.texto;
        li.append(head, txt);
        if (paso.calidad !== 'bien' || !nivel.explicacion) {
          const b = document.createElement('p');
          b.className = 'pz-route-b2b';
          b.textContent = paso.b2b;
          li.append(b);
        }
        return li;
      }));
    }

    const retry = $('pz-retry') as HTMLButtonElement;
    const ultimoPaso = ultimo.historial[ultimo.historial.length - 1];
    const idxPerdido = momentos.findIndex((m) => m.id === ultimoPaso?.momento);
    retry.hidden = enJornada || !seVa || idxPerdido < 1;
    retry.textContent = idxPerdido >= 0 ? `Repetir desde ${momentos[idxPerdido].nombre.toLowerCase()}` : '';
    retry.dataset.idx = String(idxPerdido);
    $('pz-restart').textContent = enJornada ? 'Empezar otra jornada' : 'Jugar con otro cliente';

    finalActual = {
      titulo: balance.titulo, estrellas: suma, max, lineas, total, nota, cabecera,
      debil: mDebil ? `${mDebil.nombre} (${mDebil.b2b.toLowerCase()})` : null,
    };
    const textoCompartir = `He jugado a La pizzería B2B y he sacado ${suma} de ${max} estrellas. ¿En qué momento se te enfrían los clientes?`;
    ($('pz-linkedin') as HTMLAnchorElement).href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
    $('pz-compartir').hidden = !(navigator.canShare && navigator.canShare({ files: [new File([''], 'x.png', { type: 'image/png' })] }));
    $('pz-compartir').dataset.texto = textoCompartir;

    card.hidden = true;
    $('pz-end').hidden = false;
    $('pz-end').scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    if (enJornada) track('pizzeria_jornada_final', { estrellas: suma, total, nivel: nivel.id });
  };

  // ── Ticket para compartir (imagen 1080x1350, formato vertical de LinkedIn) ─
  const crearImagen = async (): Promise<Blob | null> => {
    if (!finalActual) return null;
    await document.fonts?.ready;
    const f = finalActual;
    const W = 1080;
    const H = 1350;
    const c = document.createElement('canvas');
    c.width = W;
    c.height = H;
    const ctx = c.getContext('2d')!;
    ctx.fillStyle = '#004aad';
    ctx.fillRect(0, 0, W, H);

    // Papel del ticket con borde dentado abajo.
    const x0 = 150;
    const x1 = W - 150;
    const y0 = 120;
    const y1 = 1120;
    ctx.fillStyle = '#fffdf8';
    ctx.beginPath();
    ctx.moveTo(x0, y0);
    ctx.lineTo(x1, y0);
    ctx.lineTo(x1, y1);
    for (let x = x1; x > x0; x -= 30) { ctx.lineTo(x - 15, y1 + 18); ctx.lineTo(x - 30, y1); }
    ctx.closePath();
    ctx.shadowColor = 'rgba(0,0,0,0.25)';
    ctx.shadowBlur = 30;
    ctx.fill();
    ctx.shadowBlur = 0;

    const mono = 'ui-monospace, Menlo, Consolas, monospace';
    const centro = (txt: string, y: number, font: string, color = '#1a1a1a') => {
      ctx.font = font;
      ctx.fillStyle = color;
      ctx.textAlign = 'center';
      ctx.fillText(txt, W / 2, y);
    };
    const linea = (y: number) => {
      ctx.strokeStyle = '#999';
      ctx.setLineDash([10, 8]);
      ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(x0 + 50, y); ctx.lineTo(x1 - 50, y); ctx.stroke();
      ctx.setLineDash([]);
    };
    centro('LA PIZZERÍA B2B', 210, `700 52px ${mono}`);
    centro(f.cabecera, 260, `400 28px ${mono}`, '#666');
    linea(300);
    centro('★'.repeat(f.estrellas) + '☆'.repeat(f.max - f.estrellas), 380, `400 ${f.max > 3 ? 56 : 80}px sans-serif`, '#e8a33d');
    centro(f.titulo, 450, `600 34px Poppins, sans-serif`);
    linea(500);
    let y = 560;
    ctx.font = `400 30px ${mono}`;
    f.lineas.forEach(([k, v]) => {
      ctx.fillStyle = '#1a1a1a';
      ctx.textAlign = 'left';
      ctx.fillText(k.length > 30 ? k.slice(0, 29) + '…' : k, x0 + 60, y);
      ctx.textAlign = 'right';
      ctx.fillText(euros(v), x1 - 60, y);
      y += 50;
    });
    linea(y);
    y += 60;
    ctx.font = `700 38px ${mono}`;
    ctx.textAlign = 'left';
    ctx.fillText('TOTAL', x0 + 60, y);
    ctx.textAlign = 'right';
    ctx.fillText(euros(f.total), x1 - 60, y);
    y += 70;
    centro(f.nota, y, `400 28px ${mono}`, '#444');
    if (f.debil) {
      centro('Mi punto débil', y + 80, `400 26px ${mono}`, '#888');
      centro(f.debil, y + 125, `600 30px Poppins, sans-serif`, '#c8452f');
    }
    centro('Gracias por tu visita', y1 - 40, `400 26px ${mono}`, '#888');

    centro('¿En qué momento se te enfrían los clientes?', 1210, `400 40px Newsreader, serif`, '#ffffff');
    centro(url.replace('https://', '').replace(/\/$/, ''), 1270, `400 26px Poppins, sans-serif`, 'rgba(255,255,255,0.8)');
    return new Promise((res) => c.toBlob((b) => res(b), 'image/png'));
  };

  $('pz-descargar').addEventListener('click', async () => {
    const blob = await crearImagen();
    if (!blob) return;
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'ticket-pizzeria-b2b.png';
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    track('pizzeria_ticket_descarga', { modo });
  });
  $('pz-compartir').addEventListener('click', async (e) => {
    const blob = await crearImagen();
    if (!blob) return;
    const file = new File([blob], 'ticket-pizzeria-b2b.png', { type: 'image/png' });
    try {
      await navigator.share({ files: [file], text: (e.currentTarget as HTMLElement).dataset.texto, url });
      track('pizzeria_ticket_compartir', { modo });
    } catch { /* el usuario cancela */ }
  });
  $('pz-linkedin').addEventListener('click', () => track('pizzeria_ticket_linkedin', { modo }));

  // Partida nueva. En la jornada los clientes salen en orden barajado y
  // sin repetir perfil; `seguir` mantiene la jornada en curso.
  const nuevaPartida = (seguir = false) => {
    partida++;
    pararReloj();
    escena.reset();
    if (!seguir) {
      resultados = [];
      colaPerfiles = barajar(perfiles.length).map((i) => perfiles[i]);
    }
    perfil = modo === 'jornada' ? colaPerfiles[resultados.length % colaPerfiles.length] : azar(perfiles);
    escena.perfil(perfil.id);
    plan = elegirPlan();
    hambre = 0;
    marcas = new Set();
    historial = [];
    interes = '';
    rotulo = '';
    actual = 0;
    fotos = [];
    card.hidden = false;
    $('pz-end').hidden = true;
    const kicker = modo === 'jornada' ? `Cliente ${resultados.length + 1} de ${clientesJornada} · Entra` : 'Hoy entra';
    ($('pz-perfil').querySelector('.pz-kicker') as HTMLElement).textContent = kicker;
    $('pz-perfil-nombre').textContent = perfil.nombre;
    $('pz-perfil-pizza').textContent = perfil.pizza;
    $('pz-perfil-b2b').textContent = perfil.b2b;
    $('pz-perfil-pista').textContent = perfil.pista;
    fase('perfil');
    escena.foco('calle');
    escena.mover('cliente', POS.calle[0], POS.calle[1], { ms: 1800 });
    stage.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: movil.matches ? 'start' : 'center' });
    track('pizzeria_inicio', { perfil: perfil.id, nivel: nivel.id, modo, cliente: resultados.length + 1 });
  };

  const jugar = () => {
    fase('play');
    renderMeter();
    escena.humor(60);
    renderMomento();
  };

  // Repetir desde un momento con el mismo cliente y los mismos planteamientos
  // (solo en la partida rápida).
  const repetir = (desde: number) => {
    const foto = fotos[desde];
    if (!foto) return nuevaPartida();
    partida++;
    pararReloj();
    escena.reset();
    escena.perfil(perfil.id);
    resultados = [];
    hambre = foto.hambre;
    marcas = new Set(foto.marcas);
    historial = [...foto.historial];
    interes = foto.interes;
    rotulo = foto.rotulo;
    actual = desde;
    card.hidden = false;
    $('pz-end').hidden = true;
    fase('play');
    renderMeter();
    escena.humor(hambre);
    if (rotulo) escena.rotulo(rotulo);
    const sitio = desde >= 2 ? POS.mesa : POS.calle;
    escena.mover('cliente', sitio[0], sitio[1], { ms: 0 });
    if (desde >= 2) escena.sentar(true);
    const hecho = (id: string) => historial.find((h) => h.momento === id);
    if (hecho('espera')?.escena?.includes('aperitivo')) escena.mostrar('aperitivo', true);
    const llamada = hecho('llamada');
    const iServicio = momentos.findIndex((m) => m.id === 'servicio');
    if (llamada && (llamada.escena?.includes('camarero') || llamada.texto === 'Pidió él solo') && desde < iServicio) {
      escena.mover('camarero', POS.mesaCamarero[0], POS.mesaCamarero[1], { ms: 0 });
    }
    renderMomento();
    stage.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: movil.matches ? 'start' : 'center' });
    track('pizzeria_repetir', { desde: momentos[desde].id, perfil: perfil.id, nivel: nivel.id });
  };

  $('pz-start').addEventListener('click', () => nuevaPartida());
  $('pz-perfil-ok').addEventListener('click', jugar);
  $('pz-sig-ok').addEventListener('click', () => nuevaPartida(true));
  $('pz-restart').addEventListener('click', () => nuevaPartida());
  $('pz-retry').addEventListener('click', (e) => repetir(Number((e.currentTarget as HTMLElement).dataset.idx)));
  $('pz-next').addEventListener('click', siguiente);
</script>

