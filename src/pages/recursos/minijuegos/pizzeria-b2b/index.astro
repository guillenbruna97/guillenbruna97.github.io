---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {
  BOOKING_URL,
  CONTACT_EMAIL,
  MAILTO_URL,
  SERVICES,
  HUBSPOT_PORTAL_ID,
  HUBSPOT_FORM_ID,
  HUBSPOT_SUBSCRIPTION_TYPE_ID,
  LEAD_TEXTO_PRIVACIDAD,
  LEAD_TEXTO_COMERCIAL,
} from '../../../../consts';
import {
  MOMENTOS,
  PERFILES,
  NIVELES,
  DESENLACES,
  IMPACIENCIA,
  HAMBRE_VUELVE,
  HAMBRE_RECOMIENDA,
  HAMBRE_POSTRE,
  PRECIO_PIZZA,
  CLIENTES_JORNADA,
  JORNADA,
  INFORMES,
} from '../../../../data/pizzeria';

const config = {
  momentos: MOMENTOS,
  perfiles: PERFILES,
  niveles: NIVELES,
  desenlaces: DESENLACES,
  impaciencia: IMPACIENCIA,
  umbrales: { vuelve: HAMBRE_VUELVE, recomienda: HAMBRE_RECOMIENDA, postre: HAMBRE_POSTRE },
  precioPizza: PRECIO_PIZZA,
  clientesJornada: CLIENTES_JORNADA,
  jornada: JORNADA,
  url: 'https://guillenbruna97.github.io/recursos/minijuegos/pizzeria-b2b/',
  informes: INFORMES,
  servicios: Object.fromEntries(SERVICES.map((s) => [s.slug, s.name])),
  hubspot: {
    portalId: HUBSPOT_PORTAL_ID,
    formId: HUBSPOT_FORM_ID,
    subscriptionTypeId: HUBSPOT_SUBSCRIPTION_TYPE_ID,
  },
  textoPrivacidad: LEAD_TEXTO_PRIVACIDAD,
  textoComercial: LEAD_TEXTO_COMERCIAL,
};

const pageUrl = 'https://guillenbruna97.github.io/recursos/minijuegos/pizzeria-b2b/';
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://guillenbruna97.github.io/' },
    { '@type': 'ListItem', position: 2, name: 'Recursos', item: 'https://guillenbruna97.github.io/recursos/' },
    { '@type': 'ListItem', position: 3, name: 'Minijuegos', item: 'https://guillenbruna97.github.io/recursos/minijuegos/' },
    { '@type': 'ListItem', position: 4, name: 'La pizzería B2B', item: pageUrl },
  ],
};
---
<BaseLayout
  title="La pizzería B2B, el juego que te enseña dónde flaquea tu proceso comercial"
  description="Atiende a un cliente en tu pizzería, del cartel de la calle al postre. Cada momento es una fase del proceso comercial B2B y al final ves en cuál flaqueas y qué claves se te escapan."
  image="/images/minijuegos/pizzeria-b2b.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script type="application/json" id="pz-data" set:html={JSON.stringify(config)} />

  <section class="pz">
    <div class="pz-stage" id="pz-stage" role="region" aria-label="Escena de la pizzería en 3D">
      <div class="pz-bocadillo" id="pz-bocadillo" hidden aria-live="polite"></div>

      <div class="pz-hud" id="pz-hud" hidden>
        <div class="pz-meter-head">
          <span>Hambre del cliente <span class="pz-muted">· su interés como lead</span></span>
          <span id="pz-meter-value"></span>
        </div>
        <div class="pz-meter-bar" id="pz-meter-bar"><span id="pz-meter-fill"></span></div>
        <p class="pz-impaciencia" id="pz-impaciencia" hidden>Se está impacientando</p>
      </div>

      <!-- Explicación de la última decisión, al lado de la tarjeta de preguntas. -->
      <aside class="pz-explica pz-glass" id="pz-explica" hidden aria-live="polite">
        <button type="button" class="pz-explica-cerrar" id="pz-explica-cerrar" aria-label="Cerrar la explicación">×</button>
        <p class="pz-verdict" id="pz-verdict"></p>
        <p class="pz-lesson"><span class="pz-lesson-label">En B2B</span> <span id="pz-lesson"></span></p>
      </aside>

      <div class="pz-card pz-glass" id="pz-card" data-fase="intro">
        <!-- Inicio en dos pantallas: modo y luego dificultad. Al elegir la
             dificultad empieza la partida. -->
        <div id="pz-intro">
          <p class="pz-paso">Paso 1 de 2</p>
          <h2 class="pz-question">¿Cuánto tiempo tienes?</h2>
          <p class="pz-intro">Atiende a un cliente desde el cartel de la calle hasta el postre. Cada momento es una fase de tu proceso comercial B2B y al final verás en cuál flaqueas.</p>
          <div class="pz-niveles pz-modos" id="pz-modos" aria-label="Modo de juego"></div>
        </div>

        <div id="pz-dificultad" hidden>
          <p class="pz-paso">Paso 2 de 2</p>
          <h2 class="pz-question">¿Qué nivel quieres?</h2>
          <p class="pz-intro">El hambre del cliente es su interés en comprarte. Si llega a cero, se levanta y se va.</p>
          <div class="pz-niveles" id="pz-niveles" aria-label="Nivel de dificultad"></div>
          <button type="button" class="pz-volver" id="pz-volver-modo">← Cambiar de modo</button>
        </div>

        <div id="pz-perfil" hidden>
          <p class="pz-kicker">Hoy entra</p>
          <h2 class="pz-question" id="pz-perfil-nombre"></h2>
          <p class="pz-intro" id="pz-perfil-pizza"></p>
          <p class="pz-lesson"><span class="pz-lesson-label">En B2B</span> <span id="pz-perfil-b2b"></span></p>
          <p class="pz-pista" id="pz-perfil-pista"></p>
          <button type="button" class="pz-btn" id="pz-perfil-ok">Que pase</button>
        </div>

        <div id="pz-play" hidden>
          <div class="pz-progress">
            <span id="pz-step"></span>
            <span class="pz-chips">
              <span class="pz-chip pz-chip--evento" id="pz-evento" hidden></span>
              <span class="pz-chip" id="pz-chip"></span>
            </span>
          </div>
          <h2 class="pz-question" id="pz-question"></h2>
          <div class="pz-options" id="pz-options"></div>
        </div>

        <div id="pz-siguiente" hidden>
          <p class="pz-kicker" id="pz-sig-kicker"></p>
          <h2 class="pz-question" id="pz-sig-titulo"></h2>
          <p class="pz-sig-estrellas" id="pz-sig-estrellas"></p>
          <p class="pz-intro" id="pz-sig-caja"></p>
          <button type="button" class="pz-btn" id="pz-sig-ok">Que pase el siguiente cliente</button>
        </div>

        <div id="pz-closing" hidden>
          <p class="pz-intro">El cliente se dirige a la salida…</p>
        </div>
      </div>
    </div>

    <div class="pz-head" id="pz-head">
      <p class="pz-kicker">Juego · 4 minutos</p>
      <h1>La pizzería B2B</h1>
      <p class="pz-sub">El juego que te ayuda a ver en qué fase de tu proceso comercial flaqueas y qué claves no estás viendo.</p>
    </div>

    <div class="pz-end" id="pz-end" hidden>
      <p class="pz-estrellas" id="pz-estrellas" aria-live="polite"></p>

      <div class="pz-debil" id="pz-debil" hidden>
        <p class="pz-kicker">La fase donde más flaqueas</p>
        <p class="pz-debil-titulo" id="pz-debil-titulo"></p>
        <p id="pz-debil-texto"></p>
      </div>

      <div class="pz-informe-bloque">
        <div id="pz-lead">
          <p class="pz-kicker">Informe gratuito</p>
          <h3 class="pz-informe-titulo">Tus puntos fuertes y débiles, y qué hacer con ellos</h3>
          <p class="pz-intro">Ya sabes dónde más flaqueas. El informe te explica por qué, fase a fase y por orden de prioridad, qué haces bien y tres acciones para empezar esta semana. Lo ves al momento en esta misma página.</p>
          <form id="pz-lead-form" class="pz-form" novalidate>
            <div class="pz-field">
              <label for="pz-f-nombre">Nombre</label>
              <input id="pz-f-nombre" name="nombre" type="text" autocomplete="given-name" required />
            </div>
            <div class="pz-field">
              <label for="pz-f-empresa">Empresa</label>
              <input id="pz-f-empresa" name="empresa" type="text" autocomplete="organization" required />
            </div>
            <div class="pz-field pz-field--ancho">
              <label for="pz-f-email">Email</label>
              <input id="pz-f-email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="pz-honeypot" aria-hidden="true">
              <label for="pz-f-web">No rellenes este campo</label>
              <input id="pz-f-web" name="web" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <label class="pz-check">
              <input type="checkbox" name="privacidad" required />
              <span>He leído y acepto la <a href="/privacidad/" target="_blank" rel="noopener">política de privacidad</a>.</span>
            </label>
            <label class="pz-check">
              <input type="checkbox" name="comercial" />
              <span>{LEAD_TEXTO_COMERCIAL}</span>
            </label>
            <p class="pz-error" id="pz-lead-error" hidden></p>
            <button type="submit" class="pz-btn" id="pz-lead-submit">Ver mi informe</button>
            <p class="pz-legal">El responsable de tus datos es Guillén Bruna Tricas. Los uso para enseñarte el informe y contactarte sobre él y, solo si lo marcas, para enviarte comunicaciones comerciales. La base legal es tu consentimiento. Se guardan en HubSpot, el CRM que uso como proveedor. Puedes acceder, rectificar o suprimir tus datos escribiendo a <a href={MAILTO_URL}>{CONTACT_EMAIL}</a>. Tienes toda la información en la <a href="/privacidad/" target="_blank" rel="noopener">política de privacidad</a>.</p>
          </form>
        </div>

        <div id="pz-informe" hidden>
          <p class="pz-kicker">Tu informe</p>
          <h3 class="pz-informe-titulo" id="pz-inf-titulo"></h3>
          <p class="pz-inf-diag" id="pz-inf-resumen"></p>
          <div id="pz-inf-fases"></div>
          <p class="pz-inf-fuertes" id="pz-inf-fuertes" hidden></p>
          <p class="pz-inf-servicio" id="pz-inf-servicio"></p>
          <a class="pz-link" id="pz-inf-link" href="/servicios/pipeline/">Ver el servicio →</a>
        </div>
      </div>

      <div class="pz-end-grid">
        <div class="pz-ticket-col">
          <div class="pz-ticket" aria-label="Ticket de la mesa">
            <p class="pz-ticket-head">La Pizzería<small id="pz-ticket-mesa"></small></p>
            <div class="pz-ticket-lines" id="pz-ticket-lines"></div>
            <div class="pz-ticket-total"><span>Total</span><span id="pz-total"></span></div>
            <p class="pz-ticket-note" id="pz-ticket-note"></p>
            <p class="pz-ticket-thanks">Gracias por tu visita</p>
          </div>
          <div class="pz-share">
            <button type="button" class="pz-btn" id="pz-descargar">Descargar mi ticket</button>
            <button type="button" class="pz-btn pz-btn--ghost" id="pz-compartir" hidden>Compartir</button>
            <a class="pz-link" id="pz-linkedin" target="_blank" rel="noopener noreferrer">Compartir en LinkedIn →</a>
          </div>
        </div>

        <!-- Plegado en móvil para no alargar la pantalla; abierto en escritorio. -->
        <details class="pz-fases" id="pz-fases">
          <summary id="pz-route-titulo">Tu proceso comercial, fase a fase</summary>
          <ol class="pz-route" id="pz-route"></ol>
          <p class="pz-route-nota" id="pz-route-nota"><strong>Por qué falló cada decisión y la clave de cada fase están en tu informe.</strong> <a href="#pz-lead" class="pz-link">Conseguir mi informe ↑</a></p>
        </details>
      </div>

      <div class="pz-cta">
        <p class="pz-cta-title">¿Y qué hay detrás de lo que notas en tus ventas?</p>
        <p class="pz-intro">La pizzería te enseña dónde se enfrían los clientes. El autodiagnóstico mira tu empresa real, lo que notas en las ventas y qué lo provoca, y te da tus tres primeros pasos en 3 minutos. Si lo prefieres, lo vemos juntos en una llamada de 15.</p>
        <div class="pz-actions">
          <a href="/recursos/minijuegos/diagnostico-marketing/" class="pz-btn">Hacer el autodiagnóstico</a>
          <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="pz-btn pz-btn--ghost">Agenda 15 minutos</a>
        </div>
        <a href="/servicios/pipeline/" class="pz-link">Ver el diagnóstico de pipeline y proceso comercial →</a>
      </div>

      <div class="pz-actions">
        <button type="button" class="pz-btn pz-btn--ghost" id="pz-retry" hidden></button>
        <button type="button" class="pz-btn pz-btn--ghost" id="pz-restart">Jugar con otro cliente</button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import type { Momento, Opcion, Calidad, Perfil, Nivel, NivelId, Variante } from '../../../../data/pizzeria';
  import { crearEscena, POS, ALTURAS } from '../../../../scripts/pizzeria3d';

  type Clave = 'recomienda' | 'vuelve' | 'noVuelve' | 'seVa';
  type Desenlace = { titulo: string; b2b: string; estrellas: number };
  const config = JSON.parse(document.getElementById('pz-data')!.textContent!) as {
    momentos: Momento[];
    perfiles: Perfil[];
    niveles: Nivel[];
    desenlaces: Record<Clave, Desenlace>;
    impaciencia: { texto: string; b2b: string };
    umbrales: { vuelve: number; recomienda: number; postre: number };
    precioPizza: number;
    clientesJornada: number;
    jornada: { minimo: number; titulo: string; b2b: string }[];
    url: string;
    informes: Record<string, { titulo: string; diagnostico: string; pasos: string[]; servicio: string }>;
    servicios: Record<string, string>;
    hubspot: { portalId: string; formId: string; subscriptionTypeId: string };
    textoPrivacidad: string;
    textoComercial: string;
  };
  const { momentos, perfiles, niveles, desenlaces, impaciencia, umbrales, precioPizza, clientesJornada, jornada, url, informes, servicios, hubspot } = config;

  const $ = (id: string) => document.getElementById(id)!;
  const track = (name: string, params: Record<string, unknown> = {}) => {
    const gtag = (window as any).gtag;
    if (typeof gtag === 'function') gtag('event', name, params);
  };
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const azar = <T,>(lista: T[]) => lista[Math.floor(Math.random() * lista.length)];
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const movil = matchMedia('(max-width: 700px)');

  // Preferencias del jugador en este navegador (si el almacenamiento falla,
  // el juego funciona igual sin recordar nada).
  const leer = <T,>(clave: string, defecto: T): T => {
    try { const v = localStorage.getItem(clave); return v ? (JSON.parse(v) as T) : defecto; } catch { return defecto; }
  };
  const guardar = (clave: string, valor: unknown) => {
    try { localStorage.setItem(clave, JSON.stringify(valor)); } catch { /* sin almacenamiento */ }
  };

  // ── Escena 3D ───────────────────────────────────────────────────────
  const stage = $('pz-stage');
  const card = $('pz-card');
  const escena = crearEscena(stage, $('pz-bocadillo'), {
    reducirMovimiento: reduceMotion,
    // Hueco que ocupa la tarjeta, para encuadrar la acción en la zona libre.
    tarjeta: () => movil.matches
      ? { ancho: 0, alto: stage.clientHeight * 0.5, abajo: true }
      : { ancho: card.offsetWidth + 24, alto: 0, abajo: false },
  });
  escena.foco('intro');

  // ── Estado ──────────────────────────────────────────────────────────
  interface Paso {
    momento: string; texto: string; calidad: Calidad; b2b: string; delta: number;
    escena?: Opcion['escena']; venta?: Opcion['venta'];
  }
  interface Foto { hambre: number; marcas: string[]; historial: Paso[]; interes: string; rotulo: string }
  let nivel: Nivel = niveles.find((n) => n.id === leer<NivelId>('pz-nivel', 'facil')) ?? niveles[0];
  type Modo = 'rapida' | 'jornada';
  let modo: Modo = leer<Modo>('pz-modo', 'rapida') === 'jornada' ? 'jornada' : 'rapida';
  // Resultado de cada cliente atendido en la partida o jornada actual.
  interface Resultado { perfil: Perfil; clave: Clave; estrellas: number; lineas: [string, number][]; total: number; historial: Paso[]; nota: string }
  let resultados: Resultado[] = [];
  let colaPerfiles: Perfil[] = [];
  let perfil: Perfil = perfiles[0];
  // Índice del planteamiento elegido en cada momento para esta partida.
  let plan: number[] = [];
  let hambre = 0;
  let marcas = new Set<string>();
  let historial: Paso[] = [];
  let actual = 0;
  let interes = '';
  let rotulo = '';
  // Estado al empezar cada momento, para poder repetir desde ahí.
  let fotos: Foto[] = [];
  // Cada partida invalida las animaciones pendientes de la anterior.
  let partida = 0;

  const variante = (i = actual): Variante => momentos[i].variantes[plan[i]];

  // Planteamientos que el jugador ha visto en sus últimas partidas. Al
  // elegir se descartan mientras queden otros, para que cada partida traiga
  // situaciones nuevas.
  const VISTAS_MAX = 40;
  let vistas = leer<string[]>('pz-vistas', []);

  // Elige un planteamiento por momento compatible con el perfil, con
  // como mucho un imprevisto por partida.
  const elegirPlan = () => {
    const validas = momentos.map((m) =>
      m.variantes.map((v, i) => ({ v, i })).filter(({ v }) => !v.soloPerfiles || v.soloPerfiles.includes(perfil.id))
    );
    const preferir = (lista: { v: Variante; i: number }[]) => {
      const nuevas = lista.filter(({ v }) => !vistas.includes(v.id));
      return azar(nuevas.length ? nuevas : lista).i;
    };
    const elegido = validas.map(preferir);
    const conEvento = elegido.map((vi, mi) => (momentos[mi].variantes[vi].evento ? mi : -1)).filter((mi) => mi >= 0);
    // Se queda uno al azar y el resto se cambia por un planteamiento normal.
    const quedarse = azar(conEvento);
    conEvento.filter((mi) => mi !== quedarse).forEach((mi) => {
      elegido[mi] = preferir(validas[mi].filter(({ v }) => !v.evento));
    });
    const ids = elegido.map((vi, mi) => momentos[mi].variantes[vi].id);
    vistas = [...ids, ...vistas.filter((id) => !ids.includes(id))].slice(0, VISTAS_MAX);
    guardar('pz-vistas', vistas);
    return elegido;
  };

  // Combina la opción con lo que cambia según decisiones previas y perfil.
  const efectiva = (base: Opcion): Opcion => {
    let o: Opcion = { ...base };
    if (base.siMarca && marcas.has(base.siMarca.marca)) {
      const { marca: _m, ...ajuste } = base.siMarca;
      o = { ...o, ...ajuste };
    }
    const ajustePerfil = base.porPerfil?.[perfil.id];
    if (ajustePerfil) o = { ...o, ...ajustePerfil };
    return o;
  };

  // ── Escena: qué pasa al llegar a cada momento y al elegir ───────────
  const entrar = async (id: string) => {
    const p = partida;
    escena.foco(id);
    if (id === 'puerta') await escena.mover('cliente', POS.puerta[0], POS.puerta[1], { ms: 1300 });
    if (id === 'espera') {
      escena.mostrar('formulario', false);
      await escena.mover('cliente', POS.rodeo[0], POS.rodeo[1], { ms: 1100 });
      if (p !== partida) return;
      await escena.mover('cliente', POS.mesa[0], POS.mesa[1], { ms: 700 });
      if (p === partida) escena.sentar(true);
    }
    if (id === 'pedido') {
      await escena.mover('camarero', POS.mesaCamarero[0], POS.mesaCamarero[1], { ms: 1300 });
      if (p !== partida) return;
      escena.mostrar('libreta', true);
      escena.pose('camarero', 'escribir', 8000);
    }
    if (id === 'servicio') {
      escena.mostrar('libreta', false);
      escena.mostrar('cartaCorta', false);
      escena.mostrar('cartaLarga', false);
      escena.mover('camarero', POS.barra[0], POS.barra[1], { ms: 1300 });
      // En el imprevisto del horno apagado, el fuego no se enciende.
      escena.horno(variante().id !== 'servicio-horno');
    }
    // La pizza se queda en la mesa: como la partida avanza sola, el
    // cliente puede estar terminándosela al empezar la sobremesa.
    if (id === 'sobremesa') escena.mostrar('aperitivo', false);
  };

  const servir = async (tarde: boolean, mal: boolean) => {
    const p = partida;
    escena.pizzaMal(mal);
    await escena.mover('pizza', POS.hornoPizza[0], POS.hornoPizza[1], { ms: 0, y: ALTURAS.horno });
    escena.mostrar('pizza', true);
    if (tarde) await wait(1800);
    if (p !== partida) return;
    escena.horno(false);
    await escena.mover('pizza', POS.barraPizza[0], POS.barraPizza[1], { ms: 900, y: ALTURAS.barra });
    if (p !== partida) return;
    await escena.mover('pizza', POS.mesaPizza[0], POS.mesaPizza[1], { ms: 1100, y: ALTURAS.mesa });
    if (p === partida) escena.comer();
  };

  const reaccionar = async (id: string, o: Opcion) => {
    const p = partida;
    const e = new Set(o.escena ?? []);
    if (id === 'calle') {
      escena.rotulo(o.rotulo ?? '');
      escena.gente(o.gente ?? 0);
      await wait(2600);
      if (p === partida) escena.gente(0);
      return;
    }
    if (e.has('formulario')) escena.mostrar('formulario', true);
    if (e.has('aperitivo')) escena.mostrar('aperitivo', true);
    if (e.has('camarero')) escena.mover('camarero', POS.mesaCamarero[0], POS.mesaCamarero[1], { ms: 1300 });
    if (e.has('cartaCorta')) escena.mostrar('cartaCorta', true);
    if (e.has('cartaLarga')) escena.mostrar('cartaLarga', true);
    if (e.has('pizza') || e.has('pizzaTarde') || e.has('pizzaMal')) servir(e.has('pizzaTarde'), e.has('pizzaMal'));
    (['postre', 'cuenta', 'extras', 'caja'] as const).forEach((k) => e.has(k) && escena.mostrar(k, true));
  };

  // ── Interfaz ────────────────────────────────────────────────────────
  const fases = { intro: $('pz-intro'), dificultad: $('pz-dificultad'), perfil: $('pz-perfil'), play: $('pz-play'), siguiente: $('pz-siguiente'), closing: $('pz-closing') };
  const fase = (name: keyof typeof fases) => {
    Object.entries(fases).forEach(([k, el]) => (el.hidden = k !== name));
    card.dataset.fase = name;
    $('pz-hud').hidden = name === 'intro' || name === 'dificultad' || name === 'perfil' || name === 'siguiente';
    if (name !== 'play' && name !== 'closing') $('pz-explica').hidden = true;
    card.scrollTop = 0;
  };

  const MODOS: { id: Modo; nombre: string; descripcion: string }[] = [
    { id: 'rapida', nombre: 'Un cliente', descripcion: 'Unos 4 minutos. Te toca un cliente al azar.' },
    { id: 'jornada', nombre: 'Tres clientes seguidos', descripcion: 'Unos 12 minutos. Tres clientes distintos y la cuenta del día.' },
  ];
  const pintarModos = () => {
    $('pz-modos').replaceChildren(...MODOS.map((m) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'pz-nivel pz-eleccion';
      btn.innerHTML = '<strong></strong><span></span><small></small>';
      btn.querySelector('strong')!.textContent = m.nombre;
      btn.querySelector('span')!.textContent = m.descripcion;
      btn.addEventListener('click', () => {
        modo = m.id;
        guardar('pz-modo', m.id);
        pintarNiveles();
        fase('dificultad');
        track('pizzeria_modo', { modo });
      });
      return btn;
    }));
  };

  // Estrellas de 0 a 5 según cuántas de las fases se resolvieron bien. Con
  // varios clientes, la media. El récord se guarda por modo y nivel.
  const ESTRELLAS = 5;
  const estrellasDe = (h: Paso[]) => Math.round((h.filter((x) => x.calidad === 'bien').length / momentos.length) * ESTRELLAS);
  const claveRecord = () => (modo === 'jornada' ? 'pz-record5-tres' : 'pz-record5');
  const maxEstrellas = () => ESTRELLAS;
  const records = () => leer<Partial<Record<NivelId, number>>>(claveRecord(), {});
  const pintarNiveles = () => {
    const rec = records();
    $('pz-niveles').replaceChildren(...niveles.map((n) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'pz-nivel pz-eleccion';
      const r = rec[n.id];
      btn.innerHTML = '<strong></strong><span></span><small></small>';
      btn.querySelector('strong')!.textContent = n.nombre;
      btn.querySelector('span')!.textContent = n.descripcion;
      btn.querySelector('small')!.textContent = r != null ? `Récord ${r} de ${maxEstrellas()} ★` : '';
      btn.addEventListener('click', () => {
        nivel = n;
        guardar('pz-nivel', n.id);
        nuevaPartida();
      });
      return btn;
    }));
  };
  pintarNiveles();
  pintarModos();

  const renderMeter = () => {
    $('pz-meter-value').textContent = nivel.numero ? String(hambre) : '';
    const fill = $('pz-meter-fill');
    fill.style.width = `${hambre}%`;
    fill.dataset.level = hambre >= 60 ? 'alto' : hambre >= 30 ? 'medio' : 'bajo';
  };
  // Latido de la barra al cambiar el hambre, verde si sube y rojo si baja.
  const latido = (delta: number) => {
    const bar = $('pz-meter-bar');
    bar.classList.remove('is-sube', 'is-baja');
    void bar.offsetWidth;
    if (delta) bar.classList.add(delta > 0 ? 'is-sube' : 'is-baja');
  };

  const VEREDICTO: Record<Calidad, string> = {
    bien: 'Le ha gustado',
    regular: 'Se queda a medias',
    mal: 'Se enfría',
  };

  const verdict = (calidad: Calidad, delta: number, primero: boolean) => {
    const el = $('pz-verdict');
    if (!nivel.explicacion) {
      el.dataset.calidad = 'neutral';
      el.textContent = primero ? 'Entra en la pizzería' : 'Decisión tomada';
      return;
    }
    el.dataset.calidad = calidad;
    el.textContent = primero ? 'Entra en la pizzería' : VEREDICTO[calidad];
  };
  // Lo que sube sobre la cabeza del cliente al responder.
  const flotante = (calidad: Calidad, delta: number, primero: boolean) => {
    if (!nivel.explicacion) return;
    const texto = nivel.numero
      ? primero ? `Hambre ${hambre}` : delta === 0 ? '±0' : `${delta > 0 ? '+' : '−'}${Math.abs(delta)}`
      : primero ? 'Entra' : VEREDICTO[calidad];
    escena.flotar(texto, calidad);
  };
  // Primera frase de la explicación: durante la partida basta con la idea
  // principal. La explicación completa está en el informe.
  const primeraFrase = (texto: string) => {
    const [a, b] = texto.split(/(?<=\.)\s/);
    return a.length < 70 && b ? `${a} ${b}` : a;
  };

  const leccion = (b2b: string) => {
    ($('pz-explica').querySelector('.pz-lesson-label') as HTMLElement).hidden = !nivel.explicacion;
    $('pz-lesson').textContent = primeraFrase(b2b);
  };

  // La explicación sale en su propia tarjeta y la partida sigue sola: no
  // hace falta pulsar "siguiente". Se queda a la vista hasta la próxima
  // respuesta (o hasta que se cierra).
  let turnoExplica = 0;
  // En móvil la explicación va pegada encima de la tarjeta de preguntas,
  // para no tapar al cliente, que queda en la parte de arriba de la escena.
  const colocarExplica = () => {
    $('pz-explica').style.bottom = movil.matches ? `${card.offsetHeight + 18}px` : '';
  };
  const explicar = () => {
    const ex = $('pz-explica');
    colocarExplica();
    if (!nivel.explicacion) { ex.hidden = true; return; }
    ex.dataset.calidad = $('pz-verdict').dataset.calidad ?? '';
    ex.hidden = false;
    ex.classList.remove('is-nueva', 'is-abierta');
    void ex.offsetWidth;
    ex.classList.add('is-nueva');
    // Se retira sola para devolver la vista a la escena.
    const turno = ++turnoExplica;
    setTimeout(() => turno === turnoExplica && !ex.classList.contains('is-abierta') && (ex.hidden = true), 7000);
  };
  $('pz-explica-cerrar').addEventListener('click', (e) => {
    e.stopPropagation();
    $('pz-explica').hidden = true;
  });
  // En móvil la explicación sale resumida y se despliega al tocarla.
  $('pz-explica').addEventListener('click', () => $('pz-explica').classList.toggle('is-abierta'));

  // Tiempo para ver la respuesta marcada y la reacción antes de pasar.
  const AVANCE_MS = 1400;
  const AVANCE_AUTO_MS = 2600;
  const avanzar = async (ms: number) => {
    const p = partida;
    await wait(ms);
    if (p === partida) siguiente();
  };

  // El bocadillo del cliente se borra solo al cabo de un rato, aunque ya
  // se esté en la siguiente pregunta.
  let turnoBocadillo = 0;
  const hablar = (texto: string) => {
    const turno = ++turnoBocadillo;
    escena.decir(texto);
    setTimeout(() => turno === turnoBocadillo && escena.decir(null), 3600);
  };

  const barajar = (n: number) => {
    const orden = Array.from({ length: n }, (_, i) => i);
    for (let i = n - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [orden[i], orden[j]] = [orden[j], orden[i]];
    }
    return orden;
  };

  // ── Paciencia del cliente ───────────────────────────────────────────
  let reloj = 0;
  const pararReloj = () => {
    clearInterval(reloj);
    reloj = 0;
    $('pz-impaciencia').hidden = true;
  };
  const arrancarReloj = () => {
    pararReloj();
    const pac = nivel.paciencia;
    if (!pac || actual === 0) return;
    const m = momentos[actual];
    let inicio = performance.now();
    let perdido = 0;
    reloj = window.setInterval(() => {
      // Con la pestaña en segundo plano el cliente no se impacienta.
      if (document.hidden) { inicio += 250; return; }
      const s = (performance.now() - inicio) / 1000;
      if (s < pac.margen) return;
      $('pz-impaciencia').hidden = false;
      const debe = Math.floor((s - pac.margen) / pac.cada) + 1;
      if (debe <= perdido) return;
      if (perdido === 0) {
        escena.decir('¿Falta mucho?');
        escena.emocion('⏰');
      }
      if (perdido % 4 === 0) escena.pose('cliente', 'reloj', 2000);
      hambre = Math.max(0, hambre - (debe - perdido));
      perdido = debe;
      renderMeter();
      escena.humor(hambre);
      if (hambre <= 0) {
        pararReloj();
        historial.push({ momento: m.id, texto: impaciencia.texto, calidad: 'mal', b2b: impaciencia.b2b, delta: 0 });
        terminar(true);
      }
    }, 250);
  };

  // ── Flujo de la partida ─────────────────────────────────────────────
  const renderMomento = () => {
    const m = momentos[actual];
    const v = variante();
    fotos[actual] = { hambre, marcas: [...marcas], historial: [...historial], interes, rotulo };
    $('pz-step').textContent = `${actual + 1}/${momentos.length} · ${m.nombre}`;
    $('pz-chip').textContent = m.b2b;
    const evento = $('pz-evento');
    evento.hidden = !v.evento;
    evento.textContent = v.evento ?? '';
    $('pz-question').textContent = v.pregunta;
    card.scrollTop = 0;

    const options = $('pz-options');
    options.replaceChildren();
    options.hidden = false;
    options.classList.remove('is-answered');
    entrar(m.id);

    if (m.automatico && hambre >= nivel.umbralAuto) {
      // El cliente está tan interesado que pide él solo: no hay decisión.
      evento.hidden = true;
      $('pz-question').textContent = m.automatico.texto;
      options.hidden = true;
      historial.push({ momento: m.id, texto: 'Pidió él solo', calidad: 'bien', b2b: m.automatico.b2b, delta: 0 });
      hablar(m.automatico.reaccion);
      escena.pose('cliente', 'mano', 2600);
      escena.emocion('🙋');
      escena.mover('camarero', POS.mesaCamarero[0], POS.mesaCamarero[1], { ms: 1300 });
      $('pz-verdict').dataset.calidad = 'bien';
      $('pz-verdict').textContent = 'Pide él solo, ni has tenido que ir';
      leccion(m.automatico.b2b);
      escena.primerPlano();
      if (nivel.explicacion) escena.flotar('¡Me llama!', 'bien');
      explicar();
      avanzar(AVANCE_AUTO_MS);
      return;
    }

    barajar(v.opciones.length).forEach((idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'pz-option';
      btn.textContent = v.opciones[idx].texto;
      btn.addEventListener('click', () => elegir(idx, btn));
      options.appendChild(btn);
    });
    colocarExplica();
    arrancarReloj();
  };

  const elegir = (idx: number, btn: HTMLButtonElement) => {
    pararReloj();
    const m = momentos[actual];
    const o = efectiva(variante().opciones[idx]);

    $('pz-options').querySelectorAll('button').forEach((b) => ((b as HTMLButtonElement).disabled = true));
    btn.classList.add('is-selected');
    $('pz-options').classList.add('is-answered');

    const primero = actual === 0;
    const antes = hambre;
    const d = o.delta >= 0 ? Math.round(o.delta * nivel.multSuma) : Math.round(o.delta * nivel.multResta);
    hambre = Math.max(0, Math.min(100, primero ? d : hambre + d));
    if (o.marca) marcas.add(o.marca);
    if (o.interes) interes = o.interes;
    if (o.rotulo) rotulo = o.rotulo;
    historial.push({ momento: m.id, texto: o.texto, calidad: o.calidad, b2b: o.b2b, delta: hambre - antes, escena: o.escena, venta: o.venta });

    renderMeter();
    escena.humor(hambre);
    reaccionar(m.id, o);
    hablar(o.reaccion);
    // Lenguaje corporal según cómo le ha sentado la decisión.
    if (o.calidad === 'bien') { escena.gesto('si'); escena.emocion(primero ? '🍕' : '😋'); }
    else if (o.calidad === 'regular') escena.emocion('😐');
    else { escena.gesto('no'); escena.emocion('💢'); escena.pose('cliente', 'cruzado', 1800); }
    // La cámara se acerca al cliente y su hambre sube o baja a la vista.
    if (!primero) escena.primerPlano();
    flotante(o.calidad, hambre - antes, primero);
    latido(primero ? 0 : hambre - antes);
    verdict(o.calidad, hambre - antes, primero);
    leccion(o.b2b);
    explicar();
    avanzar(AVANCE_MS);
    track('pizzeria_momento', { momento: m.id, variante: variante().id, calidad: o.calidad, hambre, perfil: perfil.id, nivel: nivel.id });
  };

  const siguiente = () => {
    if (hambre <= 0) return terminar(true);
    actual++;
    if (actual < momentos.length) renderMomento();
    else terminar(false);
  };

  const euros = (n: number) => `${n.toFixed(2).replace('.', ',')} €`;

  const estrellasTexto = (n: number, max: number) => '★'.repeat(n) + '☆'.repeat(max - n);

  const calcular = (seVa: boolean, clave: Clave): Resultado => {
    // Las ventas adicionales solo se cobran si el cliente sale contento.
    const lineas: [string, number][] = [];
    if (!seVa) {
      lineas.push(['Pizza de la casa', precioPizza]);
      if (hambre >= umbrales.postre) historial.forEach((h) => h.venta && lineas.push([h.venta.concepto, h.venta.precio]));
    }
    const ultimo = historial[historial.length - 1];
    const momentoPerdido = momentos.find((m) => m.id === ultimo?.momento);
    const nota = seVa
      ? `Se fue en ${momentoPerdido?.nombre.toLowerCase()}`
      : clave === 'recomienda' ? 'Reserva para cuatro la semana que viene' : clave === 'vuelve' ? 'Cliente que repite' : 'Primera y última visita';
    return {
      perfil, clave, estrellas: estrellasDe(historial), lineas,
      total: lineas.reduce((a, [, v]) => a + v, 0), historial: [...historial], nota,
    };
  };

  const terminar = async (seVa: boolean) => {
    const p = partida;
    pararReloj();
    fase('closing');
    const clave: Clave = seVa ? 'seVa' : hambre >= umbrales.recomienda ? 'recomienda' : hambre >= umbrales.vuelve ? 'vuelve' : 'noVuelve';

    turnoBocadillo++;
    escena.decir(seVa ? 'Me voy a otro sitio' : null);
    if (seVa) escena.emocion('💨');
    escena.sentar(false);
    escena.foco('salida');
    await escena.mover('cliente', POS.salida[0], POS.salida[1], { ms: seVa ? 2000 : 2800 });
    if (p !== partida) return;
    escena.decir(null);
    if (clave === 'recomienda') { escena.mostrar('amigos', true); escena.emocion('❤️'); }

    const r = calcular(seVa, clave);
    resultados.push(r);
    track('pizzeria_final', { resultado: clave, estrellas: r.estrellas, hambre, perfil: perfil.id, nivel: nivel.id, modo });
    if (modo === 'jornada' && resultados.length < clientesJornada) return entreClientes(r);
    pintarFinal(seVa);
  };

  // Pausa entre clientes de la jornada con el resultado de la mesa.
  const entreClientes = (r: Resultado) => {
    $('pz-sig-kicker').textContent = `Cliente ${resultados.length} de ${clientesJornada} atendido`;
    $('pz-sig-titulo').textContent = desenlaces[r.clave].titulo;
    $('pz-sig-estrellas').textContent = estrellasTexto(r.estrellas, ESTRELLAS);
    $('pz-sig-caja').textContent = `${r.perfil.nombre}. Caja de esta mesa, ${euros(r.total)}. ${r.nota}.`;
    fase('siguiente');
    card.scrollTop = 0;
  };

  // Cómo ha ido cada fase sumando todos los clientes.
  type Estado = 'fuerte' | 'medias' | 'flaqueas' | 'sin';
  const ESTADOS: Record<Estado, string> = { fuerte: 'Fuerte', medias: 'A medias', flaqueas: 'Aquí flaqueas', sin: 'Sin llegar' };
  const estadoFase = (id: string): Estado => {
    const pasos = resultados.flatMap((r) => r.historial.filter((h) => h.momento === id));
    if (!pasos.length) return 'sin';
    if (pasos.some((h) => h.calidad === 'mal')) return 'flaqueas';
    return pasos.every((h) => h.calidad === 'bien') ? 'fuerte' : 'medias';
  };
  // Cabecera de una fase en el recorrido final, con su estado.
  const cabeceraFase = (m: Momento, puntos: (Calidad | 'vacio')[], titulos: string[]) => {
    const head = document.createElement('p');
    head.className = 'pz-route-head';
    puntos.forEach((c, i) => {
      const dot = document.createElement('span');
      dot.className = 'pz-dot';
      dot.dataset.calidad = c;
      dot.title = titulos[i] ?? '';
      head.append(dot);
    });
    const nombre = document.createElement('strong'); nombre.textContent = m.nombre;
    const b2b = document.createElement('span'); b2b.className = 'pz-muted'; b2b.textContent = `· ${m.b2b}`;
    const estado = estadoFase(m.id);
    const etiqueta = document.createElement('span');
    etiqueta.className = 'pz-estado';
    etiqueta.dataset.estado = estado;
    etiqueta.textContent = ESTADOS[estado];
    head.append(nombre, b2b, etiqueta);
    return { head, estado };
  };

  // Fases donde flaqueas o te quedas a medias, de la que más interés ha
  // costado a la que menos, sumando todos los clientes.
  const fasesDebiles = () => {
    const perdida = new Map<string, { suma: number; peor?: Paso }>();
    resultados.forEach((r) => r.historial.forEach((h) => {
      if (h.delta >= 0 && h.calidad === 'bien') return;
      const e = perdida.get(h.momento) ?? { suma: 0 };
      e.suma += Math.min(0, h.delta) - (h.calidad === 'mal' ? 10 : h.calidad === 'regular' ? 3 : 0);
      if (!e.peor || h.delta < e.peor.delta) e.peor = h;
      perdida.set(h.momento, e);
    }));
    return [...perdida.entries()]
      .filter(([id]) => ['flaqueas', 'medias'].includes(estadoFase(id)))
      .sort((x, y) => x[1].suma - y[1].suma)
      .map(([id, v]) => ({ id, suma: v.suma, paso: v.peor }));
  };
  const puntoDebil = () => fasesDebiles()[0] ?? null;

  // Datos del final, también para la imagen del ticket.
  let finalActual: {
    titulo: string; estrellas: number; max: number; lineas: [string, number][];
    total: number; nota: string; cabecera: string; debil: string | null;
  } | null = null;

  const pintarFinal = (seVa: boolean) => {
    const enJornada = modo === 'jornada';
    const ultimo = resultados[resultados.length - 1];
    const suma = Math.round(resultados.reduce((a, r) => a + r.estrellas, 0) / resultados.length);
    const max = maxEstrellas();
    // El titular del desenlace ya no sale en pantalla, solo en el ticket.
    const balance = enJornada ? jornada.find((j) => suma * 9 / ESTRELLAS >= j.minimo)! : desenlaces[ultimo.clave];

    // Estrellas y récord por modo y nivel.
    const rec = records();
    const antes = rec[nivel.id];
    const nuevo = antes == null || suma > antes;
    if (nuevo) guardar(claveRecord(), { ...rec, [nivel.id]: suma });
    const estrellas = $('pz-estrellas');
    estrellas.replaceChildren();
    const icono = document.createElement('span');
    icono.className = 'pz-estrellas-iconos';
    icono.textContent = estrellasTexto(suma, max);
    icono.setAttribute('aria-label', `${suma} de ${max} estrellas`);
    const cifra = document.createElement('strong');
    cifra.className = 'pz-estrellas-cifra';
    cifra.textContent = `${suma} de ${max}`;
    const texto = document.createElement('span');
    const quien = enJornada ? `${clientesJornada} clientes` : ultimo.perfil.nombre;
    texto.textContent = `Nivel ${nivel.nombre.toLowerCase()} · ${quien}${nuevo && antes != null ? ' · ¡Nuevo récord!' : ''}`;
    estrellas.append(icono, cifra, texto);

    // Ticket: en la jornada, una línea por mesa.
    const lineas: [string, number][] = enJornada
      ? resultados.map((r, i) => [`Mesa ${i + 1} · ${r.perfil.nombre}`, r.total])
      : ultimo.lineas.length ? ultimo.lineas : [['Sin consumición', 0]];
    const total = lineas.reduce((a, [, v]) => a + v, 0);
    const vuelven = resultados.filter((r) => r.clave === 'recomienda' || r.clave === 'vuelve').length;
    const nota = enJornada ? `${vuelven} de ${clientesJornada} clientes volverán` : ultimo.nota;
    const cabecera = enJornada ? `${clientesJornada} mesas · nivel ${nivel.nombre.toLowerCase()}` : `Mesa 1 · ${ultimo.perfil.nombre}`;
    $('pz-ticket-lines').replaceChildren(...lineas.map(([k, v]) => {
      const row = document.createElement('div');
      row.className = 'pz-ticket-line';
      const a = document.createElement('span'); a.textContent = k;
      const b = document.createElement('span'); b.textContent = euros(v);
      row.append(a, b);
      return row;
    }));
    $('pz-total').textContent = euros(total);
    $('pz-ticket-mesa').textContent = cabecera;
    $('pz-ticket-note').textContent = nota;

    // Punto débil.
    const debil = puntoDebil();
    const mDebil = debil && momentos.find((m) => m.id === debil.id);
    $('pz-debil').hidden = !mDebil;
    if (mDebil) {
      $('pz-debil-titulo').textContent = `${mDebil.nombre} · ${mDebil.b2b}`;
      $('pz-debil-texto').textContent = (informes[mDebil.id] ?? informes.general).titulo + '.';
    }

    prepararInforme(mDebil ? mDebil.id : 'general');

    // Recorrido por todas las fases con su estado. En la jornada lleva un
    // punto por cliente. El porqué de cada fallo y las claves van en el informe.
    $('pz-route-titulo').textContent = enJornada ? 'Tu proceso comercial con cada cliente, fase a fase' : 'Tu proceso comercial, fase a fase';
    $('pz-route').replaceChildren(...momentos.map((m) => {
      const pasos = resultados.map((r) => r.historial.find((h) => h.momento === m.id));
      const li = document.createElement('li');
      const { head, estado } = cabeceraFase(
        m,
        pasos.map((x) => x?.calidad ?? 'vacio'),
        pasos.map((x) => (x ? x.texto : 'Este cliente ya se había ido'))
      );
      li.append(head);
      const hechos = pasos.filter((x): x is Paso => !!x);
      const txt = document.createElement('p');
      txt.className = 'pz-route-text';
      if (!hechos.length) txt.textContent = 'El cliente se fue antes de llegar a esta fase.';
      else if (enJornada) txt.textContent = estado === 'fuerte' ? 'Bien con todos los clientes.' : '';
      else txt.textContent = hechos[0].texto;
      if (txt.textContent) li.append(txt);
      return li;
    }));

    const retry = $('pz-retry') as HTMLButtonElement;
    const ultimoPaso = ultimo.historial[ultimo.historial.length - 1];
    const idxPerdido = momentos.findIndex((m) => m.id === ultimoPaso?.momento);
    retry.hidden = enJornada || !seVa || idxPerdido < 1;
    retry.textContent = idxPerdido >= 0 ? `Repetir desde ${momentos[idxPerdido].nombre.toLowerCase()}` : '';
    retry.dataset.idx = String(idxPerdido);
    $('pz-restart').textContent = enJornada ? 'Jugar con otros tres clientes' : 'Jugar con otro cliente';

    finalActual = {
      titulo: balance.titulo, estrellas: suma, max, lineas, total, nota, cabecera,
      debil: mDebil ? `${mDebil.nombre} (${mDebil.b2b.toLowerCase()})` : null,
    };
    const textoCompartir = `He jugado a La pizzería B2B para ver en qué fase de mi proceso comercial flaqueo. ${suma} de ${max} estrellas. ¿Y tú, en qué fase flaqueas?`;
    ($('pz-linkedin') as HTMLAnchorElement).href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
    $('pz-compartir').hidden = !(navigator.canShare && navigator.canShare({ files: [new File([''], 'x.png', { type: 'image/png' })] }));
    $('pz-compartir').dataset.texto = textoCompartir;

    card.hidden = true;
    // Al terminar no se repite la presentación del juego.
    $('pz-head').hidden = true;
    ($('pz-fases') as HTMLDetailsElement).open = !movil.matches;
    $('pz-end').hidden = false;
    $('pz-end').scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    if (enJornada) track('pizzeria_jornada_final', { estrellas: suma, total, nivel: nivel.id });
  };

  // ── Informe a cambio de los datos (se guarda en HubSpot) ──────────
  // Quien ya dejó sus datos en este navegador ve el informe directamente.
  let leadEnviado = leer<boolean>('pz-lead', false);
  let informeClave = 'general';

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, clase: string, texto = '') => {
    const e = document.createElement(tag);
    if (clase) e.className = clase;
    if (texto) e.textContent = texto;
    return e;
  };
  const lista = (nombres: string[]) =>
    nombres.length > 1 ? `${nombres.slice(0, -1).join(', ')} y ${nombres[nombres.length - 1]}` : nombres[0] ?? '';
  const acciones = (pasos: string[]) => {
    const ol = el('ol', 'pz-inf-pasos');
    ol.append(...pasos.map((p) => el('li', '', p)));
    return ol;
  };

  // El informe completo. Para cada fase débil, en orden de prioridad, qué
  // significa en B2B, la clave, por qué falló cada decisión y tres acciones.
  const mostrarInforme = () => {
    const debiles = fasesDebiles();
    const fases = $('pz-inf-fases');
    fases.replaceChildren();
    if (!debiles.length) {
      const inf = informes.general;
      $('pz-inf-titulo').textContent = inf.titulo;
      $('pz-inf-resumen').textContent = inf.diagnostico;
      fases.append(el('p', 'pz-label', 'Tres acciones para esta semana'), acciones(inf.pasos));
    } else {
      const nF = debiles.filter((d) => estadoFase(d.id) === 'flaqueas').length;
      const nM = debiles.length - nF;
      const cuantas = (n: number) => (n === 1 ? 'una fase' : `${n} fases`);
      const partes = [nF && `flaqueas en ${cuantas(nF)}`, nM && `te quedas a medias en ${cuantas(nM)}`].filter(Boolean).join(' y ');
      $('pz-inf-titulo').textContent = debiles.length === 1
        ? 'Tu plan para la fase donde pierdes clientes'
        : `Tu plan para las ${debiles.length} fases donde pierdes clientes`;
      $('pz-inf-resumen').textContent = `De las ${momentos.length} fases de tu proceso comercial, ${partes}. `
        + (debiles.length > 1 ? 'Están ordenadas por lo que más interés te ha costado, así que empieza por la primera.' : 'Es la que más interés te ha costado.');
      debiles.forEach((d, i) => {
        const m = momentos.find((x) => x.id === d.id)!;
        const inf = informes[m.id] ?? informes.general;
        const estado = estadoFase(m.id);
        const art = el('article', 'pz-inf-fase');
        const head = el('h4', 'pz-inf-fase-head', `${i + 1}. ${m.nombre} · ${m.b2b}`);
        const tag = el('span', 'pz-estado', ESTADOS[estado]);
        tag.dataset.estado = estado;
        head.append(tag);
        const clave = el('p', 'pz-inf-clave');
        clave.append(el('strong', '', 'La clave.'), ` ${m.clave}`);
        art.append(head, el('p', 'pz-inf-sub', inf.titulo), el('p', 'pz-inf-diag', inf.diagnostico), clave);
        // Las decisiones que fallaron en esta fase y por qué.
        const fallos = resultados.flatMap((r) => r.historial.filter((h) => h.momento === m.id && (h.calidad !== 'bien' || h.delta < 0)));
        const vistos = new Set<string>();
        const ul = el('ul', 'pz-inf-fallos');
        fallos.forEach((h) => {
          if (vistos.has(h.texto)) return;
          vistos.add(h.texto);
          const li = el('li', '');
          li.append(el('strong', '', `${h.texto}.`), ` ${h.b2b}`);
          ul.append(li);
        });
        if (ul.children.length) art.append(el('p', 'pz-label', 'Lo que pasó en la pizzería'), ul);
        art.append(el('p', 'pz-label', 'Tres acciones para esta semana'), acciones(inf.pasos));
        fases.append(art);
      });
    }
    const fuertes = momentos.filter((m) => estadoFase(m.id) === 'fuerte').map((m) => m.nombre.toLowerCase());
    const fuertesEl = $('pz-inf-fuertes');
    fuertesEl.hidden = !fuertes.length || !debiles.length;
    fuertesEl.textContent = `Lo que ya haces bien. ${lista(fuertes).replace(/^./, (c) => c.toUpperCase())}. Mantenlo mientras trabajas el resto.`;
    const inf = informes[debiles[0]?.id ?? 'general'] ?? informes.general;
    const nombre = servicios[inf.servicio] ?? 'Diagnóstico de Pipeline B2B';
    $('pz-inf-servicio').textContent = `Si quieres trabajarlo con ayuda, el servicio que encaja es ${nombre}.`;
    ($('pz-inf-link') as HTMLAnchorElement).href = `/servicios/${inf.servicio}/`;
    $('pz-lead').hidden = true;
    $('pz-informe').hidden = false;
    $('pz-route-nota').hidden = true;
  };

  const prepararInforme = (clave: string) => {
    informeClave = clave;
    if (leadEnviado) return mostrarInforme();
    $('pz-lead').hidden = false;
    $('pz-informe').hidden = true;
    $('pz-route-nota').hidden = false;
  };

  const enviarLead = async (datos: { nombre: string; empresa: string; email: string }, comercial: boolean) => {
    if (!hubspot.portalId || !hubspot.formId) {
      console.warn('[pizzería] HubSpot sin configurar: el lead NO se ha guardado.', datos);
      return;
    }
    const mDebil = momentos.find((m) => m.id === informeClave);
    const suma = Math.round(resultados.reduce((a, r) => a + r.estrellas, 0) / Math.max(1, resultados.length));
    // Resumen legible en la ficha del contacto, lo más útil arriba.
    const detalle = [
      `Origen: La pizzería B2B (${modo === 'jornada' ? 'tres clientes' : 'un cliente'}, nivel ${nivel.nombre.toLowerCase()})`,
      `Punto débil: ${mDebil ? `${mDebil.nombre} (${mDebil.b2b})` : 'ninguno'}`,
      `Fases débiles por prioridad: ${fasesDebiles().map((d) => `${momentos.find((m) => m.id === d.id)?.nombre} (${ESTADOS[estadoFase(d.id)].toLowerCase()})`).join(', ') || 'ninguna'}`,
      `Estrellas: ${suma} de ${maxEstrellas()}`,
      `Consentimiento comercial: ${comercial ? 'sí' : 'no'}`,
      '',
      ...resultados.flatMap((r, i) => [
        `Cliente ${i + 1}: ${r.perfil.nombre}, ${desenlaces[r.clave].titulo.toLowerCase()}`,
        ...r.historial.map((h) => `  ${momentos.find((m) => m.id === h.momento)?.nombre} [${h.calidad}] ${h.texto}`),
      ]),
    ].join('\n');

    const fields = [
      { name: 'email', value: datos.email },
      { name: 'firstname', value: datos.nombre },
      { name: 'company', value: datos.empresa },
      { name: 'diagnostico_resultado', value: `Pizzería B2B · ${mDebil ? mDebil.b2b : 'sin punto débil'}` },
      { name: 'diagnostico_respuestas', value: detalle },
    ].filter((f) => f.value);

    const consent: Record<string, unknown> = { consentToProcess: true, text: config.textoPrivacidad };
    if (hubspot.subscriptionTypeId) {
      consent.communications = [
        { value: comercial, subscriptionTypeId: Number(hubspot.subscriptionTypeId), text: config.textoComercial },
      ];
    }
    const res = await fetch(
      `https://api.hsforms.com/submissions/v3/integration/submit/${hubspot.portalId}/${hubspot.formId}`,
      {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          fields,
          context: { pageUri: location.href, pageName: document.title },
          legalConsentOptions: { consent },
        }),
      }
    );
    if (!res.ok) throw new Error(`HubSpot ${res.status}: ${await res.text()}`);
  };

  const formLead = $('pz-lead-form') as HTMLFormElement;
  formLead.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(formLead);
    const datos = {
      nombre: String(fd.get('nombre') ?? '').trim(),
      empresa: String(fd.get('empresa') ?? '').trim(),
      email: String(fd.get('email') ?? '').trim(),
    };
    const comercial = fd.get('comercial') === 'on';
    let error = '';
    if (!datos.nombre || !datos.empresa) error = 'Escribe tu nombre y el de tu empresa.';
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(datos.email)) error = 'Revisa el email, parece que falta algo.';
    else if (fd.get('privacidad') !== 'on') error = 'Para ver el informe necesitas aceptar la política de privacidad.';
    const errorEl = $('pz-lead-error');
    errorEl.textContent = error;
    errorEl.hidden = !error;
    if (error) return;

    const boton = $('pz-lead-submit') as HTMLButtonElement;
    boton.disabled = true;
    boton.textContent = 'Preparando tu informe…';
    // Un bot que rellena el campo oculto ve el informe, pero no llega al CRM.
    if (!fd.get('web')) {
      try {
        await enviarLead(datos, comercial);
        track('pizzeria_lead', { comercial, punto_debil: informeClave, modo, nivel: nivel.id });
      } catch (err) {
        // El informe se enseña igualmente: dejar a la persona sin él
        // después de darnos sus datos es peor que perder el lead.
        console.error(err);
        track('pizzeria_lead_error');
      }
    }
    boton.disabled = false;
    boton.textContent = 'Ver mi informe';
    leadEnviado = true;
    guardar('pz-lead', true);
    mostrarInforme();
  });

  // ── Ticket para compartir (imagen 1080x1350, formato vertical de LinkedIn) ─
  const crearImagen = async (): Promise<Blob | null> => {
    if (!finalActual) return null;
    await document.fonts?.ready;
    const f = finalActual;
    const W = 1080;
    const H = 1350;
    const c = document.createElement('canvas');
    c.width = W;
    c.height = H;
    const ctx = c.getContext('2d')!;
    ctx.fillStyle = '#004aad';
    ctx.fillRect(0, 0, W, H);

    // Papel del ticket con borde dentado abajo.
    const x0 = 150;
    const x1 = W - 150;
    const y0 = 120;
    const y1 = 1120;
    ctx.fillStyle = '#fffdf8';
    ctx.beginPath();
    ctx.moveTo(x0, y0);
    ctx.lineTo(x1, y0);
    ctx.lineTo(x1, y1);
    for (let x = x1; x > x0; x -= 30) { ctx.lineTo(x - 15, y1 + 18); ctx.lineTo(x - 30, y1); }
    ctx.closePath();
    ctx.shadowColor = 'rgba(0,0,0,0.25)';
    ctx.shadowBlur = 30;
    ctx.fill();
    ctx.shadowBlur = 0;

    const mono = 'ui-monospace, Menlo, Consolas, monospace';
    const centro = (txt: string, y: number, font: string, color = '#1a1a1a') => {
      ctx.font = font;
      ctx.fillStyle = color;
      ctx.textAlign = 'center';
      ctx.fillText(txt, W / 2, y);
    };
    const linea = (y: number) => {
      ctx.strokeStyle = '#999';
      ctx.setLineDash([10, 8]);
      ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(x0 + 50, y); ctx.lineTo(x1 - 50, y); ctx.stroke();
      ctx.setLineDash([]);
    };
    centro('LA PIZZERÍA B2B', 210, `700 52px ${mono}`);
    centro(f.cabecera, 260, `400 28px ${mono}`, '#666');
    linea(300);
    centro('★'.repeat(f.estrellas) + '☆'.repeat(f.max - f.estrellas), 380, `400 ${f.max > 3 ? 56 : 80}px sans-serif`, '#e8a33d');
    centro(f.titulo, 450, `600 34px Poppins, sans-serif`);
    linea(500);
    let y = 560;
    ctx.font = `400 30px ${mono}`;
    f.lineas.forEach(([k, v]) => {
      ctx.fillStyle = '#1a1a1a';
      ctx.textAlign = 'left';
      ctx.fillText(k.length > 30 ? k.slice(0, 29) + '…' : k, x0 + 60, y);
      ctx.textAlign = 'right';
      ctx.fillText(euros(v), x1 - 60, y);
      y += 50;
    });
    linea(y);
    y += 60;
    ctx.font = `700 38px ${mono}`;
    ctx.textAlign = 'left';
    ctx.fillText('TOTAL', x0 + 60, y);
    ctx.textAlign = 'right';
    ctx.fillText(euros(f.total), x1 - 60, y);
    y += 70;
    centro(f.nota, y, `400 28px ${mono}`, '#444');
    if (f.debil) {
      centro('Donde más flaqueo', y + 80, `400 26px ${mono}`, '#888');
      centro(f.debil, y + 125, `600 30px Poppins, sans-serif`, '#c8452f');
    }
    centro('Gracias por tu visita', y1 - 40, `400 26px ${mono}`, '#888');

    centro('¿En qué fase de tu proceso comercial flaqueas?', 1210, `400 40px Newsreader, serif`, '#ffffff');
    centro(url.replace('https://', '').replace(/\/$/, ''), 1270, `400 26px Poppins, sans-serif`, 'rgba(255,255,255,0.8)');
    return new Promise((res) => c.toBlob((b) => res(b), 'image/png'));
  };

  $('pz-descargar').addEventListener('click', async () => {
    const blob = await crearImagen();
    if (!blob) return;
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'ticket-pizzeria-b2b.png';
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    track('pizzeria_ticket_descarga', { modo });
  });
  $('pz-compartir').addEventListener('click', async (e) => {
    const blob = await crearImagen();
    if (!blob) return;
    const file = new File([blob], 'ticket-pizzeria-b2b.png', { type: 'image/png' });
    try {
      await navigator.share({ files: [file], text: (e.currentTarget as HTMLElement).dataset.texto, url });
      track('pizzeria_ticket_compartir', { modo });
    } catch { /* el usuario cancela */ }
  });
  $('pz-linkedin').addEventListener('click', () => track('pizzeria_ticket_linkedin', { modo }));

  // Partida nueva. En la jornada los clientes salen en orden barajado y
  // sin repetir perfil; `seguir` mantiene la jornada en curso.
  const nuevaPartida = (seguir = false) => {
    partida++;
    pararReloj();
    escena.reset();
    if (!seguir) {
      resultados = [];
      colaPerfiles = barajar(perfiles.length).map((i) => perfiles[i]);
    }
    perfil = modo === 'jornada' ? colaPerfiles[resultados.length % colaPerfiles.length] : azar(perfiles);
    escena.perfil(perfil.id);
    plan = elegirPlan();
    hambre = 0;
    marcas = new Set();
    historial = [];
    interes = '';
    rotulo = '';
    actual = 0;
    fotos = [];
    card.hidden = false;
    $('pz-head').hidden = false;
    $('pz-end').hidden = true;
    const kicker = modo === 'jornada' ? `Cliente ${resultados.length + 1} de ${clientesJornada} · Entra` : 'Hoy entra';
    ($('pz-perfil').querySelector('.pz-kicker') as HTMLElement).textContent = kicker;
    $('pz-perfil-nombre').textContent = perfil.nombre;
    $('pz-perfil-pizza').textContent = perfil.pizza;
    $('pz-perfil-b2b').textContent = perfil.b2b;
    $('pz-perfil-pista').textContent = perfil.pista;
    fase('perfil');
    escena.foco('calle');
    escena.mover('cliente', POS.calle[0], POS.calle[1], { ms: 1800 });
    stage.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    track('pizzeria_inicio', { perfil: perfil.id, nivel: nivel.id, modo, cliente: resultados.length + 1 });
  };

  const jugar = () => {
    fase('play');
    renderMeter();
    escena.humor(60);
    renderMomento();
  };

  // Repetir desde un momento con el mismo cliente y los mismos planteamientos
  // (solo en la partida rápida).
  const repetir = (desde: number) => {
    const foto = fotos[desde];
    if (!foto) return nuevaPartida();
    partida++;
    pararReloj();
    escena.reset();
    escena.perfil(perfil.id);
    resultados = [];
    hambre = foto.hambre;
    marcas = new Set(foto.marcas);
    historial = [...foto.historial];
    interes = foto.interes;
    rotulo = foto.rotulo;
    actual = desde;
    card.hidden = false;
    $('pz-head').hidden = false;
    $('pz-end').hidden = true;
    fase('play');
    $('pz-explica').hidden = true;
    renderMeter();
    escena.humor(hambre);
    if (rotulo) escena.rotulo(rotulo);
    const sitio = desde >= 2 ? POS.mesa : POS.calle;
    escena.mover('cliente', sitio[0], sitio[1], { ms: 0 });
    if (desde >= 2) escena.sentar(true);
    const hecho = (id: string) => historial.find((h) => h.momento === id);
    if (hecho('espera')?.escena?.includes('aperitivo')) escena.mostrar('aperitivo', true);
    const llamada = hecho('llamada');
    const iServicio = momentos.findIndex((m) => m.id === 'servicio');
    if (llamada && (llamada.escena?.includes('camarero') || llamada.texto === 'Pidió él solo') && desde < iServicio) {
      escena.mover('camarero', POS.mesaCamarero[0], POS.mesaCamarero[1], { ms: 0 });
    }
    renderMomento();
    stage.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    track('pizzeria_repetir', { desde: momentos[desde].id, perfil: perfil.id, nivel: nivel.id });
  };

  $('pz-volver-modo').addEventListener('click', () => fase('intro'));
  $('pz-perfil-ok').addEventListener('click', jugar);
  $('pz-sig-ok').addEventListener('click', () => nuevaPartida(true));
  $('pz-restart').addEventListener('click', () => nuevaPartida());
  $('pz-retry').addEventListener('click', (e) => repetir(Number((e.currentTarget as HTMLElement).dataset.idx)));
</script>

<style is:global>
  .pz {
    max-width: 1240px;
    margin: 0 auto;
    padding: 1.25rem 2rem 5rem;
  }


  .pz-kicker {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 1rem;
  }
  body.dark .pz-kicker { color: var(--blue-light); }

  .pz h1,
  .pz-end h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .pz h3 { font-family: 'Poppins', sans-serif; font-size: 1rem; font-weight: 500; margin-bottom: 1rem; }
  .pz-head { margin-bottom: 3rem; }
  .pz-sub { font-size: 1.05rem; font-weight: 300; line-height: 1.6; max-width: 640px; color: rgba(0,0,0,0.7); }
  body.dark .pz-sub { color: rgba(232,232,232,0.7); }

  .pz-intro {
    font-size: 0.95rem;
    font-weight: 300;
    color: rgba(0,0,0,0.65);
    line-height: 1.75;
    max-width: 640px;
    margin-bottom: 1rem;
  }
  body.dark .pz-intro { color: rgba(232,232,232,0.65); }
  .pz-muted { opacity: 0.55; font-weight: 300; }
  .pz-label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin: 0.5rem 0 0.6rem; opacity: 0.7; }

  /* BOTONES */
  .pz-btn {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    border: 1px solid var(--blue);
    border-radius: 8px;
    background: var(--blue);
    color: #fff;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .pz-btn:hover { opacity: 0.9; }
  .pz-btn[hidden] { display: none; }
  .pz-btn--ghost { background: transparent; color: var(--blue); }
  body.dark .pz-btn--ghost { color: var(--blue-light); border-color: var(--blue-light); }
  .pz-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  /* NIVELES */
  .pz-niveles { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.25rem; }
  .pz-nivel {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.1rem 0.75rem;
    align-items: baseline;
    padding: 0.7rem 0.9rem;
    border: 1px solid rgba(0,0,0,0.14);
    border-radius: 8px;
    background: var(--white);
    color: var(--black);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  body.dark .pz-nivel { background: var(--dark-bg); border-color: rgba(255,255,255,0.14); color: #e8e8e8; }
  .pz-nivel strong { font-size: 0.88rem; font-weight: 600; }
  .pz-nivel span { font-size: 0.78rem; font-weight: 300; line-height: 1.45; opacity: 0.75; grid-column: 2; grid-row: 1 / span 2; }
  .pz-nivel small { font-size: 0.7rem; color: #b7791f; grid-column: 1; }
  .pz-nivel:hover { border-color: var(--blue); }
  .pz-nivel.is-on { border-color: var(--blue); background: rgba(0,74,173,0.08); box-shadow: inset 0 0 0 1px var(--blue); }
  body.dark .pz-nivel.is-on { border-color: var(--blue-light); box-shadow: inset 0 0 0 1px var(--blue-light); }

  .pz-pista {
    font-size: 0.88rem;
    line-height: 1.6;
    padding: 0.75rem 0.9rem;
    border-radius: 8px;
    background: rgba(232,163,61,0.14);
    margin-bottom: 1.2rem;
  }
  .pz-pista::before { content: 'Pista · '; font-weight: 600; color: #b7791f; }

  /* ESCENARIO 3D */
  .pz-stage {
    position: relative;
    /* Cabe entera en pantalla al abrir la página, bajo el menú. */
    height: clamp(520px, calc(100svh - 130px), 820px);
    scroll-margin-top: 92px;
    border-radius: 14px;
    overflow: hidden;
    background: #dfe9f7;
    border: 1px solid rgba(0,0,0,0.08);
    margin-bottom: 2.5rem;
  }
  body.dark .pz-stage { background: #0e1726; border-color: rgba(255,255,255,0.1); }
  .pz-stage canvas { position: absolute; inset: 0; width: 100% !important; height: 100% !important; display: block; }

  .pz-glass {
    background: rgba(255,255,255,0.9);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,30,80,0.12);
  }
  body.dark .pz-glass { background: rgba(18,18,18,0.88); border-color: rgba(255,255,255,0.1); box-shadow: 0 10px 30px rgba(0,0,0,0.4); }

  /* Marcador sin fondo: solo etiqueta y barra, con sombra para leerse
     sobre la escena. */
  .pz-hud {
    position: absolute;
    top: 1rem;
    left: 1.1rem;
    width: min(300px, calc(100% - 540px));
    min-width: 230px;
    z-index: 2;
    pointer-events: none;
    color: #ffffff;
    text-shadow: 0 1px 2px rgba(0,0,0,0.9), 0 0 8px rgba(0,0,0,0.65), 0 0 16px rgba(0,0,0,0.35);
  }
  .pz-hud[hidden] { display: none; }
  .pz-hud .pz-muted { opacity: 0.9; font-weight: 400; }
  .pz-meter-head { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.76rem; font-weight: 600; margin-bottom: 0.35rem; }
  .pz-meter-bar { height: 9px; border-radius: 5px; background: rgba(0,0,0,0.35); box-shadow: 0 0 0 1.5px rgba(255,255,255,0.85), 0 1px 6px rgba(0,0,0,0.4); overflow: hidden; }
  .pz-meter-bar.is-sube { animation: pz-sube 0.7s ease; }
  .pz-meter-bar.is-baja { animation: pz-baja 0.7s ease; }
  @keyframes pz-sube { 30% { transform: scaleY(1.8); box-shadow: 0 0 0 3px rgba(46,160,90,0.45); } }
  @keyframes pz-baja { 30% { transform: scaleY(1.8); box-shadow: 0 0 0 3px rgba(200,69,47,0.45); } }
  #pz-meter-fill { display: block; height: 100%; width: 0; border-radius: 5px; background: var(--blue); transition: width 0.6s ease, background 0.6s ease; }
  #pz-meter-fill[data-level='medio'] { background: #e8a33d; }
  #pz-meter-fill[data-level='bajo'] { background: #c8452f; }
  .pz-impaciencia { font-size: 0.75rem; font-weight: 700; color: #c8452f; margin-top: 0.35rem; animation: pz-latido 1s ease-in-out infinite; }
  .pz-impaciencia[hidden] { display: none; }
  @keyframes pz-latido { 50% { opacity: 0.45; } }

  .pz-card {
    position: absolute;
    top: 1rem;
    right: 1rem;
    max-height: calc(100% - 2rem);
    width: min(480px, 44%);
    padding: 1.6rem 1.75rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    z-index: 2;
  }
  .pz-card[hidden] { display: none; }
  :is(#pz-intro, #pz-dificultad) .pz-intro { font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.1rem; }
  :is(#pz-intro, #pz-dificultad) .pz-niveles { margin-bottom: 0; gap: 0.6rem; }
  .pz-paso { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.55; margin-bottom: 0.5rem; }
  /* Cada opción del inicio es un botón que avanza: flecha a la derecha. */
  .pz-eleccion { grid-template-columns: auto 1fr auto; padding: 0.9rem 1rem; }
  .pz-eleccion::after { content: '→'; grid-column: 3; grid-row: 1 / span 2; align-self: center; color: var(--blue); transition: transform 0.15s; }
  body.dark .pz-eleccion::after { color: var(--blue-light); }
  .pz-eleccion:hover::after { transform: translateX(3px); }
  .pz-volver { margin-top: 1rem; padding: 0.3rem 0; border: 0; background: none; color: inherit; font: inherit; font-size: 0.8rem; opacity: 0.6; cursor: pointer; }
  .pz-volver:hover { opacity: 1; color: var(--blue); }

  .pz-bocadillo {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    padding: 0.5rem 0.85rem;
    margin-top: -14px;
    background: #fff;
    color: #1a1a1a;
    border: 1.5px solid #1a1a1a;
    border-radius: 12px;
    font-size: 0.85rem;
    white-space: nowrap;
    pointer-events: none;
    will-change: transform;
    animation: pz-pop 0.3s ease;
  }
  .pz-bocadillo[hidden] { display: none; }
  .pz-emote {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    font-size: 1.7rem;
    line-height: 1;
    pointer-events: none;
    will-change: transform;
    filter: drop-shadow(0 2px 3px rgba(0,0,0,0.25));
  }
  .pz-emote[hidden] { display: none; }
  .pz-emote.is-pop { animation: pz-emote 0.5s ease; }
  @keyframes pz-emote { 0% { scale: 0.3; opacity: 0; } 60% { scale: 1.25; opacity: 1; } 100% { scale: 1; } }
  .pz-bocadillo::after {
    content: '';
    position: absolute;
    left: var(--cola, 50%);
    bottom: -9px;
    width: 14px;
    height: 14px;
    background: #fff;
    border-right: 1.5px solid #1a1a1a;
    border-bottom: 1.5px solid #1a1a1a;
    transform: translateX(-50%) rotate(45deg);
  }
  @keyframes pz-pop { from { opacity: 0; } to { opacity: 1; } }

  /* TARJETA DE JUEGO */
  .pz-progress {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.55);
    margin-bottom: 0.9rem;
  }
  body.dark .pz-progress { color: rgba(232,232,232,0.55); }
  .pz-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .pz-chip {
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    background: rgba(0,74,173,0.08);
    color: var(--blue);
    letter-spacing: 0.04em;
  }
  .pz-chip[hidden] { display: none; }
  body.dark .pz-chip { background: rgba(149,192,250,0.12); color: var(--blue-light); }
  .pz-chip--evento, body.dark .pz-chip--evento { background: rgba(200,69,47,0.12); color: #c8452f; }

  .pz-question {
    font-family: 'Newsreader', serif;
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: 1.2rem;
  }

  .pz-options { display: flex; flex-direction: column; gap: 0.6rem; }
  .pz-options[hidden] { display: none; }
  .pz-option {
    padding: 0.85rem 1rem;
    border: 1px solid rgba(0,0,0,0.14);
    border-radius: 8px;
    background: var(--white);
    color: var(--black);
    font: inherit;
    font-size: 0.88rem;
    line-height: 1.45;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, transform 0.15s, opacity 0.2s;
  }
  body.dark .pz-option { background: var(--dark-bg); border-color: rgba(255,255,255,0.14); color: #e8e8e8; }
  .pz-option:hover:not(:disabled) { border-color: var(--blue); transform: translateX(3px); }
  .pz-option:disabled { cursor: default; opacity: 0.45; }
  .pz-option.is-selected { opacity: 1; border-color: var(--blue); background: rgba(0,74,173,0.08); }
  body.dark .pz-option.is-selected { border-color: var(--blue-light); }
  .pz-options.is-answered .pz-option:not(.is-selected) { display: none; }

  /* Todas las tarjetas del juego son un cristal translúcido para ver la
     escena detrás. La legibilidad la dan un fondo al 72 %, un desenfoque
     fuerte que borra el detalle de detrás, texto de color sólido y botones
     algo más opacos. */
  .pz-card, .pz-explica {
    background: rgba(255,255,255,0.72);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    border-color: rgba(255,255,255,0.7);
    box-shadow: 0 8px 24px rgba(0,30,80,0.12);
    color: #1a1a1a;
  }
  body.dark .pz-card, body.dark .pz-explica {
    background: rgba(14,16,22,0.72);
    border-color: rgba(255,255,255,0.14);
    color: #f0f0f0;
  }
  .pz-explica .pz-lesson { font-weight: 500; }
  .pz-card .pz-intro { color: #2a2a2a; }
  body.dark .pz-card .pz-intro { color: #e4e4e4; }
  .pz-card .pz-progress, .pz-card .pz-paso { color: #444; opacity: 1; }
  body.dark .pz-card .pz-progress, body.dark .pz-card .pz-paso { color: #c8c8c8; }
  .pz-card :is(.pz-option, .pz-nivel) { background: rgba(255,255,255,0.8); border-color: rgba(0,0,0,0.12); }
  body.dark .pz-card :is(.pz-option, .pz-nivel) { background: rgba(24,26,32,0.8); border-color: rgba(255,255,255,0.16); }
  .pz-card :is(.pz-option, .pz-nivel):hover:not(:disabled) { background: rgba(255,255,255,0.96); }
  body.dark .pz-card :is(.pz-option, .pz-nivel):hover:not(:disabled) { background: rgba(24,26,32,0.96); }
  .pz-card .pz-nivel span { opacity: 0.85; }
  .pz-card .pz-option.is-selected { background: rgba(232,240,252,0.96); border-color: var(--blue); }
  body.dark .pz-card .pz-option.is-selected { background: rgba(22,40,70,0.92); border-color: var(--blue-light); }

  /* Tarjeta de la explicación, a la izquierda de la de preguntas. */
  .pz-explica {
    position: absolute;
    right: calc(min(480px, 44%) + 2rem);
    bottom: 1rem;
    width: min(300px, calc(100% - min(480px, 44%) - 3rem));
    max-height: 48%;
    overflow-y: auto;
    padding: 1rem 1.2rem 1.05rem;
    border-left: 3px solid var(--blue);
    background: rgba(255,255,255,0.82);
    z-index: 2;
  }
  body.dark .pz-explica { background: rgba(18,18,18,0.8); border-left-color: var(--blue-light); }
  .pz-explica[hidden] { display: none; }
  .pz-explica[data-calidad='regular'] { border-left-color: #e8a33d; }
  .pz-explica[data-calidad='mal'] { border-left-color: #c8452f; }
  .pz-explica.is-nueva { animation: pz-in 0.35s ease; }
  .pz-explica .pz-lesson { font-size: 0.85rem; line-height: 1.6; margin-bottom: 0; }
  .pz-explica .pz-verdict { padding-right: 1.5rem; margin-bottom: 0.3rem; }
  /* Cifra o veredicto que sube sobre la cabeza del cliente al responder. */
  .pz-flota {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    pointer-events: none;
    white-space: nowrap;
    font-family: 'Poppins', sans-serif;
    font-size: 2rem;
    font-weight: 800;
    color: #17803f;
    text-shadow: 2px 0 0 #fff, -2px 0 0 #fff, 0 2px 0 #fff, 0 -2px 0 #fff, 1.5px 1.5px 0 #fff, -1.5px -1.5px 0 #fff, 1.5px -1.5px 0 #fff, -1.5px 1.5px 0 #fff, 0 4px 12px rgba(0,0,0,0.35);
    will-change: transform, opacity;
  }
  .pz-flota[data-tipo='regular'] { color: #c27a12; }
  .pz-flota[data-tipo='mal'] { color: #c8452f; }

  .pz-explica-cerrar {
    position: absolute;
    top: 0.35rem;
    right: 0.45rem;
    width: 1.6rem;
    height: 1.6rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    font-size: 1.1rem;
    line-height: 1;
    opacity: 0.5;
    cursor: pointer;
  }
  .pz-explica-cerrar:hover { opacity: 0.9; background: rgba(128,128,128,0.15); }
  .pz-verdict { font-size: 0.74rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 0.45rem; color: var(--blue); }
  body.dark .pz-verdict { color: var(--blue-light); }
  .pz-verdict[data-calidad='regular'] { color: #b7791f; }
  .pz-verdict[data-calidad='mal'] { color: #c8452f; }
  .pz-verdict[data-calidad='neutral'] { color: inherit; opacity: 0.7; }
  .pz-lesson { font-size: 0.9rem; line-height: 1.65; margin-bottom: 0.9rem; }
  .pz-lesson-label { font-weight: 600; color: var(--blue); }
  body.dark .pz-lesson-label { color: var(--blue-light); }
  @keyframes pz-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  /* FINAL */
  .pz-end { max-width: 1100px; }
  .pz-end[hidden] { display: none; }
  .pz-estrellas { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1rem; margin-bottom: 1rem; font-size: 0.85rem; opacity: 0.85; }
  .pz-estrellas-iconos { font-size: 2.2rem; letter-spacing: 0.12em; color: #e8a33d; line-height: 1; }
  .pz-estrellas-cifra { font-size: 1.05rem; font-weight: 600; }
  .pz-end { padding-top: 0.5rem; }
  /* Recorrido por fases plegable. */
  .pz-fases summary { font-size: 1rem; font-weight: 500; cursor: pointer; list-style: none; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
  .pz-fases summary::-webkit-details-marker { display: none; }
  .pz-fases summary::after { content: '▾'; font-size: 0.85rem; opacity: 0.6; transition: transform 0.2s; }
  .pz-fases:not([open]) summary::after { transform: rotate(-90deg); }
  .pz-fases:not([open]) summary { padding: 0.85rem 1rem; border: 1px solid rgba(128,128,128,0.3); border-radius: 8px; margin-bottom: 0; }
  .pz-end-grid {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
    margin: 1rem 0 3rem;
  }

  .pz-ticket {
    position: relative;
    padding: 1.6rem 1.4rem 2rem;
    background: #fffdf8;
    color: #1a1a1a;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.82rem;
    box-shadow: 0 6px 24px rgba(0,0,0,0.08);
    transform: rotate(-1.2deg);
    animation: pz-print 0.9s ease;
  }
  .pz-ticket::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -10px;
    height: 10px;
    background: radial-gradient(circle at 8px 10px, transparent 7px, #fffdf8 7.5px) 0 0 / 16px 10px repeat-x;
  }
  .pz-ticket-head { text-align: center; font-size: 1rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding-bottom: 0.9rem; border-bottom: 1px dashed #999; margin-bottom: 0.9rem; }
  .pz-ticket-head small { display: block; font-size: 0.7rem; font-weight: 400; letter-spacing: 0.04em; text-transform: none; opacity: 0.6; margin-top: 0.3rem; }
  .pz-ticket-line, .pz-ticket-total { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 0.4rem; }
  .pz-ticket-line span:last-child, .pz-ticket-total span:last-child { white-space: nowrap; }
  .pz-ticket-total { font-weight: 700; font-size: 0.95rem; border-top: 1px dashed #999; padding-top: 0.8rem; margin-top: 0.8rem; }
  .pz-ticket-note { margin-top: 1rem; padding: 0.5rem; border: 1px dashed #999; text-align: center; }
  .pz-ticket-thanks { text-align: center; margin-top: 1rem; opacity: 0.6; }
  @keyframes pz-print { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 -20px 0); } }

  .pz-route { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .pz-route-head { font-size: 0.9rem; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.2rem; }
  .pz-route-text { font-size: 0.88rem; font-weight: 300; line-height: 1.65; padding-left: 1.1rem; opacity: 0.8; }
  .pz-route-b2b { font-size: 0.88rem; line-height: 1.65; padding-left: 1.1rem; margin-top: 0.2rem; }
  .pz-dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--blue); flex-shrink: 0; }
  .pz-dot[data-calidad='regular'] { background: #e8a33d; }
  .pz-dot[data-calidad='mal'] { background: #c8452f; }
  .pz-dot[data-calidad='vacio'] { background: transparent; box-shadow: inset 0 0 0 1.5px rgba(128,128,128,0.5); }
  .pz-route-head { flex-wrap: wrap; }
  .pz-estado { margin-left: auto; font-size: 0.75rem; font-weight: 500; opacity: 0.7; white-space: nowrap; }
  .pz-estado[data-estado='flaqueas'] { color: #c8452f; opacity: 1; }
  .pz-estado[data-estado='medias'] { color: #b7791f; opacity: 1; }
  /* Nota gris que lleva al informe. */
  .pz-route-nota { font-size: 0.95rem; line-height: 1.6; margin-top: 1.4rem; padding: 0.95rem 1.1rem; border-radius: 8px; background: var(--off-white); }
  body.dark .pz-route-nota { background: var(--dark-surface); }
  .pz-route-nota strong { font-weight: 600; }
  .pz-route-nota .pz-link { display: inline-block; margin-top: 0.35rem; font-size: 0.9rem; }
  #pz-lead { scroll-margin-top: 100px; }
  .pz-route-nota[hidden] { display: none; }

  .pz-debil {
    max-width: 720px;
    padding: 1.1rem 1.3rem;
    border-left: 3px solid #c8452f;
    background: rgba(200,69,47,0.07);
    border-radius: 0 8px 8px 0;
    margin: 0.5rem 0 1rem;
  }
  .pz-debil[hidden] { display: none; }
  .pz-debil .pz-kicker { color: #c8452f; margin-bottom: 0.4rem; }
  .pz-debil-titulo { font-family: 'Newsreader', serif; font-size: 1.35rem; line-height: 1.3; margin-bottom: 0.4rem; }
  #pz-debil-texto { font-size: 0.92rem; line-height: 1.65; }

  .pz-informe-bloque {
    max-width: 720px;
    padding: 1.6rem 1.7rem;
    border: 1px solid rgba(0,74,173,0.25);
    border-radius: 12px;
    background: rgba(0,74,173,0.04);
    margin: 0 0 2.5rem;
  }
  body.dark .pz-informe-bloque { border-color: rgba(149,192,250,0.3); background: rgba(149,192,250,0.05); }
  .pz-informe-titulo { font-family: 'Newsreader', serif !important; font-size: 1.5rem !important; font-weight: 400 !important; line-height: 1.25; margin-bottom: 0.7rem !important; }
  .pz-inf-diag { font-size: 0.95rem; line-height: 1.75; margin-bottom: 1.2rem; }
  .pz-inf-pasos { padding-left: 1.2rem; margin-bottom: 1.2rem; }
  .pz-inf-pasos li { font-size: 0.93rem; line-height: 1.7; margin-bottom: 0.5rem; }
  .pz-inf-servicio { font-size: 0.92rem; line-height: 1.6; margin-bottom: 0.4rem; }
  .pz-inf-fase { padding-top: 1.3rem; margin-top: 1.3rem; border-top: 1px solid rgba(128,128,128,0.25); }
  .pz-inf-fase-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; font-size: 1rem; font-weight: 600; margin-bottom: 0.3rem; }
