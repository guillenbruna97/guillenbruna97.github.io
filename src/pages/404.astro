---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOKING_URL } from '../consts';

// GitHub Pages sirve este archivo automáticamente para cualquier ruta que
// no exista (antes caía en la 404 genérica de GitHub: sin marca, sin nav,
// sin forma de volver al sitio — ver auditoría de sep-2026). noindex para
// que Google nunca la indexe como contenido real.
---
<BaseLayout
  title="Página no encontrada | Guillén Bruna Tricas"
  description="Esta página no existe o se ha movido. Vuelve al inicio o revisa los artículos y servicios de Guillén Bruna Tricas."
  noindex={true}
>
  <section class="notfound">
    <span class="ghost-mark notfound-ghost" aria-hidden="true">404</span>
    <div class="notfound-content">
      <p class="notfound-eyebrow">Error 404</p>
      <h1 class="notfound-title">Esta página se ha perdido en el proceso comercial.</h1>
      <p class="notfound-desc">El enlace que has seguido no existe o se ha movido de sitio. Vuelve al inicio, revisa los artículos o resérvame 15 minutos si buscabas contactar.</p>
      <div class="notfound-actions">
        <a href="/" class="notfound-btn notfound-btn--primary">Volver al inicio</a>
        <a href="/articulos/" class="notfound-btn notfound-btn--ghost">Ver artículos</a>
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="notfound-btn notfound-btn--ghost">Reservar llamada</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .notfound {
    position: relative;
    overflow: hidden;
    min-height: 60vh;
    display: flex;
    align-items: center;
    padding: 4rem 2rem;
  }
  .notfound-ghost {
    font-size: clamp(8rem, 24vw, 18rem);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-style: italic;
    line-height: 1;
    white-space: nowrap;
  }
  .notfound-content {
    position: relative;
    z-index: 1;
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }
  .notfound-eyebrow {
    font-family: 'Poppins', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 1rem;
    transition: color var(--transition);
  }
  body.dark .notfound-eyebrow { color: var(--blue-light); }
  .notfound-title {
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }
  .notfound-desc {
    font-family: 'Poppins', sans-serif;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.7;
    color: rgba(0,0,0,0.6);
    margin-bottom: 2.25rem;
    transition: color var(--transition);
  }
  body.dark .notfound-desc { color: rgba(232,232,232,0.6); }
  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
  }
  .notfound-btn {
    display: inline-flex;
    align-items: center;
    font-family: 'Poppins', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 0.85rem 1.8rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background var(--transition), color var(--transition), border-color var(--transition), transform 0.15s ease;
  }
  .notfound-btn--primary {
    background: var(--blue);
    color: var(--white);
    border: 1px solid transparent;
  }
  .notfound-btn--primary:hover { background: #003a8a; transform: translateY(-1px); }
  body.dark .notfound-btn--primary { background: var(--blue-light); color: var(--dark-bg); }
  body.dark .notfound-btn--primary:hover { background: #7ab0f0; }
  .notfound-btn--ghost {
    background: transparent;
    color: var(--black);
    border: 1px solid rgba(0,0,0,0.2);
  }
  .notfound-btn--ghost:hover { border-color: var(--blue); color: var(--blue); transform: translateY(-1px); }
  body.dark .notfound-btn--ghost { color: #e8e8e8; border-color: rgba(232,232,232,0.25); }
  body.dark .notfound-btn--ghost:hover { border-color: var(--blue-light); color: var(--blue-light); }

  @media (max-width: 640px) {
    .notfound-actions { flex-direction: column; width: 100%; }
    .notfound-btn { justify-content: center; }
  }
</style>
