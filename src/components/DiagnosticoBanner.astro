---
// Banda a todo el ancho que invita a hacer el diagnóstico de marketing.
// Muestra la primera pregunta con sus respuestas como botones: cada uno
// abre el diagnóstico con esa respuesta ya marcada (?s=<índice>), así la
// persona entra habiendo empezado. Los textos salen de GAMES y de
// PREGUNTAS para que digan siempre lo mismo que el propio diagnóstico.
import { GAMES } from '../consts';
import { PREGUNTAS } from '../data/diagnostico';

const game = GAMES.find((g) => g.slug === 'diagnostico-marketing')!;
const href = `/recursos/minijuegos/${game.slug}/`;
const primera = PREGUNTAS[0];
// El banner muestra 4 respuestas en una rejilla de 2x2. Se deja fuera la
// primera ("No vendemos lo suficiente..."), la más genérica: las otras
// cuatro ya cubren las tres áreas. Cada botón conserva su índice real
// para que ?s= marque la respuesta correcta en el diagnóstico.
const SINTOMAS_BANNER = [1, 2, 3, 4];
const opciones = SINTOMAS_BANNER.map((i) => ({ i, texto: primera.opciones[i].texto }));
---
<section class="diag-band" aria-labelledby="diag-band-title">
  <div class="diag-band-inner" data-reveal>
    <p class="diag-band-kicker">{game.tag} · {game.meta}</p>
    <h2 class="diag-band-title" id="diag-band-title">{primera.pregunta}</h2>
    <p class="diag-band-hint">Elige la tuya y descubre qué hay detrás.</p>
    <div class="diag-band-options">
      {opciones.map(({ i, texto }) => (
        <a href={`${href}?s=${i}`} class="diag-band-option" data-diag-banner="sintoma">{texto}</a>
      ))}
    </div>
    <a href={href} class="diag-band-cta" data-diag-banner="boton">{game.cta} <span aria-hidden="true">→</span></a>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-diag-banner]').forEach((link) => {
    link.addEventListener('click', () => {
      const gtag = (window as any).gtag;
      if (typeof gtag === 'function') {
        gtag('event', 'banner_diagnostico_click', {
          origen: link.dataset.diagBanner,
          page_path: location.pathname,
          transport_type: 'beacon',
        });
      }
    });
  });
</script>

<style is:global>
  .diag-band {
    background: var(--dark-surface);
    color: #fff;
    transition: background var(--transition);
  }
  /* En modo oscuro la banda de servicios que va debajo ya usa --dark-surface:
     un gris algo más claro evita que las dos se fundan. */
  body.dark .diag-band { background: #262626; }

  /* Mismos márgenes laterales que el hero de la home (.hh-inner): 4vw, y 6vw por debajo de 1180px */
  .diag-band-inner { max-width: 1400px; margin: 0 4vw; padding: 5rem 0; }

  .diag-band-kicker {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue-light);
    margin-bottom: 1.2rem;
  }

  .diag-band-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(2rem, 4.4vw, 3.6rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 900px;
    color: #fff;
    margin-bottom: 0.9rem;
  }

  .diag-band-hint {
    font-size: 1rem;
    font-weight: 300;
    color: rgba(255,255,255,0.65);
    margin-bottom: 2.2rem;
  }

  /* Rejilla 2x2: columnas del mismo ancho y, al estirarse por defecto, las
     cuatro cajas de la misma altura aunque un texto ocupe más líneas. */
  .diag-band-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 0.75rem;
    max-width: 900px;
    margin-bottom: 2.5rem;
  }

  .diag-band-option {
    display: flex;
    align-items: center;
    padding: 1.1rem 1.3rem;
    border: 1px solid rgba(255,255,255,0.22);
    border-radius: 8px;
    color: #fff;
    font-size: 0.92rem;
    line-height: 1.4;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .diag-band-option:hover,
  .diag-band-option:focus-visible {
    background: rgba(255,255,255,0.08);
    border-color: var(--blue-light);
    transform: translateY(-2px);
  }

  .diag-band-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1.1rem 2rem;
    border-radius: 8px;
    background: var(--blue);
    color: #fff;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .diag-band-cta:hover { background: #0057cc; }
  .diag-band-cta span { transition: transform 0.2s ease; }
  .diag-band-cta:hover span { transform: translateX(4px); }

  @media (max-width: 1180px) {
    .diag-band-inner { margin: 0 6vw; padding: 4rem 0; }
  }
  @media (max-width: 640px) {
    .diag-band-options { grid-template-columns: 1fr; }
    .diag-band-cta { width: 100%; justify-content: center; }
  }
</style>
