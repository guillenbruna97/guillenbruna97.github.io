---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import DiagnosticoBanner from '../components/DiagnosticoBanner.astro';
import { Picture } from 'astro:assets';
import heroIlustracion from '../assets/articulos/consultor-de-marketing-en-zaragoza.jpg';
import heroIlustracionOscura from '../assets/hero/ilustracion-oscura.jpg';
import CasosTabs from '../components/CasosTabs.astro';
import BurbujaRecomendador from '../components/BurbujaRecomendador.astro';
import AreasTarjetas from '../components/AreasTarjetas.astro';
import { BOOKING_URL } from '../consts';
import { HOME } from '../data/home';
import { enlace, ui, type Lang } from '../i18n';

// Home en los dos idiomas (2026-10-25): la estructura vive aquí y los textos en
// data/home.ts. La versión inglesa no lleva el autodiagnóstico (solo en español).
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = HOME[lang];

const trustLogos = [
  { src: '/logos/zebra.png', width: 290, alt: t.logo('Zebra AI Transformation Company') },
  { src: '/logos/rey.png', width: 212, alt: t.logo('Muebles Rey') },
  { src: '/logos/tuco.png', width: 276, alt: t.logo('Muebles Tuco') },
  { src: '/logos/grupo-rey.png', width: 152, alt: t.logo('Grupo Rey Corporación') },
  { src: '/logos/slm.png', width: 249, alt: t.logo('SLM') },
  { src: '/logos/integra.png', width: 227, alt: t.logo('Integra Consultoría Gerencial') },
];
---
<BaseLayout
  title={t.seoTitle}
  description={t.seoDescription}
>
  <section class="hx">
    <div class="hx-inner">
      <h1 class="hx-title" set:html={t.h1} />
      <div class="hx-sub">
        <p class="hx-desc">{t.desc}</p>
        <div class="hx-actions">
          <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">{t.llamada}</a>
          <a href={enlace(lang, '/trabajo/')} class="btn-secondary">{t.casos}</a>
        </div>
      </div>
      <div class="hx-media" data-parallax aria-hidden="true">
        <Picture src={heroIlustracion} alt="" width={1376} height={768} formats={['avif', 'webp']} quality={72} loading="eager" fetchpriority="high" class="hx-claro" />
        <Picture src={heroIlustracionOscura} alt="" width={1376} height={768} formats={['avif', 'webp']} quality={72} loading="lazy" class="hx-oscuro" />
      </div>
    </div>
    <div class="hh-trust">
      <p class="hh-trust-label">{ui(lang).marcas}</p>
      <div class="hh-logos">
        <div class="hh-logos-track">
          {[0, 1, 2, 3].map((i) => (
            <div class="hh-logos-set" aria-hidden={i === 0 ? undefined : 'true'}>
              {trustLogos.map((logo) => <img src={logo.src} alt={i === 0 ? logo.alt : ''} width={logo.width} height="160" loading="lazy" decoding="async" />)}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CasosTabs />

  <section class="hx-manifiesto">
    <h2>{t.manifiesto}</h2>
    <div class="hx-cols">
      <p>{t.manifiesto1}</p>
      <p>{t.manifiesto2} <a href={enlace(lang, '/quienes-somos/#la-red')}>{t.red}</a></p>
    </div>
  </section>

  <AreasTarjetas titulo={t.areas} />

  {lang === 'es' && <DiagnosticoBanner />}

  <section class="stats-band">
    <div class="stats-band-inner">
      <div class="stat-item stat-item--hero" data-count="6">
        <p class="stat-value"><span class="stat-number">6</span>+</p>
        <p class="stat-label"><span class="stat-label-lead">{t.stats[0][0]}</span> {t.stats[0][1]}</p>
      </div>
      <div class="stats-side">
        <div class="stat-item" data-count="4">
          <p class="stat-value"><span class="stat-number">4</span>+</p>
          <p class="stat-label"><span class="stat-label-lead">{t.stats[1][0]}</span> {t.stats[1][1]}</p>
        </div>
        <div class="stat-item" data-count="5">
          <p class="stat-value"><span class="stat-number">5</span>+</p>
          <p class="stat-label"><span class="stat-label-lead">{t.stats[2][0]}</span> {t.stats[2][1]}</p>
        </div>
      </div>
    </div>
  </section>


  <ContactBlock
    title={t.contactoTitulo}
    subtitle={t.contactoTexto}
  />
<script>
    // Parallax de la imagen del hero: se desplaza hasta el 23 % de su altura
    // (el 30 % que sobra respecto al contenedor) mientras el hero cruza la pantalla.
    const media = document.querySelector<HTMLElement>('[data-parallax]');
    if (media && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const imgs = media.querySelectorAll<HTMLImageElement>('img');
      let ticking = false;
      const update = () => {
        ticking = false;
        const r = media.getBoundingClientRect();
        const vh = window.innerHeight;
        if (r.bottom < 0 || r.top > vh) return;
        const progress = Math.min(1, Math.max(0, (vh - r.top) / (vh + r.height)));
        imgs.forEach((img) => { img.style.transform = `translate3d(0, ${(-progress * 23).toFixed(2)}%, 0)`; });
      };
      window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      window.addEventListener('resize', update);
      update();
    }
  </script>
  <BurbujaRecomendador />
</BaseLayout>

<style is:global>
  /* HERO (estructura inspirada en elogia.net: titular grande, subtítulo con botones y foto a todo el ancho) */
  .hx { padding: 4.5rem 0 1rem; }
  .hx-inner { max-width: 1240px; margin: 0 auto; padding: 0 4vw; }
  .hx-title { font-family: 'Poppins', sans-serif; font-size: clamp(2.6rem, 6.6vw, 6rem); font-weight: 500; line-height: 1.0; letter-spacing: -0.045em; margin: 0 0 2.2rem; max-width: 1100px; }
  body.dark .hx-title { color: #e8e8e8; }
  .hx-sub { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.6rem 3rem; margin-bottom: 2.6rem; }
  .hx-desc { font-size: 1.05rem; font-weight: 300; line-height: 1.75; color: rgba(0,0,0,0.65); max-width: 560px; margin: 0; }
  body.dark .hx-desc { color: rgba(232,232,232,0.68); }
  .hx-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  /* Imagen del hero con parallax (como elogia.net): el contenedor recorta y la
     imagen, un 30 % más alta, sube más despacio que la página al hacer scroll. */
  .hx-media { position: relative; width: 100%; height: 70vh; min-height: 420px; max-height: 720px; overflow: hidden; border-radius: 16px; border: 1px solid rgba(0,0,0,0.1); background: #efebe3; }
  body.dark .hx-media { border-color: rgba(255,255,255,0.1); background: #151510; }
  .hx-media picture { position: absolute; inset: 0; display: block; }
  .hx-media img { position: absolute; left: 0; top: 0; width: 100%; height: 130%; object-fit: cover; object-position: center 40%; will-change: transform; }
  .hx-media .hx-oscuro { display: none; }
  body.dark .hx-media .hx-claro { display: none; }
  body.dark .hx-media .hx-oscuro { display: block; }
  @media (prefers-reduced-motion: reduce) { .hx-media img { height: 100%; will-change: auto; } }
  @media (max-width: 640px) { .hx-media { height: 48vh; min-height: 280px; } }
  body.dark .hh-trust-label { color: rgba(232,232,232,0.45); border-top-color: rgba(255,255,255,0.1); }
  body.dark .hh-logos img { filter: invert(1); opacity: 0.7; }
  /* Banda de logos a todo el ancho, al pie del hero: cuatro copias en fila que se desplazan hacia la derecha
     un cuarto y vuelven a empezar sin salto. Cada copia abre con su hueco, así el primer logo nunca sale cortado. */
  .hh-trust { position: relative; z-index: 1; padding-bottom: 3rem; }
  .hh-trust-label { margin: 0 4vw 1.2rem; padding-top: 1.4rem; border-top: 1px solid rgba(0,0,0,0.08); font-size: 0.82rem; letter-spacing: 0; color: rgba(0,0,0,0.45); }
  .hh-logos { overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 5%, #000 95%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 5%, #000 95%, transparent 100%); }
  .hh-logos-track { display: flex; width: max-content; animation: hh-logos-ltr 30s linear infinite; }
  .hh-logos:hover .hh-logos-track { animation-play-state: paused; }
  .hh-logos-set { display: flex; align-items: center; gap: 5rem; padding-left: 5rem; flex-shrink: 0; }
  .hh-logos img { height: 44px; width: auto; opacity: 0.82; }
  @keyframes hh-logos-ltr { from { transform: translateX(-25%); } to { transform: translateX(0); } }
  @media (prefers-reduced-motion: reduce) {
    .hh-logos { margin: 0 4vw; -webkit-mask-image: none; mask-image: none; }
    .hh-logos-track { animation: none; width: auto; }
    .hh-logos-set { flex-wrap: wrap; gap: 1.2rem 1.6rem; padding-left: 0; flex-shrink: 1; }
    .hh-logos-set[aria-hidden] { display: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hx-inner > * { opacity: 0; animation: hx-in 0.8s cubic-bezier(.16,1,.3,1) forwards; }
    .hx-inner > *:nth-child(2) { animation-delay: 0.08s; } .hx-inner > *:nth-child(3) { animation-delay: 0.16s; }
  }
  @keyframes hx-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (max-width: 640px) {
    .hx { padding-top: 3rem; }
    .hx-title { letter-spacing: -0.035em; }
    .hh-trust-label { margin: 0 6vw 1rem; }
    .hh-logos-set { gap: 3.5rem; padding-left: 3.5rem; }
  }

  /* MANIFIESTO: frase + dos columnas */
  .hx-manifiesto { max-width: 1240px; margin: 0 auto; padding: 5rem 4vw 1rem; }
  .hx-manifiesto h2 { font-family: 'Poppins', sans-serif; font-size: clamp(1.8rem, 3.6vw, 2.9rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1.12; max-width: 980px; margin: 0 0 2.6rem; }
  .hx-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 4rem; }
  .hx-cols p { font-size: 0.98rem; font-weight: 300; line-height: 1.75; color: rgba(0,0,0,0.65); margin: 0; }
  body.dark .hx-cols p { color: rgba(232,232,232,0.65); }
  .hx-cols a { color: var(--blue); font-weight: 500; }
  body.dark .hx-cols a { color: var(--blue-light); }
  @media (max-width: 760px) { .hx-cols { grid-template-columns: 1fr; } }



  /* STATS — full-bleed dark band, one dominant number + two side stats */
  .stats-band { background: var(--black); padding: 7rem 4vw; transition: background var(--transition); }
  body.dark .stats-band { background: #050505; }
  .stats-band-inner {
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .stat-item--hero {
    gap: 1rem;
  }
  .stat-item--hero .stat-value {
    font-size: clamp(5rem, 13vw, 10rem);
    line-height: 0.88;
  }
  .stat-item--hero .stat-label {
    font-size: clamp(2.2rem, 3.4vw, 3.4rem);
    line-height: 1.45;
    max-width: 820px;
    margin-top: 0;
  }

  .stats-side {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    border-left: 1px solid rgba(255,255,255,0.15);
    padding-left: 4rem;
  }
  .stats-side .stat-item:nth-child(2) { transition-delay: 0.1s; }

  .stat-value {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--blue-light);
  }
  .stat-label {
    font-size: clamp(1.2rem, 1.8vw, 1.7rem);
    font-weight: 500;
    color: rgba(255,255,255,0.75);
    margin-top: 0;
    line-height: 1.25;
    max-width: 380px;
  }
  .stat-label-lead {
    display: block;
    font-size: 1.2em;
    font-weight: 700;
    color: rgba(255,255,255,0.95);
  }

  @media (max-width: 900px) {
    .stats-band-inner { grid-template-columns: 1fr; gap: 3rem; }
    .stats-side { border-left: none; padding-left: 0; border-top: 1px solid rgba(255,255,255,0.15); padding-top: 2.5rem; }
    .stat-item { flex-direction: column; align-items: flex-start; gap: 0; }
    .stat-item--hero .stat-label { margin-top: 1.2rem; }
    .stat-label { margin-top: 0.4rem; }
  }
</style>

<script>
  const statEls = document.querySelectorAll<HTMLElement>('.stat-item');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // El HTML ya trae el número real (contenido por defecto, visible sin JS
  // y tal cual lo indexan los buscadores). La animación es solo una mejora
  // progresiva: si corre, parte de 0 hacia ese mismo número real.
  const animateCount = (el: HTMLElement) => {
    const target = Number(el.dataset.count ?? '0');
    const numberEl = el.querySelector<HTMLElement>('.stat-number');
    if (!numberEl || prefersReducedMotion) return;
    numberEl.textContent = '0';
    const duration = 900;
    const start = performance.now();
    const step = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      numberEl.textContent = String(Math.round(progress * target));
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  if ('IntersectionObserver' in window && statEls.length) {
    const statObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            statObserver.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 }
    );
    statEls.forEach((el) => statObserver.observe(el));
  }
</script>
