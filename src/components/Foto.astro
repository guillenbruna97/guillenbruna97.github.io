---
// Foto real (sustituye a FotoPendiente): misma caja con la proporción pedida,
// recortada con object-fit y el foco de data/fotos.ts. Astro genera los tamaños.
import { Picture } from 'astro:assets';
import type { Foto } from '../data/fotos';
import { getLang } from '../i18n';

interface Props {
  foto: Foto;
  ratio?: string;
  /** Ancho máximo en pantalla, para elegir el tamaño servido. */
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}
const { foto, ratio = '4 / 3', sizes = '(max-width: 900px) 100vw, 600px', class: className, loading = 'lazy' } = Astro.props;
const lang = getLang(Astro.url.pathname);
const ancho = Math.min(foto.img.width, 2400);
---
<figure class:list={['foto', className]} style={`aspect-ratio: ${ratio};`}>
  <Picture
    src={foto.img}
    alt={foto.alt[lang]}
    widths={[480, 768, 1024, ancho].filter((w, i, a) => w <= ancho && a.indexOf(w) === i)}
    sizes={sizes}
    formats={['avif', 'webp']}
    quality={70}
    loading={loading}
    style={`object-position: ${foto.foco};`}
  />
</figure>

<style is:global>
  .foto { margin: 0; overflow: hidden; border-radius: 16px; background: #e9edf3; }
  body.dark .foto { background: #161b24; }
  .foto picture { display: block; width: 100%; height: 100%; }
  .foto img { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
