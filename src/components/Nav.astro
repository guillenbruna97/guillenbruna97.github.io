---
const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href.replace(/\/$/, ''));
};
---
<nav>
  <a href="/" class="logo-link">
    <img src="/isotipo.svg" alt="Guillén Bruna Tricas" class="logo-img" width="36" height="36" />
  </a>
  <ul class="nav-links" id="navLinks">
    <li><a href="/trabajo/" class={isActive('/trabajo/') ? 'active' : ''}>Casos reales</a></li>
    <li><a href="/sobre-mi/" class={isActive('/sobre-mi/') ? 'active' : ''}>Sobre mí</a></li>
    <li><a href="/articulos/" class={isActive('/articulos/') ? 'active' : ''}>Artículos</a></li>
    <li><a href="/contacto/" class={isActive('/contacto/') ? 'active' : ''}>Contacto</a></li>
  </ul>
  <div class="nav-right">
    <button class="hamburger" id="hamburger" aria-expanded="false" aria-controls="navLinks" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </button>
    <button class="toggle" id="themeToggle" aria-pressed="false" aria-label="Activar modo oscuro">
      <span class="toggle-dot"></span>
    </button>
  </div>
</nav>

<style is:global>
  .hamburger { display: none; }

  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 2rem;
    background: var(--white);
    border-bottom: 1px solid rgba(0,0,0,0.06);
    transition: background var(--transition), border-color var(--transition);
  }
  body.dark nav { background: var(--dark-bg); border-bottom-color: rgba(255,255,255,0.08); }

  .logo-link { display: flex; align-items: center; text-decoration: none; }
  .logo-img { height: 36px; width: auto; transition: opacity 0.2s; }
  .logo-img:hover { opacity: 0.75; }
  body.dark .logo-img {
    filter: brightness(0) saturate(100%) invert(47%) sepia(98%) saturate(400%) hue-rotate(180deg) brightness(120%);
  }

  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a {
    position: relative;
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.5);
    text-decoration: none;
    transition: color var(--transition);
  }
  body.dark .nav-links a { color: rgba(232,232,232,0.5); }
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .nav-links a:hover,
  .nav-links a.active { color: var(--blue); }
  body.dark .nav-links a:hover,
  body.dark .nav-links a.active { color: var(--blue-light); }
  .nav-links a:hover::after,
  .nav-links a.active::after { transform: scaleX(1); }

  .nav-right { display: flex; align-items: center; gap: 1rem; }

  .toggle {
    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: var(--off-white);
    border: 1px solid rgba(0,0,0,0.1);
    cursor: pointer;
    position: relative;
    flex-shrink: 0;
    transition: background var(--transition), border-color var(--transition);
  }
  body.dark .toggle { background: var(--dark-surface2); border-color: rgba(255,255,255,0.12); }

  .toggle-dot {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--blue);
    transition: transform var(--transition), background var(--transition);
  }
  body.dark .toggle-dot { transform: translateX(20px); background: var(--blue-light); }

  @media (max-width: 640px) {
    .hamburger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px;
    }
    .hamburger span {
      display: block;
      width: 22px;
      height: 2px;
      background: var(--black);
      border-radius: 2px;
      transition: background var(--transition);
    }
    body.dark .hamburger span { background: #e8e8e8; }

    .nav-links { display: none; }
    .nav-links.open {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--white);
      border-bottom: 1px solid rgba(0,0,0,0.06);
      padding: 1rem 2rem 1.5rem;
      gap: 1.2rem;
      z-index: 99;
    }
    body.dark .nav-links.open {
      background: var(--dark-bg);
      border-bottom-color: rgba(255,255,255,0.08);
    }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('navLinks');

  const setMenuOpen = (open: boolean) => {
    navLinks!.classList.toggle('open', open);
    hamburger!.setAttribute('aria-expanded', String(open));
    hamburger!.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  };

  hamburger!.addEventListener('click', () => setMenuOpen(!navLinks!.classList.contains('open')));
  document.addEventListener('click', (e) => {
    if (!hamburger!.contains(e.target as Node) && !navLinks!.contains(e.target as Node)) {
      setMenuOpen(false);
    }
  });

  const toggle = document.getElementById('themeToggle');
  const setThemeButtonState = (isDark: boolean) => {
    toggle!.setAttribute('aria-pressed', String(isDark));
    toggle!.setAttribute('aria-label', isDark ? 'Activar modo claro' : 'Activar modo oscuro');
  };
  // El body ya trae la clase "dark" correcta (o no) del script de tema que
  // corre antes en BaseLayout — aquí solo hace falta reflejar ese estado
  // real en el botón, no recalcularlo.
  setThemeButtonState(document.body.classList.contains('dark'));

  toggle!.addEventListener('click', () => {
    document.body.classList.toggle('dark');
    const isDark = document.body.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    setThemeButtonState(isDark);
  });

  // Si el visitante no ha fijado preferencia manual, BaseLayout sigue el
  // tema del sistema en tiempo real; este listener solo mantiene el botón
  // (aria-pressed/aria-label) sincronizado con ese cambio.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (localStorage.getItem('theme')) return;
    setThemeButtonState(document.body.classList.contains('dark'));
  });
</script>
