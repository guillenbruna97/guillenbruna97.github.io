---
import { RESOURCES } from '../consts';
import { AREAS } from '../data/areas';
import { AREAS_EN } from '../data/en/areas';
import { getLang, ui, enlace, destinoSelector } from '../i18n';

const pathname = Astro.url.pathname;
const lang = getLang(pathname);
const t = ui(lang).menu;
const areas = lang === 'en' ? AREAS_EN : AREAS;
const ir = (ruta: string) => enlace(lang, ruta);
const isActive = (href: string) => {
  if (href === '/' || href === '/en/') return pathname === href;
  return pathname.startsWith(href.replace(/\/$/, ''));
};
---
<nav>
  <a href={ir('/')} class="logo-link">
    <img src="/isotipo.svg" alt="Guillén Bruna Tricas" class="logo-img" width="36" height="36" />
  </a>
  <ul class="nav-links" id="navLinks">
    <li class="has-dropdown">
      <a href={ir('/servicios/')} class={isActive(ir('/servicios/')) ? 'active' : ''}>{t.servicios} <span class="chevron">▾</span></a>
      <ul class="dropdown-menu">
        {areas.map((s) => (
          <li>
            <a href={ir(`/servicios/${s.slug}/`)} class={isActive(ir(`/servicios/${s.slug}/`)) ? 'active' : ''}>{s.name}</a>
          </li>
        ))}
      </ul>
    </li>
    <li><a href={ir('/trabajo/')} class={isActive(ir('/trabajo/')) ? 'active' : ''}>{t.casos}</a></li>
    <li><a href={ir('/quienes-somos/')} class={isActive(ir('/quienes-somos/')) ? 'active' : ''}>{t.quienes}</a></li>
    <li class="has-dropdown">
      <a href="/recursos/" class={isActive('/recursos/') || isActive('/articulos/') ? 'active' : ''}>{t.recursos} <span class="chevron">▾</span></a>
      <ul class="dropdown-menu">
        {RESOURCES.map((r) => (
          <li>
            <a href={r.href} class={isActive(r.href) ? 'active' : ''}>{t.nombresRecursos[r.href] ?? r.name}</a>
          </li>
        ))}
      </ul>
    </li>
    <li><a href={ir('/contacto/')} class={isActive(ir('/contacto/')) ? 'active' : ''}>{t.contacto}</a></li>
    <li class="nav-reco-item"><a href={ir('/recomendador/')} class:list={['nav-reco', { active: isActive(ir('/recomendador/')) }]}>{t.reco}</a></li>
  </ul>
  <div class="nav-right">
    <button class="hamburger" id="hamburger" aria-expanded="false" aria-controls="navLinks" aria-label={t.abrir} data-abrir={t.abrir} data-cerrar={t.cerrar}>
      <span></span><span></span><span></span>
    </button>
    <a href={destinoSelector(pathname)} class="idioma" id="idioma" data-lang={lang === 'en' ? 'es' : 'en'} hreflang={lang === 'en' ? 'es' : 'en'} lang={lang === 'en' ? 'es' : 'en'} aria-label={t.idioma}>{t.idiomaCorto}</a>
    <button class="toggle" id="themeToggle" aria-pressed="false" aria-label={t.oscuro} data-oscuro={t.oscuro} data-claro={t.claro}>
      <span class="toggle-dot"></span>
    </button>
  </div>
</nav>

<style is:global>
  /* Recomendador destacado (inspirado en cafeselcriollo.com): píldora con borde
     en degradado de los dos azules de la marca. El brillo del borde y un halo
     muy suave giran despacio alrededor (2026-10-25); quieto con movimiento reducido. */
  @property --reco-giro { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  .nav-links a.nav-reco {
    display: inline-block;
    padding: 0.45rem 1rem;
    border: 1.5px solid transparent;
    border-radius: 999px;
    color: var(--black);
    font-weight: 500;
    line-height: 1.2;
    background: linear-gradient(var(--white), var(--white)) padding-box, conic-gradient(from var(--reco-giro), #004aad, #95c0fa 25%, #004aad 50%, #95c0fa 75%, #004aad) border-box;
    box-shadow: 0 0 14px rgba(0, 74, 173, 0.1);
    animation: reco-giro 7s linear infinite;
    transition: box-shadow 0.3s ease, color 0.3s ease;
  }
  /* Halo que gira detrás de la píldora: un arco azul claro difuminado. */
  .nav-links a.nav-reco::before {
    content: '';
    position: absolute;
    inset: -3px;
    z-index: -1;
    border-radius: inherit;
    background: conic-gradient(from var(--reco-giro), transparent 0deg, rgba(0, 74, 173, 0.45) 60deg, transparent 140deg, transparent 180deg, rgba(149, 192, 250, 0.6) 240deg, transparent 320deg);
    filter: blur(7px);
    opacity: 0.55;
    animation: reco-giro 7s linear infinite;
    pointer-events: none;
  }
  @keyframes reco-giro { to { --reco-giro: 360deg; } }
  @media (prefers-reduced-motion: reduce) { .nav-links a.nav-reco, .nav-links a.nav-reco::before { animation: none; } }
  .nav-links a.nav-reco::after { display: none; }
  .nav-links a.nav-reco:hover, .nav-links a.nav-reco.active { color: var(--blue); box-shadow: 0 0 20px rgba(0, 74, 173, 0.2); }
  body.dark .nav-links a.nav-reco { color: #e8e8e8; background: linear-gradient(var(--dark-bg), var(--dark-bg)) padding-box, conic-gradient(from var(--reco-giro), #95c0fa, #004aad 25%, #95c0fa 50%, #004aad 75%, #95c0fa) border-box; box-shadow: 0 0 14px rgba(149, 192, 250, 0.12); }
  body.dark .nav-links a.nav-reco:hover, body.dark .nav-links a.nav-reco.active { color: var(--blue-light); box-shadow: 0 0 22px rgba(149, 192, 250, 0.26); }

  .hamburger { display: none; }

  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 2rem;
    background: var(--white);
    border-bottom: 1px solid rgba(0,0,0,0.06);
    transition: background var(--transition), border-color var(--transition);
  }
  body.dark nav { background: var(--dark-bg); border-bottom-color: rgba(255,255,255,0.08); }

  .logo-link { display: flex; align-items: center; text-decoration: none; }
  .logo-img { height: 36px; width: auto; transition: opacity 0.2s; }
  .logo-img:hover { opacity: 0.75; }
  body.dark .logo-img {
    filter: brightness(0) saturate(100%) invert(47%) sepia(98%) saturate(400%) hue-rotate(180deg) brightness(120%);
  }

  /* Centrados en vertical para que la píldora del recomendador quede alineada con el resto,
     sin saltos de línea y con hueco que encoge con la ventana. */
  .nav-links { display: flex; align-items: center; gap: clamp(1.1rem, 2.2vw, 2rem); list-style: none; margin: 0; padding: 0; }
  .nav-links a {
    position: relative;
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0;
    white-space: nowrap;
    color: rgba(0,0,0,0.5);
    text-decoration: none;
    transition: color var(--transition);
  }
  body.dark .nav-links a { color: rgba(232,232,232,0.5); }
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .nav-links a:hover,
  .nav-links a.active { color: var(--blue); }
  body.dark .nav-links a:hover,
  body.dark .nav-links a.active { color: var(--blue-light); }
  .nav-links a:hover::after,
  .nav-links a.active::after { transform: scaleX(1); }

  .has-dropdown { position: relative; }
  .chevron { display: inline-block; font-size: 0.65em; margin-left: 0.15rem; transition: transform 0.2s ease; }
  .has-dropdown:hover .chevron,
  .has-dropdown:focus-within .chevron { transform: rotateX(180deg); }

  .dropdown-menu {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    position: absolute;
    top: 100%;
    left: 0;
    padding-top: 1rem;
    min-width: 260px;
  }
  .dropdown-menu li {
    background: var(--white);
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    transition: background var(--transition), border-color var(--transition);
  }
  body.dark .dropdown-menu li { background: var(--dark-bg); border-color: rgba(255,255,255,0.1); }
  .dropdown-menu li + li { margin-top: 0.4rem; }
  .has-dropdown:hover .dropdown-menu,
  .has-dropdown:focus-within .dropdown-menu { display: block; }

  .dropdown-menu a {
    display: block;
    padding: 0.65rem 0.9rem;
    border-radius: 8px;
    font-size: 0.76rem;
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    white-space: nowrap;
  }
  .dropdown-menu a::after { content: none; }
  .dropdown-menu a:hover,
  .dropdown-menu a.active { background: var(--off-white); color: var(--blue); }
  body.dark .dropdown-menu a:hover,
  body.dark .dropdown-menu a.active { background: var(--dark-surface); color: var(--blue-light); }

  .nav-right { display: flex; align-items: center; gap: 1rem; }

  /* Selector de idioma: solo el código del otro idioma, sin banderas. */
  .idioma {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: rgba(0,0,0,0.55);
    text-decoration: none;
    padding: 0.35rem 0.5rem;
    border-radius: 6px;
    transition: color var(--transition), background var(--transition);
  }
  .idioma:hover { color: var(--blue); background: var(--off-white); }
  body.dark .idioma { color: rgba(232,232,232,0.6); }
  body.dark .idioma:hover { color: var(--blue-light); background: var(--dark-surface2); }

  .toggle {
    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: var(--off-white);
    border: 1px solid rgba(0,0,0,0.1);
    cursor: pointer;
    position: relative;
    flex-shrink: 0;
    transition: background var(--transition), border-color var(--transition);
  }
  body.dark .toggle { background: var(--dark-surface2); border-color: rgba(255,255,255,0.12); }

  .toggle-dot {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--blue);
    transition: transform var(--transition), background var(--transition);
  }
  body.dark .toggle-dot { transform: translateX(20px); background: var(--blue-light); }

  @media (max-width: 900px) {
    .hamburger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px;
    }
    .hamburger span {
      display: block;
      width: 22px;
      height: 2px;
      background: var(--black);
      border-radius: 2px;
      transition: background var(--transition);
    }
    body.dark .hamburger span { background: #e8e8e8; }

    .nav-links { display: none; }
    .nav-links.open {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--white);
      border-bottom: 1px solid rgba(0,0,0,0.06);
      align-items: flex-start;
      padding: 1rem 2rem 1.5rem;
      gap: 1.2rem;
      z-index: 99;
    }
    body.dark .nav-links.open {
      background: var(--dark-bg);
      border-bottom-color: rgba(255,255,255,0.08);
    }

    .chevron { display: none; }
    .dropdown-menu {
      display: block;
      position: static;
      padding: 0.6rem 0 0 1rem;
      min-width: 0;
    }
    .dropdown-menu li {
      background: none;
      border: none;
      box-shadow: none;
    }
    .dropdown-menu li + li { margin-top: 0; }
    .dropdown-menu a { padding: 0.5rem 0; white-space: normal; }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('navLinks');

  const setMenuOpen = (open: boolean) => {
    navLinks!.classList.toggle('open', open);
    hamburger!.setAttribute('aria-expanded', String(open));
    hamburger!.setAttribute('aria-label', (open ? hamburger!.dataset.cerrar : hamburger!.dataset.abrir) ?? '');
  };

  hamburger!.addEventListener('click', () => setMenuOpen(!navLinks!.classList.contains('open')));
  document.addEventListener('click', (e) => {
    if (!hamburger!.contains(e.target as Node) && !navLinks!.contains(e.target as Node)) {
      setMenuOpen(false);
    }
  });

  const toggle = document.getElementById('themeToggle');
  const setThemeButtonState = (isDark: boolean) => {
    toggle!.setAttribute('aria-pressed', String(isDark));
    toggle!.setAttribute('aria-label', (isDark ? toggle!.dataset.claro : toggle!.dataset.oscuro) ?? '');
  };
  // El body ya trae la clase "dark" correcta (o no) del script de tema que
  // corre antes en BaseLayout — aquí solo hace falta reflejar ese estado
  // real en el botón, no recalcularlo.
  setThemeButtonState(document.body.classList.contains('dark'));

  toggle!.addEventListener('click', () => {
    document.body.classList.toggle('dark');
    const isDark = document.body.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    setThemeButtonState(isDark);
  });

  // El selector recuerda el idioma elegido (sin redirigir nunca por su cuenta).
  document.getElementById('idioma')?.addEventListener('click', (e) => {
    try { localStorage.setItem('lang', (e.currentTarget as HTMLElement).dataset.lang ?? ''); } catch { /* sin almacenamiento */ }
  });

  // Si el visitante no ha fijado preferencia manual, BaseLayout sigue el
  // tema del sistema en tiempo real; este listener solo mantiene el botón
  // (aria-pressed/aria-label) sincronizado con ese cambio.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (localStorage.getItem('theme')) return;
    setThemeButtonState(document.body.classList.contains('dark'));
  });
</script>
