---
import { BOOKING_URL, MAILTO_URL } from '../consts';

interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---
<div class="contact-block">
  <div class="contact-left">
    <p class="contact-title" set:html={title}></p>
    {subtitle && <p class="contact-sub">{subtitle}</p>}
  </div>
  <div class="contact-actions">
    <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn-contact">Reservar llamada</a>
    <a href={MAILTO_URL} class="btn-contact btn-contact--ghost">Escríbeme</a>
  </div>
</div>

<style is:global>
  .contact-block {
    background: var(--blue);
    padding: 4rem 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background var(--transition);
  }
  body.dark .contact-block { background: var(--dark-surface); }

  .contact-left { max-width: 420px; }

  .contact-title {
    font-size: 1.9rem;
    font-weight: 500;
    color: var(--white);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }
  body.dark .contact-title { color: #e8e8e8; }

  .contact-sub {
    font-size: 0.85rem;
    font-weight: 300;
    color: rgba(255,255,255,0.75);
  }
  body.dark .contact-sub { color: rgba(232,232,232,0.6); }

  /* Hueco a la derecha para que la barra «Síguenos» (fija, a partir de 900px) no tape los botones. */
  @media (min-width: 901px) { .contact-block { padding-right: 96px; } }
  .contact-actions { display: flex; align-items: center; gap: 0.9rem; flex-shrink: 0; }

  /* Forma de los botones en global.css (BOTONES). Aquí solo los colores sobre la banda azul. */
  .btn-contact { white-space: nowrap; flex-shrink: 0; }
  .btn-contact:not(.btn-contact--ghost) { background: var(--white); color: var(--blue); }
  .btn-contact:not(.btn-contact--ghost):hover { background: #0a0a0a; color: var(--white); }
  body.dark .btn-contact:not(.btn-contact--ghost) { background: var(--blue-light); color: #0a0a0a; }
  body.dark .btn-contact:not(.btn-contact--ghost):hover { background: #f6f6f6; color: #0a0a0a; }
  /* Relieve del secundario adaptado a la banda azul. */
  .btn-contact--ghost { color: var(--white); filter: drop-shadow(-4px -4px 9px rgba(255,255,255,0.1)) drop-shadow(6px 8px 14px rgba(0,0,0,0.2)); }
  .btn-contact--ghost::before { background: linear-gradient(150deg, #165fc2 0%, #00429a 100%); }
  .btn-contact--ghost::after { background: linear-gradient(150deg, #0046a3 0%, #0f55b3 100%); }
  .btn-contact--ghost:hover { color: var(--white); filter: drop-shadow(-2px -2px 3px rgba(255,255,255,0.1)) drop-shadow(2px 3px 5px rgba(0,0,0,0.25)); }
  body.dark .btn-contact--ghost { color: #e8e8e8; filter: drop-shadow(-4px -4px 7px rgba(255,255,255,0.05)) drop-shadow(5px 6px 10px rgba(0,0,0,0.6)); }
  body.dark .btn-contact--ghost::before { background: linear-gradient(150deg, #2a2f39 0%, #14171d 100%); }
  body.dark .btn-contact--ghost::after { background: linear-gradient(150deg, #16191f 0%, #242934 100%); }

  /* En móvil los dos botones (nowrap) no caben en fila dentro de 375px y
     provocaban scroll horizontal en toda la web: van apilados a todo el ancho. */
  @media (max-width: 640px) {
    .contact-block { flex-direction: column; gap: 2rem; align-items: flex-start; padding: 3.5rem 1.5rem; }
    .contact-actions { width: 100%; flex-direction: column; align-items: stretch; }
    .btn-contact:not(.btn-contact--ghost) { justify-content: center; }

  }
</style>
