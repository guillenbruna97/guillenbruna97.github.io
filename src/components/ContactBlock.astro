---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---
<div class="contact-block">
  <div class="contact-left">
    <p class="contact-title" set:html={title}></p>
    {subtitle && <p class="contact-sub">{subtitle}</p>}
  </div>
  <div class="contact-actions">
    <a href="https://cal.com/guillen-bruna-tricas/15min" target="_blank" rel="noopener noreferrer" class="btn-contact">Reservar llamada →</a>
    <a href="mailto:guillenbrunatricas@gmail.com" class="btn-contact btn-contact--ghost">Escríbeme</a>
  </div>
</div>

<style is:global>
  .contact-block {
    background: var(--blue);
    padding: 4rem 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background var(--transition);
  }
  body.dark .contact-block { background: var(--dark-surface); }

  .contact-left { max-width: 420px; }

  .contact-title {
    font-size: 1.9rem;
    font-weight: 800;
    color: var(--white);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }
  body.dark .contact-title { color: #e8e8e8; }

  .contact-sub {
    font-size: 0.85rem;
    font-weight: 300;
    color: rgba(255,255,255,0.75);
  }
  body.dark .contact-sub { color: rgba(232,232,232,0.6); }

  .contact-actions { display: flex; align-items: center; gap: 0.9rem; flex-shrink: 0; }

  .btn-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--white);
    color: var(--blue);
    font-family: 'Poppins', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.85rem 1.8rem;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid transparent;
    flex-shrink: 0;
    letter-spacing: 0.04em;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--transition), color var(--transition), border-color var(--transition), transform 0.15s ease;
  }
  .btn-contact:hover { background: var(--off-white); transform: translateY(-1px); }
  body.dark .btn-contact { background: var(--blue-light); color: var(--dark-bg); }
  body.dark .btn-contact:hover { background: #7ab0f0; }

  .btn-contact--ghost {
    background: transparent;
    color: var(--white);
    border-color: rgba(255,255,255,0.4);
  }
  .btn-contact--ghost:hover { background: rgba(255,255,255,0.1); color: var(--white); }
  body.dark .btn-contact--ghost { background: transparent; color: #e8e8e8; border-color: rgba(232,232,232,0.3); }
  body.dark .btn-contact--ghost:hover { border-color: var(--blue-light); color: var(--blue-light); background: transparent; }

  @media (max-width: 640px) {
    .contact-block { flex-direction: column; gap: 2rem; align-items: flex-start; }
    .contact-actions { width: 100%; }
    .btn-contact { flex: 1; justify-content: center; }
  }
</style>
