---
// Preguntas frecuentes visibles + JSON-LD FAQPage con el mismo texto (Google
// exige que el schema coincida con lo que ve el usuario). Lo usan las páginas
// de servicio y los artículos. Para GEO: respuestas autocontenidas de 40-80
// palabras con el dato en la primera frase, que es lo que extraen los motores
// de IA al citar.
export interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
<div class="faq-list">
  {faqs.map((faq) => (
    <details class="faq-item">
      <summary>{faq.question}</summary>
      <p>{faq.answer}</p>
    </details>
  ))}
</div>

<style is:global>
  .faq-list { display: flex; flex-direction: column; gap: 0.7rem; max-width: 720px; }
  .faq-item {
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 10px;
    padding: 1rem 1.2rem;
    transition: border-color var(--transition), background var(--transition);
  }
  body.dark .faq-item { border-color: rgba(255,255,255,0.12); }
  .faq-item[open] { background: rgba(0,0,0,0.02); }
  body.dark .faq-item[open] { background: rgba(255,255,255,0.03); }
  .faq-item summary {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--black);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    transition: color var(--transition);
  }
  body.dark .faq-item summary { color: #e8e8e8; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+';
    flex: none;
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    color: var(--blue);
    transition: transform 0.2s ease, color var(--transition);
  }
  body.dark .faq-item summary::after { color: var(--blue-light); }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item summary:hover { color: var(--blue); }
  body.dark .faq-item summary:hover { color: var(--blue-light); }
  .faq-item p {
    font-size: 0.88rem;
    font-weight: 300;
    color: rgba(0,0,0,0.7);
    line-height: 1.7;
    margin: 0.8rem 0 0;
    transition: color var(--transition);
  }
  body.dark .faq-item p { color: rgba(232,232,232,0.7); }
</style>
