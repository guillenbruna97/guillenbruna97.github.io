---
// Tarjeta de artículo (2026-10-25): imagen con esquinas redondeadas, categoría
// en gris, título y entradilla, sin caja alrededor. La usan /articulos/, las
// categorías, /recursos/ y los relacionados de cada artículo.
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { getArticleImage } from '../utils/article-images';
import { displayTag } from '../utils/articles';

interface Props {
  entry: CollectionEntry<'articulos'>;
  /** Versión grande, imagen a la izquierda y texto a la derecha. */
  destacado?: boolean;
  nivel?: 'h2' | 'h3';
}
const { entry, destacado = false, nivel = 'h2' } = Astro.props;
const Titulo = nivel;
const img = getArticleImage(entry.data.image);
const href = `/articulos/${entry.id}/`;
const fecha = entry.data.date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---
<article class:list={['ac', { 'ac--destacado': destacado }]}>
  {entry.data.image && (
    <a href={href} class="ac-media" tabindex="-1" aria-hidden="true">
      {img ? (
        <Picture src={img} alt="" width={1376} height={768} widths={[400, 800, 1376]} sizes={destacado ? '(max-width: 900px) 100vw, 60vw' : '(max-width: 640px) 100vw, 33vw'} formats={['avif', 'webp']} fallbackFormat="jpg" quality={60} loading="lazy" />
      ) : (
        <img src={entry.data.image} alt="" width="1376" height="768" loading="lazy" decoding="async" />
      )}
    </a>
  )}
  <div class="ac-texto">
    <p class="ac-meta">{displayTag(entry.data.tag)}<span>{fecha}</span></p>
    <Titulo class="ac-titulo"><a href={href}>{entry.data.title}</a></Titulo>
    <p class="ac-extracto">{entry.data.excerpt}</p>
  </div>
</article>

<style is:global>
  .ac { display: flex; flex-direction: column; gap: 1.1rem; }
  .ac-media { display: block; border-radius: 16px; overflow: hidden; aspect-ratio: 16 / 9; background: var(--off-white); }
  body.dark .ac-media { background: #121419; }
  .ac-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .ac:hover .ac-media img { transform: scale(1.03); }
  .ac-meta { font-size: 0.8rem; color: rgba(0,0,0,0.5); margin: 0 0 0.5rem; display: flex; flex-wrap: wrap; gap: 0.2rem 1rem; }
  body.dark .ac-meta { color: rgba(232,232,232,0.5); }
  .ac-titulo { font-size: 1.2rem; line-height: 1.25; margin: 0 0 0.6rem; }
  .ac-titulo a { color: inherit; text-decoration: none; }
  .ac-titulo a:hover { color: var(--blue); }
  body.dark .ac-titulo a:hover { color: var(--blue-light); }
  .ac-extracto { font-size: 0.92rem; font-weight: 300; line-height: 1.65; color: rgba(0,0,0,0.62); margin: 0; }
  body.dark .ac-extracto { color: rgba(232,232,232,0.62); }
  .ac--destacado { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 2rem 3.5rem; align-items: center; }
  .ac--destacado .ac-titulo { font-size: clamp(1.6rem, 2.8vw, 2.4rem); line-height: 1.12; }
  .ac--destacado .ac-extracto { font-size: 1rem; }
  @media (max-width: 900px) { .ac--destacado { grid-template-columns: 1fr; } }
</style>
