---
// Cabecera de página con el lenguaje aprobado en la home (2026-10-25): migas
// opcionales, H1 grande e intro. Se usa en Recursos, artículos y minijuegos.
import { getLang } from '../i18n';
interface Props {
  titulo: string;
  intro?: string;
  migas?: { href: string; texto: string }[];
}
const { titulo, intro, migas } = Astro.props;
---
<header class="cp">
  {migas && migas.length > 0 && (
    <div class="cp-migas" role="navigation" aria-label={getLang(Astro.url.pathname) === "en" ? "Breadcrumbs" : "Migas de pan"}>
      {migas.map((m, i) => <>{i > 0 && <span aria-hidden="true">/</span>}<a href={m.href}>{m.texto}</a></>)}
    </div>
  )}
  <h1>{titulo}</h1>
  {intro && <p class="cp-intro">{intro}</p>}
  <slot />
</header>

<style is:global>
  .cp { max-width: 1240px; margin: 0 auto; padding: 4rem 4vw 3rem; }
  .cp-migas { display: flex; gap: 0.5rem; font-size: 0.82rem; color: rgba(0,0,0,0.5); margin-bottom: 1.8rem; }
  body.dark .cp-migas { color: rgba(232,232,232,0.5); }
  .cp-migas a { color: inherit; text-decoration: none; }
  .cp-migas a:hover { color: var(--blue); }
  .cp h1 { font-size: clamp(2.4rem, 5.6vw, 4.8rem); max-width: 1000px; margin: 0 0 1.4rem; }
  .cp-intro { font-size: 1.05rem; font-weight: 300; line-height: 1.75; color: rgba(0,0,0,0.65); max-width: 680px; margin: 0; }
  body.dark .cp-intro { color: rgba(232,232,232,0.68); }
</style>
