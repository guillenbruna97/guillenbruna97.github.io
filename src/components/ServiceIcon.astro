---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---
{slug === 'pipeline' && (
  <svg class="service-icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M8 10h32l-11 14v10l-10 4V24L8 10z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
    <path d="M20 26c-3 1-6 3-7 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
    <circle cx="11.5" cy="34" r="1.4" fill="currentColor" />
    <circle cx="9" cy="39" r="1.1" fill="currentColor" />
  </svg>
)}
{slug === 'gtm-icp' && (
  <svg class="service-icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <circle cx="20" cy="24" r="12" stroke="currentColor" stroke-width="1.6" />
    <circle cx="20" cy="24" r="6.5" stroke="currentColor" stroke-width="1.4" />
    <circle cx="20" cy="24" r="1.6" fill="currentColor" />
    <path d="M31 15l9-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    <path d="M33 24h9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    <path d="M31 33l9 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  </svg>
)}
{slug === 'posicionamiento' && (
  <svg class="service-icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M6 12h15a4 4 0 014 4v6a4 4 0 01-4 4H14l-5 4v-4a4 4 0 01-3-4v-6a4 4 0 014-4z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" opacity="0.55" />
    <path d="M22 20h14a4 4 0 014 4v7a4 4 0 01-4 4h-3v4l-6-4h-5a4 4 0 01-4-4v-2" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
  </svg>
)}
{slug === 'mentoria-comunicacion' && (
  <svg class="service-icon" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="18" y="6" width="12" height="18" rx="6" stroke="currentColor" stroke-width="1.6" />
    <path d="M12 21a12 12 0 0024 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    <path d="M24 33v7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    <path d="M16 40h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    <path d="M35 16h7M36.5 21h5.5M35 26h7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
  </svg>
)}

<style is:global>
  .service-icon {
    width: 30px;
    height: 30px;
    color: var(--blue);
    transition: color var(--transition);
  }
  body.dark .service-icon { color: var(--blue-light); }
</style>
