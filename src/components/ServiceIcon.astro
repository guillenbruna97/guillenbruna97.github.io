---
// Iconos dibujados a rotulador (generados con Gemini y remapeados a --blue /
// --blue-light). Fondo CSS en vez de <img>: son decorativos (el h2 de la
// tarjeta ya nombra el servicio) y así solo se descarga la versión del tema
// activo. La versión -dark invierte los dos azules para mantener contraste.
// WebP a 144px = 2x del tamaño visible.
interface Props {
  slug: string;
}
const { slug } = Astro.props;
const ICONS = ['pipeline', 'gtm-icp', 'posicionamiento', 'mentoria-comunicacion'];
---
{ICONS.includes(slug) && (
  <span class="service-icon" aria-hidden="true" style={`--icon: url(/images/iconos/${slug}.webp); --icon-dark: url(/images/iconos/${slug}-dark.webp);`}></span>
)}

<style is:global>
  .service-icon {
    display: block;
    width: 64px;
    height: 64px;
    background: var(--icon) center / contain no-repeat;
  }
  body.dark .service-icon { background-image: var(--icon-dark); }
</style>
