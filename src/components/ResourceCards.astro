---
// Rejilla de tarjetas de /recursos/. Los estilos van
// dentro del componente para que viajen con él a cualquier página que lo
// use (un <style is:global> de página solo se empaqueta en esa página).
interface Card {
  href: string;
  name: string;
  tagline: string;
  cta: string;
}
interface Props {
  cards: Card[];
}
const { cards } = Astro.props;
---
<div class="resource-grid">
  {cards.map((card, i) => (
    <a href={card.href} class="resource-card">
      <span class="resource-number">{String(i + 1).padStart(2, '0')}</span>
      <h2>{card.name}</h2>
      <p>{card.tagline}</p>
      <span class="resource-link">{card.cta}</span>
    </a>
  ))}
</div>

<style is:global>
  .resource-grid {
    max-width: 900px;
    margin: 0 auto;
    padding: 1rem 2rem 3rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .resource-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 8px;
    background: var(--white);
    text-decoration: none;
    transition: border-color var(--transition), background var(--transition), transform 0.15s ease;
  }
  body.dark .resource-card { border-color: rgba(255,255,255,0.12); background: var(--dark-bg); }
  .resource-card:hover { border-color: var(--blue); transform: translateY(-2px); }
  body.dark .resource-card:hover { border-color: var(--blue-light); }

  .resource-number {
    font-family: 'Poppins', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--blue);
    margin-bottom: 0.9rem;
    transition: color var(--transition);
  }
  body.dark .resource-number { color: var(--blue-light); }

  .resource-card h2 {
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--black);
    margin-bottom: 0.6rem;
    transition: color var(--transition);
  }
  body.dark .resource-card h2 { color: #e8e8e8; }

  .resource-card p {
    font-size: 0.88rem;
    font-weight: 300;
    color: rgba(0,0,0,0.6);
    line-height: 1.7;
    margin-bottom: 1.2rem;
    flex-grow: 1;
    transition: color var(--transition);
  }
  body.dark .resource-card p { color: rgba(232,232,232,0.6); }

  .resource-link {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--blue);
    transition: color var(--transition);
  }
  body.dark .resource-link { color: var(--blue-light); }
  .resource-card:hover .resource-link { text-decoration: underline; }

  @media (max-width: 640px) {
    .resource-grid { grid-template-columns: 1fr; padding: 1rem 1.5rem 2rem; }
  }
</style>
