---
import { LINKEDIN_URL, SITE_NAME, CONTACT_EMAIL } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  ogType?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  // Antes por defecto era /isotipo.svg: Facebook/LinkedIn/X/WhatsApp no
  // renderizan SVG como og:image de forma fiable, así que cualquier página
  // sin imagen propia (home, listados, contacto, privacidad...) compartía
  // una tarjeta social en blanco. og-default.jpg es un retrato real en el
  // ratio 1200x630 que todas esas páginas heredan ahora.
  image = '/og-default.jpg',
  url = Astro.url.href,
  ogType = 'website',
  noindex = false,
} = Astro.props;
const imageUrl = image.startsWith('http') ? image : `https://gbtconsultoria.com${image}`;

// La firma (GBT Consultoría) es la entidad principal y Guillén Bruna Tricas su
// fundador, con el cargo literal que usa en todas partes (decidido 2026-10-22).
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://gbtconsultoria.com/#organizacion',
  name: SITE_NAME,
  url: 'https://gbtconsultoria.com/',
  logo: 'https://gbtconsultoria.com/isotipo.svg',
  image: 'https://gbtconsultoria.com/guillen-chaqueta.jpg',
  email: CONTACT_EMAIL,
  knowsAbout: [
    'Estrategia de marca',
    'Identidad visual y rebranding',
    'Diseño y desarrollo web',
    'Posicionamiento SEO',
    'Posicionamiento en buscadores de IA (GEO)',
    'Google Ads',
    'Meta Ads',
    'Gestión de redes sociales',
    'Eventos y activaciones de marca',
  ],
  description: 'Consultoría de estrategia de marketing y marca en Zaragoza. Una red de especialistas senior dirigida por Guillén Bruna Tricas que lleva tu marketing de principio a fin: estrategia, marca, web, SEO y GEO, publicidad online, redes sociales y eventos.',
  areaServed: [
    { '@type': 'City', name: 'Zaragoza' },
    { '@type': 'AdministrativeArea', name: 'Aragón' },
    { '@type': 'Country', name: 'España' },
  ],
  founder: {
    '@type': 'Person',
    name: 'Guillén Bruna Tricas',
    url: 'https://gbtconsultoria.com/quienes-somos/#guillen',
    image: 'https://gbtconsultoria.com/guillen-chaqueta.jpg',
    jobTitle: 'Consultor de estrategia de marketing y marca',
    // El cargo se mantiene corto y idéntico en web, LinkedIn, redes y vídeos;
    // el resto de especialidades se declaran aquí para que buscadores e IA las asocien.
    '@id': 'https://gbtconsultoria.com/#guillen',
    knowsAbout: [
      'Estrategia de marketing',
      'Estrategia de marca',
      'Posicionamiento de producto',
      'Estrategia go-to-market',
      'Perfil de cliente ideal (ICP)',
      'Marketing B2B',
      'Comunicación ejecutiva',
    ],
    sameAs: [LINKEDIN_URL],
  },
  sameAs: [LINKEDIN_URL],
};
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
{noindex && <meta name="robots" content="noindex,follow" />}

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content="es_ES" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
