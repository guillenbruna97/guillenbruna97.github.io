---
import { LINKEDIN_URL } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  ogType?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  // Antes por defecto era /isotipo.svg: Facebook/LinkedIn/X/WhatsApp no
  // renderizan SVG como og:image de forma fiable, así que cualquier página
  // sin imagen propia (home, listados, contacto, privacidad...) compartía
  // una tarjeta social en blanco. og-default.jpg es un retrato real en el
  // ratio 1200x630 que todas esas páginas heredan ahora.
  image = '/og-default.jpg',
  url = Astro.url.href,
  ogType = 'website',
  noindex = false,
} = Astro.props;
const imageUrl = image.startsWith('http') ? image : `https://guillenbruna97.github.io${image}`;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Guillén Bruna Tricas — Consultor de estrategia de marketing y marca',
  url: 'https://guillenbruna97.github.io/',
  image: 'https://guillenbruna97.github.io/guillen-chaqueta.jpg',
  description: 'Asesoro a empresas y a directivos que quieren comunicar con autoridad y posicionarse como referentes en su sector.',
  areaServed: [
    { '@type': 'City', name: 'Zaragoza' },
    { '@type': 'AdministrativeArea', name: 'Aragón' },
    { '@type': 'Country', name: 'España' },
  ],
  founder: {
    '@type': 'Person',
    name: 'Guillén Bruna Tricas',
    url: 'https://guillenbruna97.github.io/sobre-mi/',
    image: 'https://guillenbruna97.github.io/guillen-chaqueta.jpg',
    jobTitle: 'Consultor de estrategia de marketing y marca',
    sameAs: [LINKEDIN_URL],
  },
  sameAs: [LINKEDIN_URL],
};
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
{noindex && <meta name="robots" content="noindex,follow" />}

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content="es_ES" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
