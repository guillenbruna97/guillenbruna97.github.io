---
import { LINKEDIN_URL } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  ogType?: string;
}
const {
  title,
  description,
  image = '/isotipo.svg',
  url = Astro.url.href,
  ogType = 'website',
} = Astro.props;
const imageUrl = image.startsWith('http') ? image : `https://guillenbruna97.github.io${image}`;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Guillén Bruna Tricas — Estrategia de marketing y marca',
  url: 'https://guillenbruna97.github.io/',
  image: 'https://guillenbruna97.github.io/guillen-chaqueta.png',
  description: 'Asesoro a empresas y a directivos que quieren comunicar con autoridad y posicionarse como referentes en su sector.',
  areaServed: 'ES',
  founder: {
    '@type': 'Person',
    name: 'Guillén Bruna Tricas',
    url: 'https://guillenbruna97.github.io/sobre-mi/',
    image: 'https://guillenbruna97.github.io/guillen-chaqueta.png',
    jobTitle: 'Asesor de marketing y estrategia de marca',
    sameAs: [LINKEDIN_URL],
  },
  sameAs: [LINKEDIN_URL],
};
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content="es_ES" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
