---
// Barra «Síguenos» fija en el borde derecho de todas las páginas (inspirada en
// cyberclick.es). Por ahora solo LinkedIn; se añaden redes según se abran.
// En pantallas estrechas no se muestra: taparía el contenido y el pie ya
// enlaza LinkedIn.
import { LINKEDIN_URL } from '../consts';
const REDES = [
  { nombre: 'LinkedIn', url: LINKEDIN_URL, icono: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.8v1.5h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1v5.45h-4v-4.83c0-1.15-.02-2.63-1.6-2.63-1.6 0-1.85 1.25-1.85 2.55v4.91h-3.95v-11Z' },
];
---
<aside class="siguenos" aria-label="Síguenos en redes sociales">
  {REDES.map((r) => (
    <a href={r.url} target="_blank" rel="noopener noreferrer" aria-label={`GBT Consultoría en ${r.nombre}`}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={r.icono} fill="currentColor" /></svg>
    </a>
  ))}
  <span class="siguenos-linea" aria-hidden="true"></span>
  <span class="siguenos-txt" aria-hidden="true">Síguenos</span>
</aside>

<style is:global>
  .siguenos { position: fixed; right: 14px; top: 50%; transform: translateY(-50%); z-index: 90; display: flex; flex-direction: column; align-items: center; gap: 0.9rem; padding: 0.9rem 0.45rem 1rem; background: var(--white); border: 1px solid rgba(0,0,0,0.1); border-radius: 999px; box-shadow: 0 4px 18px rgba(0,0,0,0.06); }
  body.dark .siguenos { background: #14161b; border-color: rgba(255,255,255,0.12); box-shadow: none; }
  .siguenos a { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; color: #0a0a0a; transition: color var(--transition), background var(--transition); }
  body.dark .siguenos a { color: #e8e8e8; }
  .siguenos a:hover { color: var(--blue); background: rgba(0,74,173,0.08); }
  body.dark .siguenos a:hover { color: var(--blue-light); background: rgba(149,192,250,0.1); }
  .siguenos-linea { width: 1px; height: 36px; background: currentColor; opacity: 0.4; }
  .siguenos-txt { writing-mode: vertical-rl; transform: rotate(180deg); font-size: 0.78rem; font-weight: 500; }
  @media (max-width: 900px) { .siguenos { display: none; } }
  @media print { .siguenos { display: none; } }
</style>
