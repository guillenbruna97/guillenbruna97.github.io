---
// Listado de casos reales (2026-10-24), inspirado en cyberclick.es/casos-de-exito
// (sin su hero): banda oscura con filtro por área y carrusel de tarjetas con
// la del centro destacada, y logos de las marcas. El bloque de testimonios
// aparece solo cuando haya testimonios reales (TESTIMONIOS vacío por ahora).
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import TrustMarquee from '../../components/TrustMarquee.astro';
import FotoPendiente from '../../components/FotoPendiente.astro';
import { Image } from 'astro:assets';
import { casos } from '../../data/casos';
import { getDetalle } from '../../data/casos-detalle';
import { AREAS } from '../../data/areas';
import { SITE_NAME } from '../../consts';
import { casosEn } from '../../data/en/casos';
import { AREAS_EN } from '../../data/en/areas';
import { enlace, type Lang } from '../../i18n';
import FaqList from '../../components/FaqList.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const lista = en ? casosEn : casos;
const areas = en ? AREAS_EN : AREAS;
const logo = (m: string) => (en ? `${m} logo` : `Logo de ${m}`);
const T = en ? {
  seoTitle: `Real marketing case studies | ${SITE_NAME}`,
  seoDescription: 'Real cases of brand strategy, social media, paid media, web and events, with their figures: each company’s challenge, what was done and the result.',
  h1: 'Real cases, real results',
  intro: 'Each company’s challenge, what was done and the result, with the figures. Projects led by Guillén Bruna, who today orchestrates the GBT Consultoría network.',
  banda: 'Cases', filtrar: 'Filter by area', todas: 'All', foto: (c: string) => `Photo of the ${c} case.`,
  anterior: 'Previous', siguiente: 'Next', testimonios: 'Clients and testimonials', testimoniosTexto: 'What the people we have worked with say.', en: 'at',
  contacto: 'Shall we talk<br>about your case?',
} : {
  seoTitle: `Casos reales de marketing | ${SITE_NAME}`,
  seoDescription: 'Casos reales de estrategia de marca, redes sociales, paid media, web y eventos, con sus cifras: el reto de cada empresa, qué se hizo y qué resultado dio.',
  h1: 'Casos reales, resultados reales',
  intro: 'El reto de cada empresa, qué se hizo y qué resultado dio, con sus cifras. Proyectos dirigidos por Guillén Bruna, que hoy orquesta la red de GBT Consultoría.',
  banda: 'Casos', filtrar: 'Filtrar por área', todas: 'Todas', foto: (c: string) => `Foto del caso de ${c}.`,
  anterior: 'Anterior', siguiente: 'Siguiente', testimonios: 'Clientes y testimonios', testimoniosTexto: 'Lo que dicen las personas con las que hemos trabajado.', en: 'en',
  contacto: '¿Hablamos<br>de tu caso?',
};

const trustLogos = [
  { src: '/logos/zebra.png', alt: logo('Zebra AI Transformation Company') },
  { src: '/logos/rey.png', alt: logo('Muebles Rey') },
  { src: '/logos/tuco.png', alt: logo('Muebles Tuco') },
  { src: '/logos/grupo-rey.png', alt: logo('Grupo Rey Corporación') },
  { src: '/logos/slm.png', alt: logo('SLM') },
  { src: '/logos/integra.png', alt: logo('Integra Consultoría Gerencial') },
];

// Página más completa (2026-10-25): cifras destacadas, todos los casos en
// detalle, qué hay detrás de cada caso y preguntas frecuentes. Solo datos que
// ya están en los casos (data/casos.ts y casos-detalle.ts); nada nuevo.
const ir = (ruta: string) => enlace(lang, ruta);
const C = en ? {
  cifras: [
    { valor: '6', texto: 'brands, each with its own voice, managed in parallel', caso: 'muebles-tuco', empresa: 'Grupo Rey Corporación' },
    { valor: '€20,000+', texto: 'a month invested in Meta Ads, segmented by brand and season', caso: 'muebles-rey', empresa: 'Muebles Rey and Muebles Tuco' },
    { valor: '+15,000', texto: 'new followers, from 20,000 to 35,000', caso: 'muebles-tuco', empresa: 'Muebles Tuco' },
    { valor: '400-500', texto: 'orders with no outside investment, up to break-even', caso: 'broco', empresa: 'Broco' },
  ],
  cifrasTitulo: 'Some figures from these cases',
  detalleTitulo: 'All the cases, in detail',
  detalleIntro: 'The challenge, what was done and the result of each project, with the role Guillén Bruna had in it.',
  rol: 'Role', hecho: 'What was done', resultado: 'Result', ver: 'See the full case',
  detrasTitulo: 'What is behind each case',
  detras: [
    { titulo: 'One person accountable', texto: 'Guillén Bruna led every one of these projects, as in-house head of marketing, as a consultant or as a founder. Each case states his role.' },
    { titulo: 'Figures from the period', texto: 'The numbers are from each project, and approximate where indicated. Nothing is rounded up or added after the fact.' },
    { titulo: 'Today, with the network', texto: 'That same way of working is what GBT Consultoría offers: Guillén leads the project and the specialists in the network carry it out.' },
  ],
  faqsTitulo: 'Frequently asked questions',
  faqs: [
    { question: 'Who did the work in these cases?', answer: 'Guillén Bruna led all of them, in different roles: head of brand and marketing in-house, head of social media in a multi-brand group, consultant and founder. Each case page states his role and what was done.' },
    { question: 'Are the figures real?', answer: 'Yes. They come from each project during the period Guillén worked on it, and are marked as approximate where they are. No figures are invented or projected.' },
    { question: 'Can you do something similar for my company?', answer: 'After a 15-minute call we tell you whether we can help, and within 5 working days you get a proposal with the scope, the team, the timeline and a fixed price.' },
  ],
  reco: 'Not sure which service you need?', recoEnlace: 'Answer 6 questions and we will tell you',
} : {
  cifras: [
    { valor: '6', texto: 'marcas con voz propia gestionadas en paralelo', caso: 'muebles-tuco', empresa: 'Grupo Rey Corporación' },
    { valor: '+20.000 €', texto: 'al mes invertidos en Meta Ads, segmentados por marca y temporada', caso: 'muebles-rey', empresa: 'Muebles Rey y Muebles Tuco' },
    { valor: '+15.000', texto: 'seguidores nuevos, de 20.000 a 35.000', caso: 'muebles-tuco', empresa: 'Muebles Tuco' },
    { valor: '400-500', texto: 'pedidos sin inversión externa, hasta el punto de equilibrio', caso: 'broco', empresa: 'Broco' },
  ],
  cifrasTitulo: 'Algunas cifras de estos casos',
  detalleTitulo: 'Todos los casos, en detalle',
  detalleIntro: 'El reto, qué se hizo y qué resultado dio cada proyecto, con el papel que tuvo en él Guillén Bruna.',
  rol: 'Rol', hecho: 'Qué se hizo', resultado: 'Resultado', ver: 'Ver el caso completo',
  detrasTitulo: 'Qué hay detrás de cada caso',
  detras: [
    { titulo: 'Un solo responsable', texto: 'Guillén Bruna dirigió cada uno de estos proyectos, como responsable de marketing dentro de la empresa, como consultor o como fundador. Cada caso indica su rol.' },
    { titulo: 'Cifras del periodo', texto: 'Los números son de cada proyecto, y aproximados cuando así se indica. No se redondean al alza ni se añaden después.' },
    { titulo: 'Hoy, con la red', texto: 'Esa misma forma de trabajar es la que ofrece GBT Consultoría: Guillén dirige el proyecto y lo ejecutan los especialistas de la red.' },
  ],
  faqsTitulo: 'Preguntas frecuentes',
  faqs: [
    { question: '¿Quién hizo el trabajo en estos casos?', answer: 'Guillén Bruna los dirigió todos, con distintos roles: responsable de marca y marketing dentro de la empresa, responsable de redes en un grupo de varias marcas, consultor y fundador. En la página de cada caso se indica su rol y qué se hizo.' },
    { question: '¿Las cifras son reales?', answer: 'Sí. Salen de cada proyecto durante el tiempo en que Guillén trabajó en él, y se marcan como aproximadas cuando lo son. No hay cifras inventadas ni proyectadas.' },
    { question: '¿Podéis hacer algo parecido para mi empresa?', answer: 'Tras una llamada de 15 minutos te decimos si podemos ayudarte, y en 5 días laborables recibes una propuesta con el alcance, el equipo, los plazos y el precio cerrado.' },
  ],
  reco: '¿No sabes qué servicio necesitas?', recoEnlace: 'Responde 6 preguntas y te lo decimos',
};

// Testimonios con nombre y cargo reales. Nunca inventados.
const TESTIMONIOS: { texto: string; nombre: string; cargo: string; empresa: string }[] = [];

const areasConCasos = areas.filter((a) => lista.some((c) => c.areas.includes(a.slug)));
const total = String(lista.length).padStart(2, '0');
const nombreArea = (slug: string) => areas.find((a) => a.slug === slug)?.name ?? '';
---
<BaseLayout
  title={T.seoTitle}
  description={T.seoDescription}
>
  <header class="tc-cabecera">
    <h1>{T.h1}</h1>
    <p>{T.intro}</p>
    <h2 class="tc-cifras-titulo">{C.cifrasTitulo}</h2>
    <ul class="tc-cifras">
      {C.cifras.map((c) => (
        <li>
          <strong>{c.valor}</strong>
          <span>{c.texto}</span>
          <a href={ir(`/trabajo/${c.caso}/`)}>{c.empresa}</a>
        </li>
      ))}
    </ul>
  </header>

  <section class="tc-banda" data-tc aria-label={T.banda}>
    <div class="tc-in">
      <div class="tc-filtro">
        <button type="button" class="tc-filtro-btn" aria-expanded="false" aria-controls="tc-areas">{T.filtrar}</button>
        <div class="tc-areas" id="tc-areas" hidden>
          <button type="button" data-area="" aria-pressed="true">{T.todas}</button>
          {areasConCasos.map((a) => <button type="button" data-area={a.slug} aria-pressed="false">{a.name}</button>)}
        </div>
      </div>
    </div>

    <ul class="tc-pista" data-tc-pista>
      {lista.map((caso) => {
        const d = getDetalle(caso.slug);
        return (
          <li class="tc-card" data-areas={caso.areas.join(' ')}>
            <a href={enlace(lang, `/trabajo/${caso.slug}/`)}>
              <span class="tc-fondo">
                {caso.image ? (
                  <Image src={caso.image} alt="" width={600} format="webp" quality={55} loading="lazy" style={caso.imagePos ? `object-position: ${caso.imagePos};` : undefined} />
                ) : (
                  <FotoPendiente ratio="3 / 4" texto={T.foto(caso.company)} />
                )}
              </span>
              {d?.logo && <span class="tc-logo"><img src={d.logo} alt="" /></span>}
              <span class="tc-info">
                <span class="tc-pill" data-nombre-inicial={nombreArea(caso.areas[0])}>{nombreArea(caso.areas[0])}</span>
                <h2>{caso.company}</h2>
                <span class="tc-reto">{caso.reto}</span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>

    <div class="tc-controles">
      <button type="button" data-dir="-1">{T.anterior}</button>
      <span><span data-tc-actual>01</span> / <span data-tc-total>{total}</span></span>
      <button type="button" data-dir="1">{T.siguiente}</button>
    </div>
  </section>

  <section class="tc-detalle" aria-labelledby="tc-detalle-titulo">
    <h2 id="tc-detalle-titulo">{C.detalleTitulo}</h2>
    <p class="tc-detalle-intro">{C.detalleIntro}</p>
    <ol class="tc-filas">
      {lista.map((caso) => {
        const d = getDetalle(caso.slug);
        return (
          <li class="tc-fila">
            <div class="tc-fila-quien">
              {d?.logo ? <img src={d.logo} alt={logo(caso.company)} loading="lazy" /> : null}
              <p class="tc-fila-empresa">{caso.company}</p>
              <p class="tc-fila-sector">{caso.sector}</p>
            </div>
            <div class="tc-fila-que">
              <h3><a href={ir(`/trabajo/${caso.slug}/`)}>{caso.reto}</a></h3>
              <dl>
                <div><dt>{C.rol}</dt><dd>{caso.role}</dd></div>
                <div><dt>{C.hecho}</dt><dd>{caso.capacidades}</dd></div>
                <div><dt>{C.resultado}</dt><dd>{caso.cardHighlight}</dd></div>
              </dl>
            </div>
            <a href={ir(`/trabajo/${caso.slug}/`)} class="tc-fila-ver">{C.ver}</a>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="tc-detras">
    <h2>{C.detrasTitulo}</h2>
    <div class="tc-detras-cols">
      {C.detras.map((b) => (<div><h3>{b.titulo}</h3><p>{b.texto}</p></div>))}
    </div>
  </section>

  {TESTIMONIOS.length > 0 && (
    <section class="tc-testimonios">
      <div>
        <h2>{T.testimonios}</h2>
        <p>{T.testimoniosTexto}</p>
      </div>
      <ul>
        {TESTIMONIOS.map((t) => (
          <li><blockquote><p>{t.texto}</p><footer><strong>{t.nombre}</strong>, {t.cargo} {T.en} {t.empresa}</footer></blockquote></li>
        ))}
      </ul>
    </section>
  )}

  <section class="tc-faqs">
    <h2>{C.faqsTitulo}</h2>
    <div>
      <FaqList faqs={C.faqs} />
      <p class="tc-reco">{C.reco} <a href={ir('/recomendador/')}>{C.recoEnlace}</a>.</p>
    </div>
  </section>

  <TrustMarquee logos={trustLogos} />

  <ContactBlock title={T.contacto} />
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-tc]');
  if (root) {
    const pista = root.querySelector<HTMLElement>('[data-tc-pista]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('.tc-card')];
    const actual = root.querySelector('[data-tc-actual]')!;
    const totalEl = root.querySelector('[data-tc-total]')!;
    const suave = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    const visibles = () => cards.filter((c) => !c.hidden);
    const pad = (n: number) => String(n).padStart(2, '0');

    // La tarjeta más cercana al centro de la pista queda destacada.
    const marcar = () => {
      const centro = pista.scrollLeft + pista.clientWidth / 2;
      const vs = visibles();
      let mejor = 0, dist = Infinity;
      vs.forEach((c, i) => { const d = Math.abs(c.offsetLeft + c.offsetWidth / 2 - centro); if (d < dist) { dist = d; mejor = i; } });
      cards.forEach((c) => c.classList.remove('activa'));
      vs[mejor]?.classList.add('activa');
      actual.textContent = pad(mejor + 1);
      totalEl.textContent = pad(vs.length);
      return mejor;
    };
    const ir = (i: number) => {
      const vs = visibles();
      const c = vs[Math.max(0, Math.min(vs.length - 1, i))];
      if (c) pista.scrollTo({ left: c.offsetLeft - (pista.clientWidth - c.offsetWidth) / 2, behavior: suave });
    };
    let pendiente = false;
    pista.addEventListener('scroll', () => { if (!pendiente) { pendiente = true; requestAnimationFrame(() => { pendiente = false; marcar(); }); } }, { passive: true });
    root.querySelectorAll<HTMLButtonElement>('.tc-controles button').forEach((b) => b.addEventListener('click', () => ir(marcar() + Number(b.dataset.dir))));

    const btn = root.querySelector<HTMLButtonElement>('.tc-filtro-btn')!;
    const panel = root.querySelector<HTMLElement>('#tc-areas')!;
    btn.addEventListener('click', () => { const abierto = btn.getAttribute('aria-expanded') === 'true'; btn.setAttribute('aria-expanded', String(!abierto)); panel.hidden = abierto; });
    panel.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
      panel.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const area = b.dataset.area;
      cards.forEach((c) => { c.hidden = !!area && !c.dataset.areas!.split(' ').includes(area); });
      // La etiqueta de cada tarjeta enseña el área filtrada (o la principal sin filtro).
      cards.forEach((c) => { const pill = c.querySelector<HTMLElement>('.tc-pill')!; pill.textContent = area ? b.textContent : pill.dataset.nombreInicial!; });
      pista.scrollTo({ left: 0 });
      requestAnimationFrame(() => { ir(0); marcar(); });
    }));
    ir(0);
    marcar();
  }
</script>

<style is:global>
  .tc-cabecera { max-width: 1240px; margin: 0 auto; padding: 4.5rem 4vw 3.5rem; }
  .tc-cifras-titulo { font-size: 0.9rem; font-weight: 500; letter-spacing: 0; color: rgba(0,0,0,0.5); margin: 3.4rem 0 1.2rem; }
  body.dark .tc-cifras-titulo { color: rgba(232,232,232,0.5); }
  .tc-cifras { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; border-top: 1px solid rgba(0,0,0,0.1); padding-top: 1.6rem; }
  body.dark .tc-cifras { border-top-color: rgba(255,255,255,0.1); }
  .tc-cifras li { display: flex; flex-direction: column; gap: 0.4rem; }
  .tc-cifras strong { font-family: 'Poppins', sans-serif; font-weight: 500; font-size: clamp(2rem, 3.6vw, 3rem); letter-spacing: -0.03em; line-height: 1; color: var(--blue); }
  body.dark .tc-cifras strong { color: var(--blue-light); }
  .tc-cifras span { font-size: 0.92rem; font-weight: 300; line-height: 1.5; color: rgba(0,0,0,0.7); }
  body.dark .tc-cifras span { color: rgba(232,232,232,0.7); }
  .tc-cifras a { font-size: 0.82rem; color: rgba(0,0,0,0.5); text-decoration: underline; text-underline-offset: 3px; margin-top: auto; }
  body.dark .tc-cifras a { color: rgba(232,232,232,0.5); }
  .tc-cifras a:hover { color: var(--blue); }
  @media (max-width: 900px) { .tc-cifras { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .tc-detalle, .tc-detras, .tc-faqs { max-width: 1240px; margin: 0 auto; padding: 5.5rem 4vw 0; }
  .tc-detalle h2, .tc-detras h2, .tc-faqs h2 { font-size: clamp(1.8rem, 3.4vw, 2.7rem); margin: 0 0 1rem; }
  .tc-detalle-intro { font-size: 1rem; font-weight: 300; line-height: 1.7; color: rgba(0,0,0,0.65); max-width: 640px; margin: 0 0 2.4rem; }
  body.dark .tc-detalle-intro { color: rgba(232,232,232,0.65); }
  .tc-filas { list-style: none; margin: 0; padding: 0; }
  .tc-fila { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr) auto; gap: 1.5rem 3rem; padding: 2.2rem 0; border-top: 1px solid rgba(0,0,0,0.1); align-items: start; }
  body.dark .tc-fila { border-top-color: rgba(255,255,255,0.1); }
  .tc-fila-quien img { height: 34px; width: auto; max-width: 120px; object-fit: contain; margin-bottom: 0.8rem; display: block; }
  body.dark .tc-fila-quien img { filter: invert(1); opacity: 0.8; }
  .tc-fila-empresa { font-weight: 500; font-size: 0.95rem; margin: 0; }
  .tc-fila-sector { font-size: 0.85rem; font-weight: 300; color: rgba(0,0,0,0.55); margin: 0.2rem 0 0; }
  body.dark .tc-fila-sector { color: rgba(232,232,232,0.55); }
  .tc-fila-que h3 { font-size: clamp(1.2rem, 1.9vw, 1.5rem); line-height: 1.25; margin: 0 0 1.2rem; }
  .tc-fila-que h3 a { color: inherit; text-decoration: none; }
  .tc-fila-que h3 a:hover { color: var(--blue); }
  body.dark .tc-fila-que h3 a:hover { color: var(--blue-light); }
  .tc-fila-que dl { margin: 0; display: grid; gap: 0.5rem; }
  .tc-fila-que dl div { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: 1rem; font-size: 0.92rem; line-height: 1.55; }
  .tc-fila-que dt { color: rgba(0,0,0,0.5); }
  body.dark .tc-fila-que dt { color: rgba(232,232,232,0.5); }
  .tc-fila-que dd { margin: 0; font-weight: 300; }
  .tc-fila-ver { font-size: 0.88rem; font-weight: 500; color: var(--blue); white-space: nowrap; }
  body.dark .tc-fila-ver { color: var(--blue-light); }
  @media (max-width: 900px) {
    .tc-fila { grid-template-columns: 1fr; gap: 1rem; }
    .tc-fila-que dl div { grid-template-columns: 1fr; gap: 0.1rem; }
  }

  .tc-detras-cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem 3rem; margin-top: 2rem; }
  .tc-detras h3 { font-size: 1.05rem; margin: 0 0 0.6rem; }
  .tc-detras p { font-size: 0.95rem; font-weight: 300; line-height: 1.7; color: rgba(0,0,0,0.65); margin: 0; }
  body.dark .tc-detras p { color: rgba(232,232,232,0.65); }
  @media (max-width: 900px) { .tc-detras-cols { grid-template-columns: 1fr; } }

  .tc-faqs { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 2rem 4rem; padding-bottom: 4rem; }
  .tc-reco { font-size: 0.95rem; font-weight: 300; margin: 1.6rem 0 0; }
  .tc-reco a { color: var(--blue); }
  body.dark .tc-reco a { color: var(--blue-light); }
  @media (max-width: 900px) { .tc-faqs { grid-template-columns: 1fr; } }
  .tc-cabecera h1 { font-size: clamp(2.4rem, 5.6vw, 4.8rem); margin: 0 0 1.4rem; max-width: 1000px; }
  .tc-cabecera p { font-size: 1.05rem; font-weight: 300; line-height: 1.75; color: rgba(0,0,0,0.65); max-width: 680px; margin: 0; }
  body.dark .tc-cabecera p { color: rgba(232,232,232,0.68); }

  .tc-banda { background: #1c1c1c; color: #f6f6f6; padding: 3rem 0 3.5rem; }
  body.dark .tc-banda { background: #14161b; }
  .tc-in { max-width: 1240px; margin: 0 auto; padding: 0 4vw; }
  .tc-filtro { margin-bottom: 2rem; }
  .tc-filtro-btn { appearance: none; background: none; border: 0; color: inherit; font: 400 0.92rem 'Poppins', sans-serif; cursor: pointer; padding: 0; display: inline-flex; align-items: center; gap: 0.6rem; }
  .tc-filtro-btn::before { content: ''; width: 16px; height: 10px; border-top: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; }
  .tc-areas { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
  .tc-areas[hidden] { display: none; }
  .tc-areas button { appearance: none; border: 1px solid rgba(246,246,246,0.3); background: none; color: inherit; border-radius: 999px; padding: 0.4rem 0.95rem; font: 400 0.82rem 'Poppins', sans-serif; cursor: pointer; }
