---
// Listado de casos reales (2026-10-24), inspirado en cyberclick.es/casos-de-exito
// (sin su hero): banda oscura con filtro por área y carrusel de tarjetas con
// la del centro destacada, y logos de las marcas. El bloque de testimonios
// aparece solo cuando haya testimonios reales (TESTIMONIOS vacío por ahora).
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import TrustMarquee from '../../components/TrustMarquee.astro';
import FotoPendiente from '../../components/FotoPendiente.astro';
import { Image } from 'astro:assets';
import { casos } from '../../data/casos';
import { getDetalle } from '../../data/casos-detalle';
import { AREAS } from '../../data/areas';
import { SITE_NAME } from '../../consts';
import { casosEn } from '../../data/en/casos';
import { AREAS_EN } from '../../data/en/areas';
import { enlace, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const lista = en ? casosEn : casos;
const areas = en ? AREAS_EN : AREAS;
const logo = (m: string) => (en ? `${m} logo` : `Logo de ${m}`);
const T = en ? {
  seoTitle: `Real marketing case studies | ${SITE_NAME}`,
  seoDescription: 'Real cases of brand strategy, social media, paid media, web and events, with their figures: each company’s challenge, what was done and the result.',
  h1: 'Real cases, real results',
  intro: 'Each company’s challenge, what was done and the result, with the figures. Projects led by Guillén Bruna, who today orchestrates the GBT Consultoría network.',
  banda: 'Cases', filtrar: 'Filter by area', todas: 'All', foto: (c: string) => `Photo of the ${c} case.`,
  anterior: 'Previous', siguiente: 'Next', testimonios: 'Clients and testimonials', testimoniosTexto: 'What the people we have worked with say.', en: 'at',
  contacto: 'Shall we talk<br>about your case?',
} : {
  seoTitle: `Casos reales de marketing | ${SITE_NAME}`,
  seoDescription: 'Casos reales de estrategia de marca, redes sociales, paid media, web y eventos, con sus cifras: el reto de cada empresa, qué se hizo y qué resultado dio.',
  h1: 'Casos reales, resultados reales',
  intro: 'El reto de cada empresa, qué se hizo y qué resultado dio, con sus cifras. Proyectos dirigidos por Guillén Bruna, que hoy orquesta la red de GBT Consultoría.',
  banda: 'Casos', filtrar: 'Filtrar por área', todas: 'Todas', foto: (c: string) => `Foto del caso de ${c}.`,
  anterior: 'Anterior', siguiente: 'Siguiente', testimonios: 'Clientes y testimonios', testimoniosTexto: 'Lo que dicen las personas con las que hemos trabajado.', en: 'en',
  contacto: '¿Hablamos<br>de tu caso?',
};

const trustLogos = [
  { src: '/logos/zebra.png', alt: logo('Zebra AI Transformation Company') },
  { src: '/logos/rey.png', alt: logo('Muebles Rey') },
  { src: '/logos/tuco.png', alt: logo('Muebles Tuco') },
  { src: '/logos/grupo-rey.png', alt: logo('Grupo Rey Corporación') },
  { src: '/logos/slm.png', alt: logo('SLM') },
  { src: '/logos/integra.png', alt: logo('Integra Consultoría Gerencial') },
];

// Testimonios con nombre y cargo reales. Nunca inventados.
const TESTIMONIOS: { texto: string; nombre: string; cargo: string; empresa: string }[] = [];

const areasConCasos = areas.filter((a) => lista.some((c) => c.areas.includes(a.slug)));
const total = String(lista.length).padStart(2, '0');
const nombreArea = (slug: string) => areas.find((a) => a.slug === slug)?.name ?? '';
---
<BaseLayout
  title={T.seoTitle}
  description={T.seoDescription}
>
  <header class="tc-cabecera">
    <h1>{T.h1}</h1>
    <p>{T.intro}</p>
  </header>

  <section class="tc-banda" data-tc aria-label={T.banda}>
    <div class="tc-in">
      <div class="tc-filtro">
        <button type="button" class="tc-filtro-btn" aria-expanded="false" aria-controls="tc-areas">{T.filtrar}</button>
        <div class="tc-areas" id="tc-areas" hidden>
          <button type="button" data-area="" aria-pressed="true">{T.todas}</button>
          {areasConCasos.map((a) => <button type="button" data-area={a.slug} aria-pressed="false">{a.name}</button>)}
        </div>
      </div>
    </div>

    <ul class="tc-pista" data-tc-pista>
      {lista.map((caso) => {
        const d = getDetalle(caso.slug);
        return (
          <li class="tc-card" data-areas={caso.areas.join(' ')}>
            <a href={enlace(lang, `/trabajo/${caso.slug}/`)}>
              <span class="tc-fondo">
                {caso.image ? (
                  <Image src={caso.image} alt="" width={600} format="webp" quality={55} loading="lazy" style={caso.imagePos ? `object-position: ${caso.imagePos};` : undefined} />
                ) : (
                  <FotoPendiente ratio="3 / 4" texto={T.foto(caso.company)} />
                )}
              </span>
              {d?.logo && <span class="tc-logo"><img src={d.logo} alt="" /></span>}
              <span class="tc-info">
                <span class="tc-pill" data-nombre-inicial={nombreArea(caso.areas[0])}>{nombreArea(caso.areas[0])}</span>
                <h2>{caso.company}</h2>
                <span class="tc-reto">{caso.reto}</span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>

    <div class="tc-controles">
      <button type="button" data-dir="-1">{T.anterior}</button>
      <span><span data-tc-actual>01</span> / <span data-tc-total>{total}</span></span>
      <button type="button" data-dir="1">{T.siguiente}</button>
    </div>
  </section>

  {TESTIMONIOS.length > 0 && (
    <section class="tc-testimonios">
      <div>
        <h2>{T.testimonios}</h2>
        <p>{T.testimoniosTexto}</p>
      </div>
      <ul>
        {TESTIMONIOS.map((t) => (
          <li><blockquote><p>{t.texto}</p><footer><strong>{t.nombre}</strong>, {t.cargo} {T.en} {t.empresa}</footer></blockquote></li>
        ))}
      </ul>
    </section>
  )}

  <TrustMarquee logos={trustLogos} />

  <ContactBlock title={T.contacto} />
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-tc]');
  if (root) {
    const pista = root.querySelector<HTMLElement>('[data-tc-pista]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('.tc-card')];
    const actual = root.querySelector('[data-tc-actual]')!;
    const totalEl = root.querySelector('[data-tc-total]')!;
    const suave = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    const visibles = () => cards.filter((c) => !c.hidden);
    const pad = (n: number) => String(n).padStart(2, '0');

    // La tarjeta más cercana al centro de la pista queda destacada.
    const marcar = () => {
      const centro = pista.scrollLeft + pista.clientWidth / 2;
      const vs = visibles();
      let mejor = 0, dist = Infinity;
      vs.forEach((c, i) => { const d = Math.abs(c.offsetLeft + c.offsetWidth / 2 - centro); if (d < dist) { dist = d; mejor = i; } });
      cards.forEach((c) => c.classList.remove('activa'));
      vs[mejor]?.classList.add('activa');
      actual.textContent = pad(mejor + 1);
      totalEl.textContent = pad(vs.length);
      return mejor;
    };
    const ir = (i: number) => {
      const vs = visibles();
      const c = vs[Math.max(0, Math.min(vs.length - 1, i))];
      if (c) pista.scrollTo({ left: c.offsetLeft - (pista.clientWidth - c.offsetWidth) / 2, behavior: suave });
    };
    let pendiente = false;
    pista.addEventListener('scroll', () => { if (!pendiente) { pendiente = true; requestAnimationFrame(() => { pendiente = false; marcar(); }); } }, { passive: true });
    root.querySelectorAll<HTMLButtonElement>('.tc-controles button').forEach((b) => b.addEventListener('click', () => ir(marcar() + Number(b.dataset.dir))));

    const btn = root.querySelector<HTMLButtonElement>('.tc-filtro-btn')!;
    const panel = root.querySelector<HTMLElement>('#tc-areas')!;
    btn.addEventListener('click', () => { const abierto = btn.getAttribute('aria-expanded') === 'true'; btn.setAttribute('aria-expanded', String(!abierto)); panel.hidden = abierto; });
    panel.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
      panel.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const area = b.dataset.area;
      cards.forEach((c) => { c.hidden = !!area && !c.dataset.areas!.split(' ').includes(area); });
      // La etiqueta de cada tarjeta enseña el área filtrada (o la principal sin filtro).
      cards.forEach((c) => { const pill = c.querySelector<HTMLElement>('.tc-pill')!; pill.textContent = area ? b.textContent : pill.dataset.nombreInicial!; });
      pista.scrollTo({ left: 0 });
      requestAnimationFrame(() => { ir(0); marcar(); });
    }));
    ir(0);
    marcar();
  }
</script>

<style is:global>
  .tc-cabecera { max-width: 1240px; margin: 0 auto; padding: 4.5rem 4vw 3.5rem; }
  .tc-cabecera h1 { font-size: clamp(2.4rem, 5.6vw, 4.8rem); margin: 0 0 1.4rem; max-width: 1000px; }
  .tc-cabecera p { font-size: 1.05rem; font-weight: 300; line-height: 1.75; color: rgba(0,0,0,0.65); max-width: 680px; margin: 0; }
  body.dark .tc-cabecera p { color: rgba(232,232,232,0.68); }

  .tc-banda { background: #1c1c1c; color: #f6f6f6; padding: 3rem 0 3.5rem; }
  body.dark .tc-banda { background: #14161b; }
  .tc-in { max-width: 1240px; margin: 0 auto; padding: 0 4vw; }
  .tc-filtro { margin-bottom: 2rem; }
  .tc-filtro-btn { appearance: none; background: none; border: 0; color: inherit; font: 400 0.92rem 'Poppins', sans-serif; cursor: pointer; padding: 0; display: inline-flex; align-items: center; gap: 0.6rem; }
  .tc-filtro-btn::before { content: ''; width: 16px; height: 10px; border-top: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; }
  .tc-areas { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
  .tc-areas[hidden] { display: none; }
  .tc-areas button { appearance: none; border: 1px solid rgba(246,246,246,0.3); background: none; color: inherit; border-radius: 999px; padding: 0.4rem 0.95rem; font: 400 0.82rem 'Poppins', sans-serif; cursor: pointer; }
  .tc-areas button[aria-pressed="true"] { background: #f6f6f6; color: #0a0a0a; border-color: #f6f6f6; }

  .tc-pista { list-style: none; margin: 0; padding: 1rem calc(50vw - 160px); display: flex; gap: 1.2rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .tc-pista::-webkit-scrollbar { display: none; }
  .tc-card { flex: 0 0 320px; scroll-snap-align: center; transition: transform 0.3s ease, opacity 0.3s ease; opacity: 0.6; transform: scale(0.94); }
  .tc-card[hidden] { display: none; }
  .tc-card.activa { opacity: 1; transform: none; }
  .tc-card a { position: relative; display: block; height: 440px; border-radius: 16px; overflow: hidden; color: #f6f6f6; text-decoration: none; border: 2px solid transparent; }
  .tc-card.activa a { border-color: var(--blue-light); }
  .tc-fondo, .tc-fondo picture, .tc-fondo img, .tc-fondo .foto-pendiente { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 0; }
  .tc-fondo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.35) 55%, rgba(0,0,0,0.1) 100%); }
  .tc-logo { position: absolute; top: 1.2rem; left: 1.2rem; width: 64px; height: 64px; border-radius: 50%; background: #fff; display: grid; place-items: center; z-index: 1; }
  .tc-logo img { max-width: 44px; max-height: 30px; width: auto; }
  .tc-info { position: absolute; left: 1.4rem; right: 1.4rem; bottom: 1.4rem; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem; }
  .tc-pill { font-size: 0.75rem; border: 1px solid rgba(246,246,246,0.6); border-radius: 999px; padding: 0.25rem 0.75rem; }
  .tc-info h2 { font-size: 1.35rem; margin: 0; color: #f6f6f6; }
  .tc-reto { font-size: 0.86rem; font-weight: 300; line-height: 1.5; color: rgba(246,246,246,0.85); }
  .tc-controles { display: flex; justify-content: center; align-items: center; gap: 1.4rem; margin-top: 1.8rem; font-size: 0.88rem; font-variant-numeric: tabular-nums; }
  .tc-controles button { appearance: none; background: none; color: inherit; border: 1px solid rgba(246,246,246,0.4); border-radius: 999px; padding: 0.65rem 1.5rem; font: 500 0.82rem 'Poppins', sans-serif; cursor: pointer; }
  .tc-controles button:hover { border-color: #f6f6f6; }

  .tc-testimonios { max-width: 1240px; margin: 0 auto; padding: 5rem 4vw; display: grid; grid-template-columns: 1fr 1.3fr; gap: 3rem; }
  .tc-testimonios ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.2rem; }
  .tc-testimonios blockquote { margin: 0; padding: 1.8rem; border: 1px solid rgba(0,0,0,0.1); }
  .tc-testimonios blockquote p { font-style: italic; font-weight: 300; line-height: 1.7; margin: 0 0 1rem; }

  @media (max-width: 640px) {
    .tc-pista { padding: 1rem calc(50vw - 135px); }
    .tc-card { flex-basis: 270px; }
    .tc-card a { height: 400px; }
    .tc-testimonios { grid-template-columns: 1fr; }
  }
</style>
