---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import ArticuloCard from './ArticuloCard.astro';

interface Props {
  page: Page<CollectionEntry<'articulos'>>;
  categorias: { nombre: string; slug: string }[];
  activeSlug: string; // 'all' o el slug de la categoria activa
  basePath: string; // sin barra final, ej. '/articulos' o '/articulos/categoria/marca'
}

const { page, categorias, activeSlug, basePath } = Astro.props;

// El primer artículo de cada página va destacado arriba y el resto en filas de 3.
const [primero, ...resto] = page.data;
const dos = (n: number) => String(n).padStart(2, '0');
const pageHref = (num: number) => (num === 1 ? `${basePath}/` : `${basePath}/${num}/`);
---

<div class="filters" id="filters">
  <a href="/articulos/" class:list={['filter-btn', { active: activeSlug === 'all' }]}>Todos</a>
  {categorias.map(({ nombre, slug }) => (
    <a href={`/articulos/categoria/${slug}/`} class:list={['filter-btn', { active: activeSlug === slug }]}>{nombre}</a>
  ))}
</div>

{primero && (
  <div class="al-destacado"><ArticuloCard entry={primero} destacado /></div>
)}

<div class="al-grid">
  {resto.map((entry) => <ArticuloCard entry={entry} />)}
</div>

{page.lastPage > 1 && (
  <nav class="pagination" aria-label="Paginación de artículos">
    {page.url.prev ? (
      <a href={`${page.url.prev}/`} class="pagination-link pagination-prev" rel="prev" aria-label="Artículos más recientes"><svg class="pagination-icon" viewBox="0 0 40 16" width="40" height="16" aria-hidden="true" focusable="false"><path class="pi-linea" d="M2.5 9.2C8 7.6 13.5 9.9 19.5 8.6S30.5 7.4 35.6 8.3"/><path class="pi-punta" d="M29.4 2.9C31.6 4.6 33.9 6.6 36.4 8.4C33.7 9.8 31.4 11.6 29.8 13.6"/></svg></a>
    ) : (
      <span class="pagination-link pagination-prev pagination-disabled" aria-hidden="true"><svg class="pagination-icon" viewBox="0 0 40 16" width="40" height="16" aria-hidden="true" focusable="false"><path class="pi-linea" d="M2.5 9.2C8 7.6 13.5 9.9 19.5 8.6S30.5 7.4 35.6 8.3"/><path class="pi-punta" d="M29.4 2.9C31.6 4.6 33.9 6.6 36.4 8.4C33.7 9.8 31.4 11.6 29.8 13.6"/></svg></span>
    )}

    <div class="pagination-pages">
      {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => (
        num === page.currentPage ? (
          <span class="pagination-page pagination-page-current" aria-current="page">{dos(num)}</span>
        ) : (
          <a href={pageHref(num)} class="pagination-page" aria-label={`Página ${dos(num)}`}>{dos(num)}</a>
        )
      ))}
    </div>

    {page.url.next ? (
      <a href={`${page.url.next}/`} class="pagination-link pagination-next" rel="next" aria-label="Artículos más antiguos"><svg class="pagination-icon" viewBox="0 0 40 16" width="40" height="16" aria-hidden="true" focusable="false"><path class="pi-linea" d="M2.5 9.2C8 7.6 13.5 9.9 19.5 8.6S30.5 7.4 35.6 8.3"/><path class="pi-punta" d="M29.4 2.9C31.6 4.6 33.9 6.6 36.4 8.4C33.7 9.8 31.4 11.6 29.8 13.6"/></svg></a>
    ) : (
      <span class="pagination-link pagination-next pagination-disabled" aria-hidden="true"><svg class="pagination-icon" viewBox="0 0 40 16" width="40" height="16" aria-hidden="true" focusable="false"><path class="pi-linea" d="M2.5 9.2C8 7.6 13.5 9.9 19.5 8.6S30.5 7.4 35.6 8.3"/><path class="pi-punta" d="M29.4 2.9C31.6 4.6 33.9 6.6 36.4 8.4C33.7 9.8 31.4 11.6 29.8 13.6"/></svg></span>
    )}
  </nav>
)}

<style is:global>
  .filters { max-width: 1240px; margin: 0 auto; padding: 0 4vw 2.6rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .filter-btn { display: inline-block; border: 1px solid rgba(0,0,0,0.18); border-radius: 999px; padding: 0.45rem 1rem; font-size: 0.85rem; color: var(--black); text-decoration: none; transition: border-color var(--transition), background var(--transition), color var(--transition); }
  .filter-btn:hover { border-color: var(--blue); color: var(--blue); }
  .filter-btn.active { background: var(--black); border-color: var(--black); color: var(--white); }
  body.dark .filter-btn { color: #e8e8e8; border-color: rgba(232,232,232,0.22); }
  body.dark .filter-btn:hover { border-color: var(--blue-light); color: var(--blue-light); }
  body.dark .filter-btn.active { background: #e8e8e8; border-color: #e8e8e8; color: #0a0a0a; }
  .al-destacado { max-width: 1240px; margin: 0 auto; padding: 0 4vw 4rem; }
  .al-grid { max-width: 1240px; margin: 0 auto; padding: 0 4vw 3rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem 2rem; }
  @media (max-width: 980px) { .al-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .al-grid { grid-template-columns: 1fr; } }

  /* PAGINACIÓN (2026-10-25): flecha dibujada como un trazo de rotulador, en la
     línea de las ilustraciones de los artículos; números de dos cifras con la
     página actual subrayada en azul. Todo junto y centrado. */
  .pagination { display: flex; align-items: center; justify-content: center; gap: 1.6rem; padding: 0 4vw 4rem; max-width: 1240px; margin: 0 auto; }
  .pagination-link { display: inline-flex; align-items: center; justify-content: center; width: 3.2rem; height: 2.75rem; color: var(--blue); border-radius: 8px; }
  body.dark .pagination-link { color: var(--blue-light); }
  .pagination-icon { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; overflow: visible; transition: transform 0.25s ease; }
  .pagination-prev .pagination-icon { transform: scaleX(-1); }
  .pagination-icon path { stroke-dasharray: 40; stroke-dashoffset: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .pagination-link:hover .pi-linea { animation: pi-trazo 0.45s ease-out; }
    .pagination-link:hover .pi-punta { animation: pi-trazo 0.3s ease-out 0.3s backwards; }
    .pagination-next:hover .pagination-icon { transform: translateX(4px); }
    .pagination-prev:hover .pagination-icon { transform: scaleX(-1) translateX(4px); }
  }
  @keyframes pi-trazo { from { stroke-dashoffset: 40; } to { stroke-dashoffset: 0; } }
  .pagination-link:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .pagination-disabled { visibility: hidden; }

  .pagination-pages { display: flex; gap: 0.3rem; }
  .pagination-page { position: relative; display: inline-flex; align-items: center; justify-content: center; min-width: 2.6rem; height: 2.75rem; font-size: 0.95rem; font-weight: 400; font-variant-numeric: tabular-nums; letter-spacing: 0.02em; color: rgba(0,0,0,0.58); text-decoration: none; transition: color var(--transition); }
  body.dark .pagination-page { color: rgba(232,232,232,0.62); }
  .pagination-page:hover { color: var(--black); }
  body.dark .pagination-page:hover { color: #e8e8e8; }
  .pagination-page-current { color: var(--black); font-weight: 500; }
  body.dark .pagination-page-current { color: #e8e8e8; }
  .pagination-page-current::after { content: ''; position: absolute; left: 22%; right: 22%; bottom: 0.45rem; height: 2px; border-radius: 2px; background: var(--blue); }
  body.dark .pagination-page-current::after { background: var(--blue-light); }

  @media (max-width: 640px) { .pagination { gap: 0.4rem; } .pagination-page { min-width: 2.2rem; } }
</style>
