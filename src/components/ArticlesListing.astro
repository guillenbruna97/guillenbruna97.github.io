---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  page: Page<CollectionEntry<'articulos'>>;
  categorias: { nombre: string; slug: string }[];
  activeSlug: string; // 'all' o el slug de la categoria activa
  basePath: string; // sin barra final, ej. '/articulos' o '/articulos/categoria/marca'
}

const { page, categorias, activeSlug, basePath } = Astro.props;

const pageHref = (num: number) => (num === 1 ? `${basePath}/` : `${basePath}/${num}/`);
---

<div class="filters" id="filters">
  <a href="/articulos/" class:list={['filter-btn', { active: activeSlug === 'all' }]}>Todos</a>
  {categorias.map(({ nombre, slug }) => (
    <a href={`/articulos/categoria/${slug}/`} class:list={['filter-btn', { active: activeSlug === slug }]}>{nombre}</a>
  ))}
</div>

<div class="articles">
  {page.data.map((entry) => (
    <a href={`/articulos/${entry.id}/`} class="article-item">
      {entry.data.image && (
        <div class="article-thumb">
          <img src={entry.data.image} alt="" loading="lazy" />
        </div>
      )}
      <div class="article-content">
        <p class="article-tag">{entry.data.tag}</p>
        <p class="article-title">{entry.data.title}</p>
        <p class="article-excerpt">{entry.data.excerpt}</p>
      </div>
      <div class="article-right">
        <span class="article-arrow">→</span>
      </div>
    </a>
  ))}
</div>

{page.lastPage > 1 && (
  <nav class="pagination" aria-label="Paginación de artículos">
    {page.url.prev ? (
      <a href={`${page.url.prev}/`} class="pagination-link pagination-prev" rel="prev">← Más recientes</a>
    ) : (
      <span class="pagination-link pagination-disabled">← Más recientes</span>
    )}

    <div class="pagination-pages">
      {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => (
        num === page.currentPage ? (
          <span class="pagination-page pagination-page-current" aria-current="page">{num}</span>
        ) : (
          <a href={pageHref(num)} class="pagination-page">{num}</a>
        )
      ))}
    </div>

    {page.url.next ? (
      <a href={`${page.url.next}/`} class="pagination-link pagination-next" rel="next">Más antiguos →</a>
    ) : (
      <span class="pagination-link pagination-disabled">Más antiguos →</span>
    )}
  </nav>
)}

<style is:global>
  /* FILTERS */
  .filters {
    padding: 0.5rem 2rem 0;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .filter-btn {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.45rem 1rem;
    border-radius: 8px;
    background: transparent;
    color: rgba(0,0,0,0.45);
    border: 1px solid rgba(0,0,0,0.12);
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    font-family: 'Poppins', sans-serif;
    transition: all var(--transition);
  }
  body.dark .filter-btn { color: rgba(232,232,232,0.4); border-color: rgba(255,255,255,0.12); }
  .filter-btn.active { background: var(--black); color: var(--white); border-color: var(--black); }
  body.dark .filter-btn.active { background: var(--blue-light); color: var(--dark-bg); border-color: var(--blue-light); }
  .filter-btn:hover:not(.active) { border-color: var(--blue); color: var(--blue); }
  body.dark .filter-btn:hover:not(.active) { border-color: var(--blue-light); color: var(--blue-light); }
  .filter-btn:active { transform: scale(0.97); }

  /* ARTICLES */
  .articles { padding: 3rem 2rem; max-width: 900px; margin: 0 auto; }

  .article-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 2rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    gap: 2rem;
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition);
  }
  body.dark .article-item { border-bottom-color: rgba(255,255,255,0.08); }
  .article-item:first-child { border-top: 1px solid rgba(0,0,0,0.06); }
  body.dark .article-item:first-child { border-top-color: rgba(255,255,255,0.08); }

  .article-thumb {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    border-radius: 10px;
    overflow: hidden;
    background: rgba(0,0,0,0.03);
  }
  body.dark .article-thumb { background: rgba(255,255,255,0.05); }
  .article-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .article-content { flex: 1; }
  .article-tag {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 0.6rem;
    transition: color var(--transition);
  }
  body.dark .article-tag { color: var(--blue-light); }

  .article-title {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
    transition: color var(--transition);
  }
  body.dark .article-title { color: #e8e8e8; }
  .article-item:hover .article-title { color: var(--blue); }
  body.dark .article-item:hover .article-title { color: var(--blue-light); }

  .article-excerpt {
    font-size: 0.82rem;
    font-weight: 300;
    color: rgba(0,0,0,0.5);
    line-height: 1.7;
    transition: color var(--transition);
  }
  body.dark .article-excerpt { color: rgba(232,232,232,0.45); }

  .article-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.8rem; flex-shrink: 0; }
  .article-meta {
    font-size: 0.72rem;
    font-weight: 300;
    color: rgba(0,0,0,0.35);
    white-space: nowrap;
    transition: color var(--transition);
  }
  body.dark .article-meta { color: rgba(232,232,232,0.38); }

  .article-arrow { font-size: 1rem; color: var(--blue); opacity: 0; transition: opacity 0.2s, color var(--transition); }
  body.dark .article-arrow { color: var(--blue-light); }
  .article-item:hover .article-arrow { opacity: 1; }

  @media (max-width: 640px) {
    .article-item { flex-direction: column; gap: 1rem; }
    .article-right { align-items: flex-start; }
    .article-thumb { width: 100%; height: 160px; order: -1; }
  }

  /* PAGINATION */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 2rem 3rem;
    max-width: 900px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .pagination-link {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--blue);
    text-decoration: none;
    transition: color var(--transition), opacity var(--transition);
  }
  body.dark .pagination-link { color: var(--blue-light); }
  .pagination-link:hover { opacity: 0.7; }
  .pagination-disabled { color: rgba(0,0,0,0.25); pointer-events: none; }
  body.dark .pagination-disabled { color: rgba(232,232,232,0.2); }

  .pagination-pages { display: flex; gap: 0.4rem; }
  .pagination-page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.9rem;
    height: 1.9rem;
    font-size: 0.78rem;
    font-weight: 500;
    border-radius: 6px;
    color: rgba(0,0,0,0.5);
    text-decoration: none;
    transition: all var(--transition);
  }
  body.dark .pagination-page { color: rgba(232,232,232,0.5); }
  .pagination-page:hover:not(.pagination-page-current) { background: rgba(0,0,0,0.06); }
  body.dark .pagination-page:hover:not(.pagination-page-current) { background: rgba(255,255,255,0.08); }
  .pagination-page-current { background: var(--black); color: var(--white); }
  body.dark .pagination-page-current { background: var(--blue-light); color: var(--dark-bg); }

  @media (max-width: 640px) {
    .pagination { justify-content: center; }
  }
</style>
