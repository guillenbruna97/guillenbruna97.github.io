---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';

interface Props {
  page: Page<CollectionEntry<'articulos'>>;
  categorias: { nombre: string; slug: string }[];
  activeSlug: string; // 'all' o el slug de la categoria activa
  basePath: string; // sin barra final, ej. '/articulos' o '/articulos/categoria/marca'
}

const { page, categorias, activeSlug, basePath } = Astro.props;

const pageHref = (num: number) => (num === 1 ? `${basePath}/` : `${basePath}/${num}/`);
---

<div class="filters" id="filters">
  <a href="/articulos/" class:list={['filter-btn', { active: activeSlug === 'all' }]}>Todos</a>
  {categorias.map(({ nombre, slug }) => (
    <a href={`/articulos/categoria/${slug}/`} class:list={['filter-btn', { active: activeSlug === slug }]}>{nombre}</a>
  ))}
</div>

<div class="cases articles-cases">
  {page.data.map((entry) => (
    <div class="case-item" data-reveal>
      {entry.data.image && (
        <div class="case-media">
          <a href={`/articulos/${entry.id}/`} aria-label={`Leer artículo: ${entry.data.title}`}>
            <img src={entry.data.image} alt="" loading="lazy" />
          </a>
        </div>
      )}
      <div class="case-content">
        <div class="case-tags">
          <Tag label={entry.data.tag} />
        </div>
        <h2><a href={`/articulos/${entry.id}/`}>{entry.data.title}</a></h2>
        <p class="case-desc">{entry.data.excerpt}</p>
        <a href={`/articulos/${entry.id}/`} class="case-link">Leer artículo →</a>
      </div>
    </div>
  ))}
</div>

{page.lastPage > 1 && (
  <nav class="pagination" aria-label="Paginación de artículos">
    {page.url.prev ? (
      <a href={`${page.url.prev}/`} class="pagination-link pagination-prev" rel="prev">← Más recientes</a>
    ) : (
      <span class="pagination-link pagination-disabled">← Más recientes</span>
    )}

    <div class="pagination-pages">
      {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => (
        num === page.currentPage ? (
          <span class="pagination-page pagination-page-current" aria-current="page">{num}</span>
        ) : (
          <a href={pageHref(num)} class="pagination-page">{num}</a>
        )
      ))}
    </div>

    {page.url.next ? (
      <a href={`${page.url.next}/`} class="pagination-link pagination-next" rel="next">Más antiguos →</a>
    ) : (
      <span class="pagination-link pagination-disabled">Más antiguos →</span>
    )}
  </nav>
)}

<style is:global>
  /* FILTERS */
  .filters {
    padding: 0.5rem 2rem 0;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .filter-btn {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.45rem 1rem;
    border-radius: 8px;
    background: transparent;
    color: rgba(0,0,0,0.45);
    border: 1px solid rgba(0,0,0,0.12);
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    font-family: 'Poppins', sans-serif;
    transition: all var(--transition);
  }
  body.dark .filter-btn { color: rgba(232,232,232,0.4); border-color: rgba(255,255,255,0.12); }
  .filter-btn.active { background: var(--black); color: var(--white); border-color: var(--black); }
  body.dark .filter-btn.active { background: var(--blue-light); color: var(--dark-bg); border-color: var(--blue-light); }
  .filter-btn:hover:not(.active) { border-color: var(--blue); color: var(--blue); }
  body.dark .filter-btn:hover:not(.active) { border-color: var(--blue-light); color: var(--blue-light); }
  .filter-btn:active { transform: scale(0.97); }

  /* ARTICLES — mismas cards que "Casos reales" (.case-item), grid 2 columnas */
  .cases.articles-cases { padding: 3rem 2rem; max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .articles-cases .case-item {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0 0 2rem;
    border: 1px solid rgba(0,0,0,0.1);
    background: var(--white);
    transition: border-color var(--transition), opacity 0.6s ease, transform 0.6s ease;
  }
  body.dark .articles-cases .case-item { border-color: rgba(255,255,255,0.12); background: var(--dark-bg); }
  .articles-cases .case-media { aspect-ratio: 16 / 10; overflow: hidden; background: var(--blue); }
  .articles-cases .case-media a { display: block; height: 100%; }
  .articles-cases .case-media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .articles-cases .case-item:hover .case-media img { transform: scale(1.03); }
  .articles-cases .case-content { padding: 1.5rem 1.5rem 0; }

  .articles-cases .case-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.7rem; }

  .articles-cases .case-content h2 {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.6rem;
    transition: color var(--transition);
  }
  .articles-cases .case-content h2 a { color: inherit; text-decoration: none; }
  body.dark .articles-cases .case-content h2 { color: #e8e8e8; }
  .articles-cases .case-item:hover .case-content h2 { color: var(--blue); }
  body.dark .articles-cases .case-item:hover .case-content h2 { color: var(--blue-light); }

  .articles-cases .case-desc {
    font-size: 0.9rem;
    font-weight: 300;
    color: rgba(0,0,0,0.6);
    line-height: 1.8;
    margin-bottom: 1rem;
    transition: color var(--transition);
  }
  body.dark .articles-cases .case-desc { color: rgba(232,232,232,0.6); }

  .articles-cases .case-link {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--blue);
    text-decoration: none;
    transition: color var(--transition);
  }
  body.dark .articles-cases .case-link { color: var(--blue-light); }
  .articles-cases .case-link:hover { text-decoration: underline; }

  @media (max-width: 640px) {
    .cases.articles-cases { grid-template-columns: 1fr; padding-left: 1.25rem; padding-right: 1.25rem; }
  }

  /* PAGINATION */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 2rem 3rem;
    max-width: 900px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .pagination-link {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--blue);
    text-decoration: none;
    transition: color var(--transition), opacity var(--transition);
  }
  body.dark .pagination-link { color: var(--blue-light); }
  .pagination-link:hover { opacity: 0.7; }
  .pagination-disabled { color: rgba(0,0,0,0.25); pointer-events: none; }
  body.dark .pagination-disabled { color: rgba(232,232,232,0.2); }

  .pagination-pages { display: flex; gap: 0.4rem; }
  .pagination-page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.9rem;
    height: 1.9rem;
    font-size: 0.78rem;
    font-weight: 500;
    border-radius: 6px;
    color: rgba(0,0,0,0.5);
    text-decoration: none;
    transition: all var(--transition);
  }
  body.dark .pagination-page { color: rgba(232,232,232,0.5); }
  .pagination-page:hover:not(.pagination-page-current) { background: rgba(0,0,0,0.06); }
  body.dark .pagination-page:hover:not(.pagination-page-current) { background: rgba(255,255,255,0.08); }
  .pagination-page-current { background: var(--black); color: var(--white); }
  body.dark .pagination-page-current { background: var(--blue-light); color: var(--dark-bg); }

  @media (max-width: 640px) {
    .pagination { justify-content: center; }
  }
</style>
